@inject OnlineSession Session

<div class="login-view online-status">
    <div class="login-logo">
        <img class="login-logo-img" src="@Root.LogoOuDefaut(Root.LogoGarde)" alt="" />
        <h1>@Title</h1>
    </div>
    <div class="login-card">
        <p class="online-status-text">@Message</p>
        @if (Session.Profile != null)
        {
            <p class="text-muted online-status-account">@L.F("Compte : {0}", Session.Profile.EstSansEmail ? Session.Profile.NomComplet : Session.Profile.Email)</p>
        }
        @if (Session.State == OnlineSessionState.Pending && Session.Profile != null)
        {
            @if (_edition)
            {
                <div class="online-status-infos">
                    @if (Incomplet)
                    {
                        <p class="text-muted">@L.T("Complétez vos informations : elles aident l'administrateur à vous reconnaître.")</p>
                    }
                    <div class="online-auth-row">
                        <div class="form-group">
                            <label for="st-prenom">@L.T("Prénom")</label>
                            <input id="st-prenom" type="text" autocomplete="given-name" @bind="_prenom" />
                        </div>
                        <div class="form-group">
                            <label for="st-nom">@L.T("Nom")</label>
                            <input id="st-nom" type="text" autocomplete="family-name" @bind="_nom" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="st-tel">@L.T("Téléphone")</label>
                        <TelephoneInput Id="st-tel" @bind-Value="_telephone" />
                    </div>
                    @if (_erreur != null)
                    {
                        <div class="login-global-error" role="alert">@_erreur</div>
                    }
                    <button type="button" class="btn btn-primary btn-block" disabled="@_busy" @onclick="EnregistrerAsync">@L.T("Enregistrer mes informations")</button>
                </div>
            }
            else
            {
                <button type="button" class="login-forgot" @onclick="Editer">@L.T("Corriger mes informations")</button>
            }
        }
        @if (Session.State is OnlineSessionState.Pending or OnlineSessionState.NoMemberRecord or OnlineSessionState.Error)
        {
            <button type="button" class="btn btn-primary btn-block" disabled="@_busy" @onclick="RecheckAsync">
                @(_busy ? L.T("Vérification…") : L.T("Vérifier à nouveau"))
            </button>
        }
        @if (Session.State != OnlineSessionState.NotConfigured)
        {
            <button type="button" class="btn btn-secondary btn-block online-status-logout" @onclick="Session.SignOutAsync">@L.T("Se déconnecter")</button>
        }
    </div>
</div>

@code {
    private bool _busy;
    private bool _edition;
    private bool _ouvertAuto;
    private string _prenom = "";
    private string _nom = "";
    private string _telephone = "";
    private string? _erreur;

    /// <summary>Inscription avec Google : le téléphone manque, le nom peut être mal découpé.</summary>
    private bool Incomplet => Session.Profile is { } p
        && (string.IsNullOrWhiteSpace(p.Prenom) || string.IsNullOrWhiteSpace(p.Nom) || string.IsNullOrWhiteSpace(p.Telephone));

    protected override void OnParametersSet()
    {
        if (!_ouvertAuto && Session.State == OnlineSessionState.Pending && Incomplet)
        {
            _ouvertAuto = true;
            Editer();
        }
    }

    private void Editer()
    {
        var p = Session.Profile;
        if (p == null) return;
        _prenom = p.Prenom;
        _nom = p.Nom;
        _telephone = p.Telephone;
        _erreur = null;
        _edition = true;
    }

    private async Task EnregistrerAsync()
    {
        if (string.IsNullOrWhiteSpace(_prenom) || string.IsNullOrWhiteSpace(_nom))
        {
            _erreur = L.T("Le prénom et le nom sont obligatoires.");
            return;
        }
        if (_telephone.Length > 0 && !DataStore.IsPhoneValid(_telephone))
        {
            _erreur = L.T("Le numéro doit avoir 9 chiffres après +261 (ex. 341234567).");
            return;
        }
        _busy = true;
        try
        {
            _erreur = await Session.CompleteProfileAsync(_prenom, _nom, _telephone);
            if (_erreur == null) _edition = false;
        }
        finally { _busy = false; }
    }

    private string Title => Session.State switch
    {
        OnlineSessionState.Pending => L.T("Compte en attente de validation"),
        OnlineSessionState.Refused => L.T("Inscription refusée"),
        OnlineSessionState.Disabled => L.T("Compte désactivé"),
        OnlineSessionState.NoMemberRecord => L.T("Fiche membre manquante"),
        OnlineSessionState.NotConfigured => L.T("Configuration requise"),
        _ => L.T("Connexion impossible")
    };

    private string Message => Session.State switch
    {
        OnlineSessionState.Pending => L.T("Merci pour votre inscription. Un administrateur doit valider votre compte et vous attribuer un rôle. Revenez un peu plus tard ou cliquez sur « Vérifier à nouveau »."),
        OnlineSessionState.Refused => L.T("Un administrateur a refusé cette inscription. Contactez la communauté si vous pensez qu'il s'agit d'une erreur."),
        OnlineSessionState.Disabled => L.T("Ce compte a été désactivé par un administrateur. Contactez la communauté pour le réactiver."),
        OnlineSessionState.NoMemberRecord => L.T("Votre compte est validé, mais votre fiche membre n'a pas encore été créée. Demandez à un administrateur de valider à nouveau votre compte depuis « Comptes en ligne »."),
        OnlineSessionState.NotConfigured => L.T("L'adresse du projet Supabase n'est pas configurée (fichier appsettings.json). Suivez le guide de mise en ligne du dépôt."),
        _ => Session.Error ?? L.T("Une erreur est survenue.")
    };

    private async Task RecheckAsync()
    {
        _busy = true;
        try { await Session.RecheckAsync(); }
        finally { _busy = false; }
    }
}
