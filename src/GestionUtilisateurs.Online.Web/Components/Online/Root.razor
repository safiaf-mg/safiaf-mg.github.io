@implements IDisposable
@inject OnlineSession Session
@inject JavascriptBridge Js
@inject DataStore Store
@inject IJSRuntime JS

@switch (Session.State)
{
    case OnlineSessionState.Starting:
    case OnlineSessionState.Loading:
        @* Même écran que celui de index.html (logo et nom) : un seul écran de chargement. *@
        <div class="splash-loading" role="status" aria-live="polite">
            <div class="splash-rings">
                <div class="splash-ring splash-ring-outer"></div>
                <div class="splash-ring splash-ring-inner"></div>
                <img class="splash-logo" src="@LogoOuDefaut(LogoGarde)" alt="" />
            </div>
            <div class="splash-title">@(string.IsNullOrWhiteSpace(NomGarde) ? "Gestion communautaire" : NomGarde)</div>
            <div class="splash-dots"><span></span><span></span><span></span></div>
        </div>
        break;
    case OnlineSessionState.SignedOut:
        <AuthPage />
        break;
    case OnlineSessionState.Ready:
        <App />
        break;
    default:
        <AccountStatusPage />
        break;
}

<Toaster />

@code {
    /// <summary>Nom de la communauté gardé sur l'appareil (écran de connexion), avant le chargement des données.</summary>
    public static string? NomGarde { get; set; }

    /// <summary>Logo d'Apparence gardé sur l'appareil, avant le chargement des données.</summary>
    public static string? LogoGarde { get; set; }

    /// <summary>Logo SAFIAF livré avec le site, tant qu'aucun logo n'est réglé dans Apparence.</summary>
    public const string LogoParDefaut = "logo.webp";

    /// <summary>Logo à afficher : celui d'Apparence, sinon le logo livré avec le site.</summary>
    public static string LogoOuDefaut(string? logo) => string.IsNullOrWhiteSpace(logo) ? LogoParDefaut : logo;

    private sealed record MarqueGardee(string? Nom, string? Logo);


    private static readonly string NomParDefaut = new AppSettings().AppName;

    protected override async Task OnInitializedAsync()
    {
        // Les textes qui parlent de « la communauté » citent le nom de l'application.
        try
        {
            var gardee = ((IJSInProcessRuntime)JS).Invoke<MarqueGardee>("guMarque.lire");
            if (string.IsNullOrWhiteSpace(NomGarde)) NomGarde = gardee?.Nom;
            if (gardee?.Logo?.StartsWith("data:image/", StringComparison.Ordinal) == true) LogoGarde = gardee.Logo;
        }
        catch { }
        L.NomApplication = () =>
        {
            var nom = Store.Settings.AppName?.Trim();
            if (string.IsNullOrEmpty(nom) || nom == NomParDefaut) nom = NomGarde?.Trim();
            return string.IsNullOrEmpty(nom) || nom == NomParDefaut ? null : nom;
        };
        // Libellés, icônes et choix ajoutés dans Paramètres › Listes de choix.
        ListesChoix.Source = () => Store.Settings.Listes;
        Session.Changed += OnChanged;
        await Session.InitializeAsync();
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // L'écran de démarrage de index.html (logo et nom) reste affiché jusqu'à ce
        // que les données soient chargées : il n'y a qu'un seul écran de chargement.
        if (Session.State is not (OnlineSessionState.Starting or OnlineSessionState.Loading))
        {
            try { await Js.NotifySplashReadyAsync(); } catch { }
        }
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
