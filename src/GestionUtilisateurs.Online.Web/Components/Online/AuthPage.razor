@inject OnlineSession Session
@inject IJSRuntime JS

<div class="online-auth">
    <aside class="online-auth-hero" aria-hidden="true">
        <div class="online-auth-hero-inner">
            <img class="online-auth-logo" src="@LogoAffiche" alt="" />
            <h2>@(_communaute.Length > 0 ? L.T(_communaute) : L.T("Votre communauté, en ligne"))</h2>
            <p>@L.T("Membres, calendrier, documents, finances, votes et messagerie, partagés en toute sécurité.")</p>
            <ul>
                <li>@L.T("Un compte personnel pour chaque membre")</li>
                <li>@L.T("Des droits selon votre rôle")</li>
                <li>@L.T("Des comptes validés par l'administrateur")</li>
            </ul>
        </div>
    </aside>

    <div class="login-view online-auth-main @(_signup ? "is-signup" : "") @(_google ? "has-google" : "")">
        <LanguePicker CssClass="lang-picker-auth" />
        <div class="login-logo">
            <img class="login-logo-img online-auth-mobile-logo" src="@LogoAffiche" alt="@L.T("Logo de la communauté")" />
            @if (_communaute.Length > 0)
            {
                <h1 class="online-auth-mobile-name">@L.T(_communaute)</h1>
            }
            <p class="login-subtitle">@(_signup ? L.T("Créez votre compte membre") : _forgot ? L.T("Mot de passe oublié") : L.T("Connectez-vous à votre espace membre"))</p>
        </div>

        <div class="login-card">
            <div class="online-auth-tabs" role="tablist">
                <button type="button" role="tab" aria-selected="@(!_signup)" class="@(!_signup ? "active" : "")" @onclick="() => Switch(false)">@L.T("Connexion")</button>
                <button type="button" role="tab" aria-selected="@_signup" class="@(_signup ? "active" : "")" @onclick="() => Switch(true)">@L.T("Inscription")</button>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="login-global-error" role="alert">@_error</div>
            }

            @if (_forgot)
            {
                @if (_forgotSent)
                {
                    <div class="login-info login-success" role="status">
                        <p><strong>@L.T("Demande envoyée.")</strong></p>
                        <p>@L.T("Un administrateur va vous communiquer un mot de passe provisoire (par téléphone, SMS ou de vive voix). Connectez-vous avec ce mot de passe : l'application vous demandera alors de choisir le vôtre.")</p>
                    </div>
                }
                else
                {
                    <p class="login-forgot-intro">@L.T("Saisissez votre identifiant ou l'adresse e-mail de votre compte. Votre demande sera transmise à l'administrateur, qui vous donnera un mot de passe provisoire.")</p>
                    <div class="form-group">
                        <label for="forgot-email">@L.T("Identifiant ou e-mail")</label>
                        <input id="forgot-email" type="text" autocomplete="username" autocapitalize="none" spellcheck="false"
                               placeholder="@L.T("Votre identifiant ou votre e-mail")"
                               value="@_email" @oninput="e => _email = e.Value?.ToString() ?? string.Empty" @onkeydown="OnForgotKeyDown" />
                    </div>
                    <button type="button" class="btn btn-primary btn-block" disabled="@_busy" @onclick="SendForgotAsync">
                        @(_busy ? L.T("Veuillez patienter…") : L.T("Envoyer la demande à l'administrateur"))
                    </button>
                }
                <button type="button" class="login-forgot" @onclick="() => ShowForgot(false)">← @L.T("Retour à la connexion")</button>
            }
            else
            {

            @if (_signup)
            {
                <div class="online-auth-row">
                    <div class="form-group">
                        <label for="su-prenom">@L.T("Prénom")</label>
                        <input id="su-prenom" type="text" autocomplete="given-name" @bind="_prenom" />
                    </div>
                    <div class="form-group">
                        <label for="su-nom">@L.T("Nom")</label>
                        <input id="su-nom" type="text" autocomplete="family-name" @bind="_nom" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="su-tel">@(_sansEmail ? L.T("Téléphone") : L.T("Téléphone (facultatif)"))</label>
                    <input id="su-tel" type="tel" autocomplete="tel" @bind="_telephone" />
                </div>
            }

            @if (_signup)
            {
                <div class="form-group">
                    <div class="online-auth-label-row">
                        @if (!_sansEmail)
                        {
                            <label for="auth-email">@L.T("E-mail")</label>
                        }
                        <label class="online-auth-sans-email">
                            <input type="checkbox" checked="@_sansEmail" @onchange="e => { _sansEmail = e.Value is true; _error = null; }" />
                            @L.T("Je n'ai pas d'adresse e-mail")
                        </label>
                    </div>
                    @if (!_sansEmail)
                    {
                        <input id="auth-email" type="email" autocomplete="email" placeholder="@L.T("vous@exemple.fr")" @bind="_email" />
                    }
                </div>
            }
            else
            {
                <div class="form-group">
                    <label for="auth-email">@L.T("Identifiant ou e-mail")</label>
                    <input id="auth-email" type="text" autocomplete="username" autocapitalize="none" spellcheck="false"
                           placeholder="@L.T("Votre identifiant ou votre e-mail")" @bind="_email" />
                </div>
            }

            <div class="form-group">
                <label for="auth-password">@L.T("Mot de passe")</label>
                <div class="password-input-wrapper">
                    <input id="auth-password" type="@(_showPwd ? "text" : "password")"
                           autocomplete="@(_signup ? "new-password" : "current-password")"
                           placeholder="@(_signup ? L.T("8 caractères minimum") : L.T("Votre mot de passe"))"
                           value="@_password" @oninput="e => _password = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="OnKeyDown" />
                    <button type="button" class="password-toggle" @onclick="() => _showPwd = !_showPwd"
                            aria-label="@(_showPwd ? L.T("Masquer le mot de passe") : L.T("Afficher le mot de passe"))">@(_showPwd ? "🙈" : "👁")</button>
                </div>
            </div>

            @if (_signup)
            {
                <div class="form-group">
                    <label for="su-confirm">@L.T("Confirmer le mot de passe")</label>
                    <input id="su-confirm" type="@(_showPwd ? "text" : "password")" autocomplete="new-password" @bind="_confirm" />
                </div>
            }

            <button type="button" class="btn btn-primary btn-block" disabled="@_busy" @onclick="SubmitAsync">
                @(_busy ? L.T("Veuillez patienter…") : _signup ? L.T("Créer mon compte") : L.T("Se connecter"))
            </button>

            @if (_google && !(_signup && _sansEmail))
            {
                <div class="online-auth-or"><span>@L.T("ou")</span></div>
                <button type="button" class="btn btn-secondary btn-block online-auth-google" disabled="@_busy" @onclick="GoogleAsync">
                    <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
                    @L.T("Continuer avec Google")
                </button>
            }

            @if (!_signup)
            {
                <button type="button" class="login-forgot" @onclick="() => ShowForgot(true)">@L.T("Mot de passe oublié ?")</button>
            }
            else
            {
                <div class="login-info">
                    <p>@(_sansEmail
                        ? L.T("Sans e-mail, vous vous connecterez avec l'identifiant que l'administrateur vous donnera à la validation de votre compte.")
                        : L.T("Après l'inscription, un administrateur valide votre compte et vous attribue un rôle. Vous aurez accès à l'application dès la validation."))</p>
                </div>
            }
            }
        </div>
    </div>
</div>

@code {
    private sealed record Marque(string? Nom, string? Logo, string? Error = null);

    private string _communaute = "";
    private string _logo = "";

    /// <summary>Logo réglé dans Apparence, sinon le logo SAFIAF livré avec le site.</summary>
    private string LogoAffiche => _logo.Length > 0 ? _logo : Root.LogoParDefaut;

    /// <summary>Nom et logo de la communauté : ceux gardés sur l'appareil, puis ceux du serveur.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var gardee = await JS.InvokeAsync<Marque>("guMarque.lire");
            Appliquer(gardee);
        }
        catch { }
        try
        {
            var serveur = await JS.InvokeAsync<Marque>("guOnline.marque");
            if (serveur.Error == null)
            {
                Appliquer(serveur);
                await JS.InvokeVoidAsync("guMarque.ecrire", _communaute, _logo);
            }
        }
        catch { }
    }

    /// <summary>Bouton Google affiché seulement si le fournisseur est activé dans Supabase.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!string.IsNullOrEmpty(Session.AuthMessage))
        {
            _error = Session.AuthMessage;
            Session.AuthMessage = null;
            StateHasChanged();
        }
        try
        {
            if (await Session.GoogleActifAsync())
            {
                _google = true;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task GoogleAsync()
    {
        if (_busy) return;
        _error = null;
        _busy = true;
        try
        {
            _error = await Session.SignInWithGoogleAsync();
        }
        finally
        {
            // En cas de succès la page part vers Google : le bouton reste désactivé.
            if (_error != null) _busy = false;
        }
    }

    private void Appliquer(Marque? m)
    {
        if (m == null) return;
        if (!string.IsNullOrWhiteSpace(m.Nom))
        {
            _communaute = m.Nom.Trim();
            Root.NomGarde = _communaute;
        }
        _logo = m.Logo?.StartsWith("data:image/", StringComparison.Ordinal) == true ? m.Logo : "";
    }

    private bool _signup;
    private bool _busy;
    private bool _showPwd;
    private bool _forgot;
    private bool _sansEmail;
    private bool _google;
    private string _email = "";
    private string _password = "";
    private string _confirm = "";
    private string _prenom = "";
    private string _nom = "";
    private string _telephone = "";
    private string? _error;

    private bool _forgotSent;

    private void Switch(bool signup)
    {
        _signup = signup;
        _forgot = false;
        _error = null;
    }

    private void ShowForgot(bool show)
    {
        _forgot = show;
        _forgotSent = false;
        _error = null;
    }

    private async Task OnForgotKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendForgotAsync();
    }

    private async Task SendForgotAsync()
    {
        if (_busy) return;
        _error = _email.Trim().Length < 2 ? L.T("Saisissez votre identifiant ou votre e-mail.") : null;
        if (_error != null) return;
        _busy = true;
        try
        {
            _error = await Session.RequestPasswordHelpAsync(_email);
            _forgotSent = _error == null;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_signup) await SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _error = Validate();
        if (_error != null) return;
        _busy = true;
        try
        {
            _error = !_signup ? await Session.SignInAsync(_email, _password)
                : _sansEmail ? await Session.SignUpSansEmailAsync(_prenom, _nom, _telephone, _password)
                : await Session.SignUpAsync(_email, _password, _prenom, _nom, _telephone);
        }
        catch (Exception ex)
        {
            _error = L.F("Erreur : {0}", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private string? Validate()
    {
        if (!_signup)
        {
            if (string.IsNullOrWhiteSpace(_email)) return L.T("Saisissez votre identifiant ou votre e-mail.");
            return string.IsNullOrEmpty(_password) ? L.T("Saisissez votre mot de passe.") : null;
        }
        if (string.IsNullOrWhiteSpace(_prenom) || string.IsNullOrWhiteSpace(_nom)) return L.T("Le prénom et le nom sont obligatoires.");
        if (_sansEmail)
        {
            if (_telephone.Count(char.IsDigit) < 6) return L.T("Sans e-mail, le numéro de téléphone est obligatoire.");
        }
        else if (!EmailValide(_email)) return L.T("Saisissez une adresse e-mail valide.");
        if (string.IsNullOrEmpty(_password)) return L.T("Saisissez votre mot de passe.");
        if (_password.Length < 8) return L.T("Le mot de passe doit contenir au moins 8 caractères.");
        if (_password != _confirm) return L.T("Les deux mots de passe ne correspondent pas.");
        return null;
    }

    /// <summary>Forme d'une adresse e-mail (nom@domaine.extension), sans espace.</summary>
    private static bool EmailValide(string email)
        => System.Text.RegularExpressions.Regex.IsMatch(email.Trim(), @"^[^@\s]+@[^@\s]+\.[^@\s]{2,}$");
}
