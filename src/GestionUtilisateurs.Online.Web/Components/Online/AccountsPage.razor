@inject AccountService Accounts
@inject OnlineSession Session
@inject DataStore Store
@inject AppState State

@if (!Store.Can(Permissions.UsersManage))
{
    <EmptyState Icon="🔒" Title="@L.T("Accès réservé")" Message="@L.T("La validation des comptes est réservée aux personnes qui gèrent les utilisateurs.")" />
}
else
{
    <div class="page-head">
        <p>@L.T("Chaque inscription doit être validée ici avant que le membre puisse se connecter. Choisissez son rôle au moment de la validation ; il pourra être changé ensuite depuis la fiche du membre.")</p>
    </div>

    @if (_loading)
    {
        <div class="card online-muted">@L.T("Chargement des comptes…")</div>
    }
    else if (_error != null)
    {
        <div class="card online-error" role="alert">@_error</div>
    }
    else
    {
        @if (Store.IsAdmin && PasswordRequests.Count > 0)
        {
            <section class="card online-section online-password-requests">
                <div class="online-section-head">
                    <h3>🔑 @L.T("Mots de passe oubliés")</h3>
                    <span class="online-count online-count-hot">@PasswordRequests.Count</span>
                </div>
                <p class="text-muted">@L.T("Ces membres ont demandé un nouveau mot de passe depuis l'écran de connexion. Donnez-leur un mot de passe provisoire et transmettez-le-leur vous-même (téléphone, SMS ou de vive voix) : à la connexion suivante, ils devront choisir leur propre mot de passe.")</p>
                <div class="online-account-list">
                    @foreach (var p in PasswordRequests)
                    {
                        var profile = p;
                        <div class="online-account">
                            <div class="online-account-main">
                                <Avatar UserName="@profile.NomComplet" Seed="@profile.Email" Size="sm" />
                                <div>
                                    <strong>@profile.NomComplet</strong>
                                    <div class="text-muted online-account-meta">@profile.EmailAffiche@(string.IsNullOrWhiteSpace(profile.Telephone) ? "" : " · " + profile.Telephone)</div>
                                    <div class="text-muted online-account-meta">@L.F("Demande du {0}", Date(profile.MdpDemandeAt))</div>
                                </div>
                            </div>
                            <div class="online-account-actions">
                                <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => OpenPassword(profile)">@L.T("Donner un mot de passe provisoire")</button>
                                <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => DismissAsync(profile)">@L.T("Ignorer")</button>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <section class="card online-section">
            <div class="online-section-head">
                <h3>@L.T("Demandes en attente")</h3>
                <span class="online-count @(Pending.Count > 0 ? "online-count-hot" : "")">@Pending.Count</span>
            </div>
            @if (Pending.Count == 0)
            {
                <p class="text-muted">@L.T("Aucune demande en attente.")</p>
            }
            else
            {
                <div class="online-account-list">
                    @foreach (var p in Pending)
                    {
                        var profile = p;
                        <div class="online-account">
                            <div class="online-account-main">
                                <Avatar UserName="@profile.NomComplet" Seed="@profile.Email" Size="sm" />
                                <div>
                                    <strong>@profile.NomComplet</strong>
                                    <div class="text-muted online-account-meta">@profile.EmailAffiche@(string.IsNullOrWhiteSpace(profile.Telephone) ? "" : " · " + profile.Telephone)</div>
                                    <div class="text-muted online-account-meta">@L.F("Inscrit le {0}", Date(profile.CreatedAt))</div>
                                    @{ var fiches = FichesSimilaires(profile); }
                                    @if (fiches.Count > 0)
                                    {
                                        <div class="online-link-fiche">
                                            <label for="lien-@profile.Id">@L.T("⚠ Une fiche existe peut-être déjà pour cette personne :")</label>
                                            <select id="lien-@profile.Id" value="@LienFor(profile, fiches)" @onchange="e => _liens[profile.Id] = e.Value?.ToString() ?? NouvelleFiche">
                                                @foreach (var f in fiches)
                                                {
                                                    <option value="@f.Fiche.Id">@L.F("Relier à la fiche de {0} ({1})", f.Fiche.NomComplet, Raison(f.Raison))</option>
                                                }
                                                <option value="@NouvelleFiche">@L.T("Créer une nouvelle fiche")</option>
                                            </select>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="online-account-actions">
                                <select aria-label="@L.F("Rôle attribué à {0}", profile.NomComplet)" value="@RoleFor(profile)" @onchange="e => _roles[profile.Id] = e.Value?.ToString() ?? Roles.Utilisateur">
                                    @foreach (var role in AssignableRoles)
                                    {
                                        <option value="@role">@L.T(role)</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => ApproveAsync(profile)">@L.T("Valider")</button>
                                <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => RejectAsync(profile)">@L.T("Refuser")</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="card online-section">
            <div class="online-section-head">
                <h3>@L.T("Comptes en ligne")</h3>
                <span class="online-count">@Others.Count</span>
            </div>
            <div class="online-account-list">
                @foreach (var p in Others)
                {
                    var profile = p;
                    <div class="online-account">
                        <div class="online-account-main">
                            <Avatar UserName="@profile.NomComplet" Seed="@profile.Email" Size="sm" />
                            <div>
                                <strong>@profile.NomComplet</strong>
                                <span class="online-status-pill online-status-@profile.Statut">@L.T(OnlineStatuts.Label(profile.Statut))</span>
                                @if (profile.MdpProvisoire)
                                {
                                    <span class="online-status-pill online-status-provisoire" title="@L.T("Le membre doit encore choisir son propre mot de passe.")">@L.T("Mot de passe provisoire")</span>
                                }
                                <div class="text-muted online-account-meta">@Contact(profile) · @L.T(profile.Role)</div>
                                <div class="text-muted online-account-meta">@L.F("Dernière visite : {0}", Date(profile.LastSeenAt))</div>
                            </div>
                        </div>
                        <div class="online-account-actions">
                            @if (profile.Statut == OnlineStatuts.Actif && Store.IsAdmin && profile.Id != Session.Profile?.Id)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => OpenPassword(profile)">@L.T("Nouveau mot de passe")</button>
                            }
                            @if (profile.Statut == OnlineStatuts.Refuse)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => ApproveAsync(profile)">@L.T("Valider quand même")</button>
                                <button type="button" class="btn btn-danger btn-sm" disabled="@_busy" @onclick="() => _toDelete = profile">@L.T("Supprimer")</button>
                            }
                        </div>
                    </div>
                }
            </div>
            <p class="field-hint">@L.T("Pour changer le rôle d'un membre ou désactiver son compte, modifiez sa fiche dans « Utilisateurs » : le compte en ligne suit automatiquement.")</p>
        </section>
    }
}

<Modal Title="@L.T("Nouveau mot de passe")" Show="_pwdFor != null" OnClose="() => _pwdFor = null">
    <ChildContent>
        <p>@L.T("Définissez un mot de passe provisoire pour") <strong>@_pwdFor?.NomComplet</strong> @L.T("et transmettez-le-lui (téléphone, SMS ou de vive voix). À sa prochaine connexion, l'application lui demandera de choisir son propre mot de passe.")</p>
        <div class="form-group">
            <label for="new-pwd">@L.T("Mot de passe provisoire")</label>
            <div class="online-temp-password">
                <input id="new-pwd" type="text" autocomplete="off" spellcheck="false" @bind="_newPassword" />
                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _newPassword = AccountService.GenerateTemporaryPassword()">@L.T("Générer")</button>
            </div>
            <span class="field-hint">@L.T("8 caractères minimum. Notez-le avant d'enregistrer.")</span>
            @if (!string.IsNullOrWhiteSpace(_pwdFor?.Telephone))
            {
                <span class="field-hint">@L.F("Téléphone du membre : {0}", _pwdFor!.Telephone)</span>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="() => _pwdFor = null">@L.T("Annuler")</button>
        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SavePasswordAsync">@L.T("Enregistrer")</button>
    </FooterContent>
</Modal>

<ConfirmDialog Show="_toDelete != null" Title="@L.T("Supprimer la demande")"
               Message="@L.F("Supprimer définitivement la demande de {0} ? La personne pourra se réinscrire.", _toDelete?.NomComplet)"
               ConfirmLabel="@L.T("Supprimer")" Danger="true"
               OnConfirm="DeleteAsync" OnCancel="() => _toDelete = null" />

@code {
    private List<OnlineProfile> _profiles = new();
    private readonly Dictionary<string, string> _roles = new();
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private OnlineProfile? _pwdFor;
    private OnlineProfile? _toDelete;
    private string _newPassword = "";

    private List<OnlineProfile> Pending => _profiles.Where(p => p.Statut == OnlineStatuts.EnAttente).ToList();
    private List<OnlineProfile> Others => _profiles.Where(p => p.Statut != OnlineStatuts.EnAttente).ToList();
    private List<OnlineProfile> PasswordRequests => _profiles
        .Where(p => p.Statut == OnlineStatuts.Actif && p.MdpDemandeAt != null && p.Id != Session.Profile?.Id)
        .OrderBy(p => p.MdpDemandeAt).ToList();

    /// <summary>Un gestionnaire ne peut pas nommer d'administrateur (vérifié aussi par le serveur).</summary>
    private IEnumerable<string> AssignableRoles => Store.IsAdmin
        ? Roles.MatrixRoles
        : Roles.MatrixRoles.Where(r => !Roles.IsAdmin(r));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var res = await Accounts.ListAsync();
        _error = res.Error;
        _profiles = res.Data ?? new List<OnlineProfile>();
        _loading = false;
        await Session.RefreshAdminStatusAsync();
    }

    private string RoleFor(OnlineProfile p) => _roles.TryGetValue(p.Id, out var r) ? r : Roles.Utilisateur;

    // Fiche à relier au compte validé (évite une seconde fiche pour la même personne).
    private const string NouvelleFiche = "__nouvelle__";
    private readonly Dictionary<string, string> _liens = new();

    private IReadOnlyList<(UserAccount Fiche, string Raison)> FichesSimilaires(OnlineProfile p)
        => Store.FichesPourInscription(p.Prenom, p.Nom, p.Email, p.Telephone);

    /// <summary>Par défaut, la fiche est reliée seulement si l'e-mail est identique (homonymes possibles sinon).</summary>
    private string LienFor(OnlineProfile p, IReadOnlyList<(UserAccount Fiche, string Raison)> fiches)
    {
        if (_liens.TryGetValue(p.Id, out var v)) return v;
        var parEmail = fiches.FirstOrDefault(f => f.Raison.Contains("e-mail"));
        return parEmail.Fiche?.Id ?? NouvelleFiche;
    }

    private async Task ApproveAsync(OnlineProfile profile)
    {
        _busy = true;
        var role = profile.Statut == OnlineStatuts.Refuse ? Roles.Utilisateur : RoleFor(profile);
        var fiches = FichesSimilaires(profile);
        var lien = fiches.Count > 0 ? LienFor(profile, fiches) : NouvelleFiche;
        var error = await Accounts.ApproveAsync(profile, role, lien == NouvelleFiche ? null : lien);
        _busy = false;
        if (error != null) { State.NotifyError(error); return; }
        var identifiant = Identifiant(profile);
        State.NotifySuccess(profile.EstSansEmail && identifiant != null
            ? L.F("{0} peut maintenant se connecter ({1}). Sans e-mail : donnez-lui son identifiant « {2} ».", profile.NomComplet, L.T(role), identifiant)
            : L.F("{0} peut maintenant se connecter ({1}).", profile.NomComplet, L.T(role)));
        await LoadAsync();
    }

    private string? Identifiant(OnlineProfile profile) => Store.Users.FirstOrDefault(u => u.Id == profile.Id)?.Identifiant;

    /// <summary>E-mail du compte ; sans e-mail, l'identifiant de connexion à transmettre au membre.</summary>
    private string Contact(OnlineProfile profile)
        => !profile.EstSansEmail ? profile.Email
            : Identifiant(profile) is { } id ? L.F("Sans e-mail, identifiant : {0}", id)
            : L.T("Sans e-mail");

    private async Task RejectAsync(OnlineProfile profile)
    {
        _busy = true;
        var error = await Accounts.RejectAsync(profile);
        _busy = false;
        if (error != null) { State.NotifyError(error); return; }
        State.NotifyInfo(L.F("Inscription de {0} refusée.", profile.NomComplet));
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        var profile = _toDelete;
        _toDelete = null;
        if (profile == null) return;
        var error = await Accounts.DeleteRequestAsync(profile);
        if (error != null) { State.NotifyError(error); return; }
        State.NotifySuccess(L.T("Demande supprimée."));
        await LoadAsync();
    }

    private void OpenPassword(OnlineProfile profile)
    {
        _newPassword = AccountService.GenerateTemporaryPassword();
        _pwdFor = profile;
    }

    private async Task DismissAsync(OnlineProfile profile)
    {
        _busy = true;
        var error = await Accounts.DismissPasswordRequestAsync(profile);
        _busy = false;
        if (error != null) { State.NotifyError(error); return; }
        State.NotifyInfo(L.F("Demande de {0} écartée.", profile.NomComplet));
        await LoadAsync();
    }

    private async Task SavePasswordAsync()
    {
        if (_pwdFor == null) return;
        if (_newPassword.Length < 8) { State.NotifyError(L.T("Le mot de passe doit contenir au moins 8 caractères.")); return; }
        _busy = true;
        var error = await Accounts.SetPasswordAsync(_pwdFor, _newPassword);
        _busy = false;
        if (error != null) { State.NotifyError(error); return; }
        State.NotifySuccess(L.F("Mot de passe provisoire de {0} : {1}. Transmettez-le-lui.", _pwdFor.NomComplet, _newPassword));
        _pwdFor = null;
        await LoadAsync();
    }

    private static string Date(DateTimeOffset? d) => d == null ? L.T("jamais") : L.F("{0:dd/MM/yyyy} à {0:HH:mm}", d.Value.ToLocalTime());

    /// <summary>Raisons « même nom, même e-mail » affichées dans la langue du membre.</summary>
    private static string Raison(string raison) => string.Join(", ", raison.Split(", ").Select(r => L.T(r)));
}
