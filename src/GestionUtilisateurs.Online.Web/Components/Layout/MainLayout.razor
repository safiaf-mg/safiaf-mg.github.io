    private void ComputeCalDate()
    {
        var today = DateTime.Today;
        _calKey = today.ToString("yyyy-MM-dd");
        _calEventsToday = Store.Events.Count(e => CalendarPage.OccursOn(e, today));
        // Malgache : 4 lettres (alah, alat, alar, alak) pour distinguer les jours en « ala- ».
        var jour = L.Jour(today.DayOfWeek);
        var abbr = jour[..Math.Min(L.Langue == L.Mg ? 4 : 3, jour.Length)];
        _calWeekday = char.ToUpperInvariant(abbr[0]) + abbr[1..];
        _calDay = today.Day.ToString();
        _calMonthLabel = L.Majuscule(L.MoisAnnee(today));
    }

    /// <summary>Entrées de la barre latérale web : navigation principale puis menu « … ».</summary>
    private List<MoreItem> SidebarItems
    {
        get
        {
            var list = new List<MoreItem>();
            if (Store.IsBaseAdmin)
                list.Add(new("data", L.T("Gestion de données"), "🗄", "", () => true, () => Go("data")));
            else
            {
                list.Add(new("dashboard", L.T("Accueil"), "🏠", "", () => true, () => Go("dashboard")));
                list.Add(new("users", Store.IsManager ? L.T("Utilisateurs") : L.T("Mes informations"), "👥", "", () => true, () => Go("users")));
                list.Add(new("calendar", L.T("Calendrier"), "📅", "", () => true, () => Go("calendar")));
                if (Store.IsManager) list.Add(new("activity", L.T("Activité"), "🧾", "", () => true, () => Go("activity")));
            }
            list.AddRange(VisibleMoreItems);
            // Sur grand écran la barre du bas est masquée : les Paramètres passent dans la barre latérale.
            if (!Store.IsBaseAdmin)
                list.Add(new("settings", L.T("Paramètres"), "⚙", "", () => true, () => Go("settings")));
            return list;
        }
    }

    private bool _pwdOpen;
    private bool _pwdBusy;
    private string _pwd1 = "";
    private string _pwd2 = "";

    /// <summary>Un mot de passe provisoire doit être remplacé : la fenêtre ne se ferme pas.</summary>
    private void ClosePassword()
    {
        if (!Online.MustChangePassword) _pwdOpen = false;
    }

    private void OpenPassword()
    {
        _menuOpen = false;
        _pwd1 = _pwd2 = "";
        _pwdOpen = true;
    }

    private async Task SavePasswordAsync()
    {
        if (_pwd1.Length < 8) { State.NotifyError(L.T("Le mot de passe doit contenir au moins 8 caractères.")); return; }
        if (_pwd1 != _pwd2) { State.NotifyError(L.T("Les deux mots de passe ne correspondent pas.")); return; }
        _pwdBusy = true;
        var error = await Online.ChangePasswordAsync(_pwd1);
        _pwdBusy = false;
        if (error != null) { State.NotifyError(error); return; }
        _pwdOpen = false;
        State.NotifySuccess(L.T("Mot de passe modifié."));
    }

    private void OnOnlineChanged() => _ = InvokeAsync(StateHasChanged);

    private void CommencerApercu(string role)
    {
        var res = Store.CommencerApercu(role);
        if (!res.Success) { State.NotifyError(res.Error ?? L.T("Action impossible.")); return; }
        Go("dashboard");
    }

    private void TerminerApercu()
    {
        Store.TerminerApercu();
        Go("dashboard");
    }

    private void Go(string page)
    {
        _menuOpen = false;
        CloseMore();
        State.Navigate(page);
        try { _ = Js.ScrollToTopAsync(); } catch { }
    }

    private void GoBack()
    {
        _menuOpen = false;
        CloseMore();
        State.GoBack();
        try { _ = Js.ScrollToTopAsync(); } catch { }
    }

    private void AskLogout()
    {
        _menuOpen = false;
        CloseMore();
        _confirmLogout = true;
    }

    private void ConfirmLogout()
    {
        _confirmLogout = false;
        State.ResetNavigation();
        Store.Logout();
    }

    public async void Dispose()
    {
        _calTimer?.Dispose();
        _renderTimer?.Dispose();
        CloseMore();
        if (_swipeStarted)
        {
            try { await Js.DisableSwipeBackAsync(); } catch { }
            try { await Js.DisableSystemBackAsync(); } catch { }
            _swipeRef?.Dispose();
        }
        Store.DataChanged -= OnChanged;
        Store.SessionChanged -= OnChanged;
        State.PageChanged -= OnChanged;
        Online.Changed -= OnOnlineChanged;
        State.TourRequested -= OnTourRequested;
    }
}
