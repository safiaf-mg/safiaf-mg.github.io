    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Le geste « retour » du système revient à la page précédente tant qu'il y en a une.
        if (_swipeStarted && State.HasHistory != _retourSignale)
        {
            _retourSignale = State.HasHistory;
            await Js.SetHasPreviousPageAsync(_retourSignale);
        }
        if (firstRender)
        {
            _swipeRef = DotNetObjectReference.Create(this);
            await Js.EnableSwipeBackAsync(_swipeRef);
            _swipeStarted = true;
            await Js.EnableSystemBackAsync(_swipeRef);
