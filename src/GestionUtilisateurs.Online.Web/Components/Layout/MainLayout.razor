@implements IDisposable
@inject LangueService Langues
@inject DataStore Store
@inject AppState State
@inject JavascriptBridge Js
@inject OnlineSession Online

<div class="app-shell">
    @* Navigation latérale de la version web (écrans larges uniquement ; le mobile garde la barre du bas). *@
    <aside class="web-sidebar" aria-label="@L.T("Navigation principale")">
        <div class="web-sidebar-brand">
            <button type="button" class="web-sidebar-logo" aria-label="@L.T("Afficher le logo et l'histoire de la communauté")" @onclick="OpenLogo">
                <img src="@Root.LogoOuDefaut(Store.Settings.Logo)" alt="" />
            </button>
            <span class="web-sidebar-name">@L.T(Store.Settings.AppName)</span>
        </div>
        <nav class="web-sidebar-nav">
            @foreach (var item in SidebarItems)
            {
                var it = item;
                var badge = it.Key == "storage" ? "" : MoreBadge(it.Key);
                <button type="button" class="web-nav-item @(NavCls(it.Key))" data-nav="@it.Key" @onclick="it.Act">
                    <span class="web-nav-icon" aria-hidden="true">@it.Icon</span>
                    <span class="web-nav-label">@it.Label</span>
                    @if (!string.IsNullOrEmpty(badge))
                    {
                        <span class="web-nav-badge">@badge</span>
                    }
                </button>
            }
        </nav>
        <div class="web-sidebar-foot">
            <button type="button" class="web-nav-item" @onclick='() => Go("profile")'>
                <Avatar UserName="@currentUser?.NomComplet" Seed="@currentUser?.Identifiant" Size="sm" Photo="@currentUser?.Photo" />
                <span class="web-nav-label">@currentUser?.NomComplet<small>@L.T(currentUser?.Role)</small></span>
            </button>
        </div>
    </aside>

    <header class="app-topbar">
        @if (State.HasHistory)
        {
            <button class="back-button" aria-label="@L.T("Retour")" @onclick="GoBack">
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6"/></svg>
            </button>
        }
        <button type="button" class="logo-btn" aria-label="@L.T("Afficher le logo et l'histoire de la communauté")" @onclick="OpenLogo">
            <img class="topbar-logo" src="@Root.LogoOuDefaut(Store.Settings.Logo)" alt="@L.T("Logo")" />
        </button>
        <h2 class="page-title">@PageTitle</h2>
        <div class="topbar-actions">
            <div class="dropdown-wrap">
                <button class="avatar-button" aria-label="@L.T("Menu utilisateur")" @onclick="ToggleMenu">
                    <Avatar UserName="@currentUser?.NomComplet" Seed="@currentUser?.Identifiant" Size="sm" Photo="@currentUser?.Photo" />
                </button>
            </div>
            @if (State.CurrentPage != "guide")
            {
                <div class="dropdown-wrap">
                    <button class="topbar-menu-btn topbar-help-btn" aria-label="@L.T("Aide sur cette page")" @onclick="OpenHelp" title="@L.T("Aide sur cette page")">
                        <span class="topbar-help-icon" aria-hidden="true">ⓘ</span>
                    </button>
                </div>
            }
            <div class="dropdown-wrap">
                <button class="topbar-menu-btn" aria-label="@L.T("Plus d'options")" @onclick="ToggleMore">
                    <span class="topbar-menu-icon" aria-hidden="true">⋮</span>
                </button>
            </div>
        </div>
    </header>

    @if (_menuOpen)
    {
        <div class="user-menu" @onmousedown="NoOp" @onmousedown:stopPropagation="true" @onclick="NoOp" @onclick:stopPropagation="true">
            <button class="user-menu-header-btn" @onclick='() => Go("profile")'>
                <div class="user-menu-header">
                    <strong>@currentUser?.NomComplet</strong>
                    <Badge Text="@currentUser?.Role" Kind="role" />
                    <span class="text-muted" style="font-size:12px">@currentUser?.Identifiant</span>
                </div>
            </button>
            <button class="user-menu-item" @onclick='() => Go("profile")'><span class="menu-icon menu-profile" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="8" r="3.6" fill="currentColor" opacity=".25"/><circle cx="12" cy="8" r="3.6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4.5 20c1.4-3.4 4.2-5 7.5-5s6.1 1.6 7.5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><span class="menu-label">@L.T("Mes informations")</span></button>
            <button class="user-menu-item" @onclick="OpenPassword"><span class="menu-icon" aria-hidden="true">🔑</span><span class="menu-label">@L.T("Changer mon mot de passe")</span></button>
            @if (Store.EstAdministrateurReel)
            {
                <div class="user-menu-section">@L.T("Voir l'application en tant que")</div>
                @foreach (var role in DataStore.RolesApercu)
                {
                    var r = role;
                    <button class="user-menu-item @(Store.RoleApercu == r ? "active" : "")" @onclick="() => CommencerApercu(r)"><span class="menu-icon" aria-hidden="true">@(r == Roles.Gestionnaire ? "🧰" : "👤")</span><span class="menu-label">@L.T(r)</span></button>
                }
                @if (Store.EnApercu)
                {
                    <button class="user-menu-item" @onclick="TerminerApercu"><span class="menu-icon" aria-hidden="true">↩</span><span class="menu-label">@L.T("Quitter l'aperçu")</span></button>
                }
            }
            <button class="user-menu-item danger" @onclick="AskLogout"><span class="menu-icon menu-logout" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M14 4H6a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h8" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M10 12h10m-3-3 3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="menu-label">@L.T("Déconnexion")</span></button>
        </div>
    }

    <main class="app-content" @onmousedown="CloseMenuFromOutside">
        @if (Store.EnApercu)
        {
            <div class="quota-banner apercu-banner" role="status">
                <span class="quota-banner-icon" aria-hidden="true">👁</span>
                <div class="quota-banner-main">
                    <strong>@L.F("Aperçu en tant que {0}", L.T(Store.RoleApercu))</strong>
                    <span>@L.T("Vous voyez les menus et les boutons de ce rôle. Ce que vous faites pendant l'aperçu est réellement enregistré.")</span>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="TerminerApercu">@L.T("Quitter l'aperçu")</button>
            </div>
        }
        @if (Online.IsAdmin && Store.IsAdmin && Online.Admin.Level != "ok")
        {
            <div class="quota-banner @(Online.Admin.Level == "critique" ? "quota-banner-critical" : "")" role="alert">
                <span class="quota-banner-icon" aria-hidden="true">@(Online.Admin.Level == "critique" ? "⛔" : "⚠")</span>
                <div class="quota-banner-main">
                    <strong>@(Online.Admin.Level == "critique" ? L.T("Serveur bientôt saturé") : L.T("Espace serveur à surveiller"))</strong>
                    <span>@L.F("{0} alerte(s) de capacité Supabase à traiter (offre gratuite).", Online.Admin.OpenAlerts)</span>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" @onclick='() => Go("capacite")'>@L.T("Voir")</button>
            </div>
        }
        @if (Online.Admin.PendingAccounts > 0 && Store.Can(Permissions.UsersManage) && State.CurrentPage != "comptes")
        {
            <div class="quota-banner online-pending-banner" role="status">
                <span class="quota-banner-icon" aria-hidden="true">👤</span>
                <div class="quota-banner-main">
                    <strong>@L.F("{0} inscription(s) à valider", Online.Admin.PendingAccounts)</strong>
                    <span>@L.T("Ces personnes attendent votre validation pour accéder à l'application.")</span>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" @onclick='() => Go("comptes")'>@L.T("Valider")</button>
            </div>
        }
        @if (Online.Admin.PasswordRequests > 0 && Online.IsAdmin && Store.IsAdmin && State.CurrentPage != "comptes")
        {
            <div class="quota-banner online-pending-banner" role="status">
                <span class="quota-banner-icon" aria-hidden="true">🔑</span>
                <div class="quota-banner-main">
                    <strong>@L.F("{0} demande(s) de mot de passe oublié", Online.Admin.PasswordRequests)</strong>
                    <span>@L.T("Donnez un mot de passe provisoire à ces membres dans « Comptes en ligne ».")</span>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" @onclick='() => Go("comptes")'>@L.T("Traiter")</button>
            </div>
        }
        @if (false && _storageLevel != "ok")
        {
            <div class="quota-banner @(_storageLevel == "critical" ? "quota-banner-critical" : "")" role="alert">
                <span class="quota-banner-icon" aria-hidden="true">@(_storageLevel == "critical" ? "⛔" : "⚠")</span>
                <div class="quota-banner-main">
                    <strong>@(_storageLevel == "critical" ? L.F("Stockage saturé ({0} %)", _storagePercent.ToString("0")) : L.F("Stockage presque plein ({0} %)", _storagePercent.ToString("0")))</strong>
                    <span>@L.F("{0} utilisés sur {1}. Videz la corbeille et les archives pour libérer de l'espace.", FormatSize(_storageUsedBytes), _storageQuotaLabel)</span>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="OpenStorage">@L.T("Voir")</button>
            </div>
        }
        @if (_showContextBanner && _contextHelp is { } ctx)
        {
            <div class="help-banner" role="status">
                <span class="help-banner-icon" aria-hidden="true">@ctx.Icon</span>
                <div class="help-banner-main">
                    <strong>@TitreAide(ctx)</strong>
                    <p>@ctx.Summary</p>
                </div>
                <div class="help-banner-actions">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="OpenHelp">@L.T("En savoir plus")</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="DismissContextHelp">@L.T("OK, j'ai compris")</button>
                </div>
            </div>
        }
        @ChildContent
    </main>

    <nav class="bottom-nav">
        @if (Store.IsBaseAdmin)
        {
            <button class="bottom-nav-item @(NavCls("data"))" @onclick="@(() => Go("data"))">
                <span class="bn-icon nav-svg nav-data" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><ellipse cx="12" cy="5.5" rx="7" ry="2.8" fill="currentColor" opacity=".3"/><path d="M5 5.5v13c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8v-13" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5 12c0 1.5 3.1 2.8 7 2.8s7-1.3 7-2.8" fill="none" stroke="currentColor" stroke-width="1.8" opacity=".7"/></svg></span><span class="bn-label">@L.T("Gestion de données")</span>
            </button>
        }
        else
        {
            <button class="bottom-nav-item @(NavCls("dashboard"))" @onclick="@(() => Go("dashboard"))">
                <span class="bn-icon nav-svg nav-home" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path d="M4 10.5 12 3.5l8 7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 9.5V20h12V9.5" fill="currentColor" opacity=".18"/><path d="M6 9.5V20h12V9.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><circle cx="12" cy="14.5" r="1.6" fill="currentColor"/></svg></span><span class="bn-label">@L.T("Accueil")</span>
            </button>
            <button class="bottom-nav-item @(NavCls("users"))" @onclick="@(() => Go("users"))">
                <span class="bn-icon nav-svg nav-users" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><circle cx="9" cy="8" r="3.2" fill="currentColor" opacity=".25"/><circle cx="9" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 19c1-3 3.2-4.5 6-4.5s5 1.5 6 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="16.5" cy="9" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M16 14.6c2 .3 3.6 1.5 4.5 3.9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span><span class="bn-label">@(Store.IsManager ? L.T("Utilisateurs") : L.T("Mes informations"))</span>
            </button>
            <button class="bottom-nav-item cal-nav-item @(NavCls("calendar"))" @onclick="@(() => Go("calendar"))" aria-label="@L.F("Calendrier — {0} {1}", _calWeekday, _calDay)">
                <span class="bn-icon cal-nav-icon nav-cal" aria-hidden="true">
                    <span class="cal-nav-weekday">@_calWeekday</span>
                    <span class="cal-nav-day">@_calDay</span>
                </span>
                @if (_calEventsToday > 0)
                {
                    <span class="cal-nav-badge" aria-label="@L.F("{0} événement(s) aujourd'hui", _calEventsToday)">@_calEventsToday</span>
                }
                <span class="bn-label">@L.T("Calendrier")</span>
            </button>
            @if (Store.IsManager)
            {
                <button class="bottom-nav-item @(NavCls("activity"))" @onclick="@(() => Go("activity"))">
                    <span class="bn-icon nav-svg nav-activity" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><rect x="5" y="4" width="14" height="17" rx="2.5" fill="currentColor" opacity=".15"/><rect x="5" y="4" width="14" height="17" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 9.5h6M9 13h6M9 16.5h3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M15.5 2.8v3.5h3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span><span class="bn-label">@L.T("Activité")</span>
                </button>
            }
            <button class="bottom-nav-item @(NavCls("settings"))" @onclick="@(() => Go("settings"))" aria-label="@L.T("Paramètres")">
                <span class="bn-icon nav-svg nav-settings" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5l1.2 2.7 2.9-.6 1 2.8 2.9.8-.5 2.9 2 2.1-2 2.1.5 2.9-2.9.8-1 2.8-2.9-.6L12 21.5l-1.2-2.7-2.9.6-1-2.8-2.9-.8.5-2.9-2-2.1 2-2.1-.5-2.9 2.9-.8 1-2.8 2.9.6z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg></span><span class="bn-label">@L.T("Paramètres")</span>
            </button>
        }
    </nav>

    @if (_moreOpen)
    {
        <div class="more-overlay" @onclick="CloseMore">
            <div class="user-menu more-sheet" role="dialog" aria-label="@L.T("Menu")" @onmousedown="NoOp" @onmousedown:stopPropagation="true" @onclick="NoOp" @onclick:stopPropagation="true">
                <div class="more-head">
                    <button type="button" class="modal-close" aria-label="@L.T("Fermer le menu")" @onclick="CloseMore">×</button>
                </div>
                <div class="more-sheet-grid @MenuGridCls">
                    @foreach (var menuItem in (_visibleMore ?? VisibleMoreItems))
                    {
                        var it = menuItem;
                        var badge = CachedBadge(it.Key);
                        <button type="button" class="user-menu-item more-card" @onclick="it.Act">
                            <span class="menu-icon @it.IconClass" aria-hidden="true">@it.Icon</span>
                            <span class="menu-label">@it.Label</span>
                            @if (!string.IsNullOrEmpty(badge))
                            {
                                <span class="menu-badge" aria-label="@L.F("{0} notification(s)", badge)">@badge</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <Modal Title="@(Online.MustChangePassword ? L.T("Choisissez votre mot de passe") : L.T("Changer mon mot de passe"))"
           Show="_pwdOpen || Online.MustChangePassword" Closable="!Online.MustChangePassword" OnClose="ClosePassword">
        <ChildContent>
            @if (Online.MustChangePassword)
            {
                <p class="online-force-pwd-intro">@L.T("Vous vous êtes connecté avec un mot de passe provisoire donné par l'administrateur. Choisissez maintenant votre propre mot de passe : vous l'utiliserez pour vos prochaines connexions.")</p>
            }
            <div class="form-group">
                <label for="me-pwd">@L.T("Nouveau mot de passe")</label>
                <MotDePasseInput Id="me-pwd" @bind-Value="_pwd1" Autocomplete="new-password" />
            </div>
            <div class="form-group">
                <label for="me-pwd2">@L.T("Confirmer")</label>
                <MotDePasseInput Id="me-pwd2" @bind-Value="_pwd2" Autocomplete="new-password" />
                <span class="field-hint">@L.T("8 caractères minimum.")</span>
            </div>
        </ChildContent>
        <FooterContent>
            @if (Online.MustChangePassword)
            {
                <button type="button" class="btn btn-secondary" @onclick="() => Online.SignOutAsync()">@L.T("Se déconnecter")</button>
            }
            else
            {
                <button type="button" class="btn btn-secondary" @onclick="() => _pwdOpen = false">@L.T("Annuler")</button>
            }
            <button type="button" class="btn btn-primary" disabled="@_pwdBusy" @onclick="SavePasswordAsync">@L.T("Enregistrer")</button>
        </FooterContent>
    </Modal>

    <ConfirmDialog Show="_confirmLogout" Title="@L.T("Déconnexion")"
                   Message="@L.T("Voulez-vous vraiment vous déconnecter ?")"
                   ConfirmLabel="@L.T("Se déconnecter")" Danger="true"
                   OnConfirm="ConfirmLogout" OnCancel="() => _confirmLogout = false" />

    <Modal Title="" Show="_logoOpen" OnClose="() => _logoOpen = false">
        <ChildContent>
            <div class="logo-modal">
                <img class="logo-modal-img" src="@Root.LogoOuDefaut(Store.Settings.Logo)" alt="@L.T("Logo de la communauté")" />
                @if (_logoHasStory)
                {
                    <div class="logo-modal-story">
                        @if (!string.IsNullOrWhiteSpace(Store.Community.Titre))
                        {
                            <div class="logo-modal-title">@Store.TitreHistoireAffiche()</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Store.Community.SousTitre))
                        {
                            <div class="logo-modal-subtitle">@Store.Community.SousTitre</div>
                        }
                        @if (Store.Community.Chapitres.Count > 0)
                        {
                            <div class="logo-modal-chapters">
                                @foreach (var ch in Store.Community.Chapitres.Take(3))
                                {
                                    <div class="logo-modal-chapter">
                                        <span class="logo-modal-chapter-dot" aria-hidden="true">●</span>
                                        <div>
                                            <div class="logo-modal-chapter-title">@ch.Titre</div>
                                            @if (!string.IsNullOrWhiteSpace(ch.Date))
                                            {
                                                <div class="logo-modal-chapter-date">@DataStore.FormatDateCourte(ch.Date)</div>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (Store.Community.Chapitres.Count > 3)
                                {
                                    <div class="logo-modal-more">@L.F("… et {0} autre(s) chapitre(s)", Store.Community.Chapitres.Count - 3)</div>
                                }
                            </div>
                            <button type="button" class="btn btn-primary btn-block" style="margin-top:12px" @onclick="OpenCommunityFromLogo">@L.T("📖 Ouvrir l'histoire complète")</button>
                        }
                    </div>
                }
            </div>
        </ChildContent>
    </Modal>

    <Modal Title="@L.T("Espace de stockage utilisé")" Show="_showStorage" CssClass="modal-storage" OnClose="() => _showStorage = false">
        <ChildContent>
            <p class="muted" style="margin-top:0">@L.T("Répartition des données de la communauté par module. Touchez un module pour voir le détail.")</p>
            <div class="storage-items">
                @foreach (var item in _storageBreakdown)
                {
                    <div class="storage-item storage-item-link" role="button" tabindex="0" aria-label="@L.F("Voir le détail {0}", item.Label)" @onclick="() => OpenStorageDetail(item.Key)" @onkeydown="(k) => OnStorageKey(k, item.Key)">
                        <div class="storage-item-main">
                            <div class="storage-item-label">@item.Label</div>
                            <div class="storage-item-desc">@item.Description</div>
                            <div class="storage-item-meta">
                                <span class="storage-item-count">@StorageCountLabel(item.Key)</span>
                                <span class="storage-item-pct">@StoragePercentOf(item.Bytes).ToString("0.0") %</span>
                            </div>
                            <div class="storage-item-bar">
                                <div class="storage-item-fill" style="width:@Math.Min(StoragePercentOf(item.Bytes), 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </div>
                        <span class="storage-item-size">@FormatSize(item.Bytes)</span>
                        <span class="storage-item-go" aria-hidden="true">ⓘ</span>
                    </div>
                }
            </div>
            <div class="storage-item storage-item-total">
                <div class="storage-item-main">
                    <div class="storage-item-label">@L.T("Total utilisé")</div>
                    <div class="storage-item-desc">@FormatSize(_storageUsedBytes) / @FormatSize(_storageQuotaBytes) · @L.F("{0} % du quota", _storagePercent.ToString("0.000"))</div>
                    <div class="storage-item-bar">
                        <div class="storage-item-fill" style="width:@Math.Min(StorageQuotaPercent(), 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                </div>
                <span class="storage-item-size">@FormatSize(_storageUsedBytes)</span>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-primary" @onclick="() => _showStorage = false">@L.T("Fermer")</button>
        </FooterContent>
    </Modal>

    <Modal Title="@(_storageDetail == null ? L.T("Détail du stockage") : _storageDetail.Label)" Show="_storageDetail != null" OnClose="CloseStorageDetail">
        <ChildContent>
            @if (_storageDetail != null)
            {
                <div class="storage-detail-hero">
                    <span class="storage-detail-icon" aria-hidden="true">@StorageIcon(_storageDetail.Key)</span>
                    <div class="storage-detail-value">@FormatSize(_storageDetail.Bytes)</div>
                    <div class="storage-detail-sub">@StorageCountLabel(_storageDetail.Key) · @L.F("{0} % du stockage utilisé", StoragePercentOf(_storageDetail.Bytes).ToString("0.0"))</div>
                </div>
                <p class="muted">@_storageDetail.Description</p>
                <div class="storage-item-bar storage-detail-bar">
                    <div class="storage-item-fill" style="width:@Math.Min(StoragePercentOf(_storageDetail.Bytes), 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                </div>
                <div class="storage-detail-lines">
                    <div class="storage-line"><span>@L.T("Source")</span><strong>@_storageDetail.Label</strong></div>
                    <div class="storage-line"><span>@L.T("Taille")</span><strong>@FormatSize(_storageDetail.Bytes)</strong></div>
                    <div class="storage-line"><span>@L.T("Éléments")</span><strong>@StorageCountLabel(_storageDetail.Key)</strong></div>
                    <div class="storage-line storage-total"><span>@L.T("Part du total")</span><strong>@StoragePercentOf(_storageDetail.Bytes).ToString("0.0") %</strong></div>
                </div>
            }
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-secondary" @onclick="BackToStorageList">@L.T("← Retour à la liste")</button>
            <button type="button" class="btn btn-primary" @onclick="CloseStorageDetail">@L.T("Fermer")</button>
        </FooterContent>
    </Modal>

    <Modal Title="@(_helpModal == null ? L.T("Aide") : TitreAide(_helpModal))" Show="_helpModal != null" OnClose="() => _helpModal = null">
        <ChildContent>
            @if (_helpModal != null)
            {
                <div class="help-modal">
                    <div class="help-modal-head">
                        <span class="help-modal-icon" aria-hidden="true">@_helpModal.Icon</span>
                        <div>
                            <div class="help-modal-title">@TitreAide(_helpModal)</div>
                            <div class="help-modal-summary">@_helpModal.Summary</div>
                        </div>
                    </div>
                    @foreach (var sec in _helpModal.Sections)
                    {
                        <div class="help-section">
                            <div class="help-section-title">@sec.Title</div>
                            <ul class="help-section-list">
                                @foreach (var point in sec.Points)
                                {
                                    <li>@point</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-primary" @onclick="OpenGuide">@L.T("Ouvrir le guide utilisateur")</button>
            <button type="button" class="btn btn-secondary" @onclick="() => _helpModal = null">@L.T("Fermer")</button>
        </FooterContent>
    </Modal>

</div>


