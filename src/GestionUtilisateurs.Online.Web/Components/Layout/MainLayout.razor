    /// <summary>Badge de notification sur une carte du menu « … » quand quelque chose est à voir.</summary>
    private string MoreBadge(string key)
    {
        try
        {
            var me = Store.GetCurrentUser()?.Identifiant ?? "";
            int n;
            switch (key)
            {
                case "messagerie":
                    n = Store.UnreadCount(me);
                    break;
                case "rappels":
                    n = Store.GetRappels().Count;
                    break;
                case "taches":
                    n = Store.GetTachesForUser(me, true).Count(t => t.Statut != TacheStatuts.Terminee);
                    break;
                case "reunions":
                    var todayR = DateTime.Today.ToString("yyyy-MM-dd");
                    n = Store.Reunions.Count(r => string.Compare(r.Date, todayR, StringComparison.Ordinal) >= 0);
                    break;
                case "votes":
                    n = Store.Votes.Count(v => v.EstOuvert
                        && !v.Bulletins.Any(b => b.VotantIdentifiant.Equals(me, StringComparison.OrdinalIgnoreCase)));
                    break;
                case "finances":
                    n = Store.ImpayesCotisations().Count;
                    break;
                case "situations":
                    n = Store.Situations.Count(s => s.Statut != SituationStatuts.Resolu);
                    break;
                case "materiel":
                    n = Store.Prets.Count(p => string.IsNullOrWhiteSpace(p.DateRetour));
                    break;
                case "documents":
                    n = Store.Documents.Count(d => d.Supprime);
                    break;
                case "comptes":
                    n = Online.Admin.PendingAccounts + Online.Admin.PasswordRequests;
                    break;
                case "capacite":
                    n = Online.Admin.OpenAlerts;
                    break;
                default:
                    return "";
            }
            return n > 0 ? n.ToString() : "";
        }
        catch
        {
            return "";
        }
    }

