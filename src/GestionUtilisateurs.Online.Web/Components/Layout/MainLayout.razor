    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return bytes + " " + L.T("o");
        if (bytes < 1024 * 1024) return (bytes / 1024.0).ToString("0.0") + " " + L.T("Ko");
        if (bytes < 1024L * 1024L * 1024L) return (bytes / (1024.0 * 1024)).ToString("0.0") + " " + L.T("Mo");
        return (bytes / (1024.0 * 1024 * 1024)).ToString("0.0") + " " + L.T("Go");
    }

    private string _storageLevel = "ok";
    private double _storagePercent;
    private string _storageQuotaLabel = "5 Go";
    private string _lastStorageToast = "ok";
    private long _storageUsedBytes;
    private long _storageQuotaBytes = 5120L * 1024L * 1024L;
    private System.Threading.Timer? _renderTimer;

    private void RefreshStorageAlert()
    {
        // Version en ligne : la saturation est suivie côté serveur (page Capacité).
        _storageLevel = "ok";
        _storageUsedBytes = Store.StorageUsedBytes();
        _storageQuotaBytes = Store.CurrentStorageQuotaBytes;
        _storagePercent = _storageQuotaBytes > 0
            ? Math.Min((double)_storageUsedBytes / _storageQuotaBytes * 100.0, 100.0)
            : 0;
        _storageQuotaLabel = FormatSize(_storageQuotaBytes);
        if (_storageLevel != _lastStorageToast)
        {
            if (_storageLevel == "critical")
                State.NotifyError(L.F("Stockage saturé ({0} %) : videz la corbeille et les archives.", _storagePercent.ToString("0")));
            else if (_storageLevel == "warning")
                State.NotifyWarning(L.F("Stockage presque plein ({0} %) : pensez à libérer de l'espace.", _storagePercent.ToString("0")));
            _lastStorageToast = _storageLevel;
        }
    }

    private double StorageQuotaPercent()
    {
        return _storagePercent;
    }

    private double StoragePercentOf(long bytes)
    {
        if (_storageUsedBytes <= 0) return 0;
        return Math.Min((double)bytes / _storageUsedBytes * 100.0, 100.0);
    }

