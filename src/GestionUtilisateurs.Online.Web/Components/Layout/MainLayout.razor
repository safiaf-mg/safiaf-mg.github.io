    /// <summary>Entrées visibles du menu « … » dans l'ordre choisi dans les paramètres (défaut : ordre d'origine, sans les masquées).</summary>
    private List<MoreItem> VisibleMoreItems
    {
        get
        {
            var all = AllMoreItems;
            bool IsShown(MoreItem i) => i.Visible() && !Store.IsMenuHidden(i.Key);
            var order = Store.Settings.MenuOrder;
            if (order == null || order.Count == 0)
                return all.Where(IsShown).ToList();

            var byKey = new Dictionary<string, MoreItem>(StringComparer.Ordinal);
            foreach (var i in all) byKey[i.Key] = i;
            var added = new HashSet<string>(StringComparer.Ordinal);
            var list = new List<MoreItem>();
            foreach (var key in order)
            {
                if (string.IsNullOrWhiteSpace(key) || added.Contains(key)) continue;
                if (byKey.TryGetValue(key, out var item) && IsShown(item))
                {
                    list.Add(item);
                    added.Add(item.Key);
                }
            }
            foreach (var item in all)
            {
                if (IsShown(item) && !added.Contains(item.Key))
                {
                    list.Add(item);
                    added.Add(item.Key);
                }
            }
            return list;
        }
    }

