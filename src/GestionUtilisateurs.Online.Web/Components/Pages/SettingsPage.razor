@inject DataStore Store
@inject AppState State
@inject JavascriptBridge Js
@inject PhotoService Photos
@inject NativeFileSaver Saver
@inject SpreadsheetPicker Picker
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="page-head">
    <p>@L.T("Personnalisez l'application, votre affichage et les données de la communauté.")</p>
</div>

@{
    var self = Store.GetCurrentUser();
}
@if (self != null)
{
    <div class="settings-section-label">@L.T("Compte connecté")</div>
    <div class="card settings-user-card settings-card settings-card-account" role="button" tabindex="0" @onclick="GoProfile" @onkeydown="OnAccountKeyDown">
        <span class="card-corner" aria-hidden="true"></span>
        <Avatar UserName="@self.NomComplet" Seed="@self.Identifiant" Size="lg" Photo="@self.Photo" />
        <div class="settings-user-main">
            <div class="user-card-name">@self.NomComplet</div>
            <div class="user-card-sub">@@@self.Identifiant</div>
            <Badge Text="@L.T(self.Role)" Kind="role" />
            <Badge Text="@L.T(self.Statut)" Kind="@(self.Actif ? "active" : "inactive")" />
        </div>
    </div>
}

<div class="card settings-card settings-card-appearance @(IsCollapsed("appearance") ? "collapsed" : "")">
    <span class="card-corner" aria-hidden="true"></span>
    <div class="settings-card-head">
        <span class="settings-deco settings-deco-appearance" aria-hidden="true">🎨</span>
        <h3>@L.T("Apparence")</h3>
        <button type="button" class="section-toggle" aria-label="@L.T("Réduire ou agrandir la section Apparence")" aria-expanded="@(!IsCollapsed("appearance"))" @onclick='() => ToggleSection("appearance")'>@(IsCollapsed("appearance") ? "▸" : "▾")</button>
    </div>
    <div class="form-group">
        <label for="st-appname">@L.T("Nom de l'application")</label>
        <input id="st-appname" type="text" value="@_name" disabled="@(!Store.IsAdmin)"
               @oninput="e => _name = e.Value?.ToString() ?? string.Empty" />
        @if (!Store.IsAdmin)
        {
            <span class="field-hint">@L.T("Réservé à l'administrateur.")</span>
        }
    </div>
    @if (Store.IsAdmin)
    {
        <div class="form-group">
            <label>@L.T("Logo de l'application")</label>
            <div class="photo-control">
                <button type="button" class="logo-btn" aria-label="@L.T("Voir le logo en grand")" @onclick="() => _logoPreview = true">
                    <img class="settings-logo-preview" src="@Root.LogoOuDefaut(_logo)" alt="@L.T("Logo de l'application")" />
                </button>
                <div class="photo-actions">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CaptureLogo">@L.T("📷 Prendre une photo")</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="PickLogo">@L.T("🖼 Choisir une image")</button>
                    @if (!string.IsNullOrWhiteSpace(_logo))
                    {
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _logo = string.Empty">@L.T("Retirer")</button>
                    }
                </div>
            </div>
            <span class="field-hint">@(string.IsNullOrWhiteSpace(_logo) ? L.T("Logo par défaut du site. Touchez le logo pour l'agrandir.") : L.T("Touchez le logo pour l'agrandir."))</span>
        </div>
        <div class="form-group">
            <label>@L.T("Couleur d'accent")</label>
            <div class="color-swatches">
                @foreach (var (c, nom) in CouleursAccent.Toutes)
                {
                    <button type="button" class="color-swatch @(string.Equals(c, _color, StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                            style="background:@c" title="@L.T(nom)" aria-label="@L.T(nom)" @onclick="() => SelectAccentAsync(c)"></button>
                }
                <label class="color-swatch color-custom" title="@L.T("Autre couleur")">
                    <input type="color" value="@_color" aria-label="@L.T("Choisir une autre couleur")" @onchange="e => SelectAccentAsync(e.Value?.ToString() ?? _color)" />
                </label>
            </div>
        </div>
    }
    <div class="form-group">
        <label>@L.T("Ma langue (personnelle)")</label>
        <LanguePicker />
        <span class="field-hint">@L.T("Votre choix uniquement : chaque membre choisit sa langue.")</span>
    </div>
    <div class="form-group">
        <label for="st-theme-perso">@L.T("Mon thème (personnel)")</label>
        <select id="st-theme-perso" value="@_theme" @onchange="OnPersonalThemeChanged">
            <option value="light">@L.T("Clair")</option>
            <option value="dark">@L.T("Sombre")</option>
        </select>
        <span class="field-hint">@L.T("Votre choix uniquement : il ne change pas le thème des autres membres. Clair par défaut.")</span>
    </div>
    <div class="appearance-preview @(_theme == "dark" ? "preview-dark" : "preview-light")" style="--preview-accent:@_color">
        <span class="appearance-preview-dot"></span>
        <div><strong>@L.T("Aperçu instantané")</strong><span>@L.F("Thème {0} · couleur d'accent", _theme)</span></div>
        <button type="button" class="appearance-preview-button">@L.T("Bouton")</button>
    </div>
    @if (Store.IsAdmin)
    {
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SaveAppearance" disabled="@_saving">@L.T("Enregistrer")</button>
        </div>
    }
</div>

@if (GereParametres)
{
<div class="card settings-card settings-card-menu @(IsCollapsed("menu") ? "collapsed" : "")">
    <span class="card-corner" aria-hidden="true"></span>
    <div class="settings-card-head">
        <span class="settings-deco settings-deco-menu" aria-hidden="true">☰</span>
        <h3>@L.T("Ordre du menu")</h3>
        <button type="button" class="section-toggle" aria-label="@L.T("Réduire ou agrandir la section Ordre du menu")" aria-expanded="@(!IsCollapsed("menu"))" @onclick='() => ToggleSection("menu")'>@(IsCollapsed("menu") ? "▸" : "▾")</button>
    </div>
    <p class="muted">@L.T("Glissez-déposez la poignée") <span aria-hidden="true">⋮⋮</span> @L.T("pour réordonner les entrées du menu « ⋮ » (souris, tactile, stylet). Les boutons ▲ ▼ restent disponibles. Touchez 👁 / 🙈 pour masquer ou ré-afficher une entrée. Seules vos entrées accessibles sont listées.")</p>
    @{
        var menuDefs = new Dictionary<string, AppMenus.MenuDef>();
        foreach (var d in AppMenus.All) menuDefs[d.Key] = d;
        var visibleMenu = _menuOrder.Where(k => menuDefs.ContainsKey(k) && MenuVisible(k)).ToList();
    }
    <div class="menu-order-list" id="menu-order-list" @ref="_menuOrderListRef">
        @for (var i = 0; i < visibleMenu.Count; i++)
        {
            var def = menuDefs[visibleMenu[i]];
            var idx = i;
            var key = visibleMenu[i];
            var hidden = IsMenuHidden(key);
            var hideLabel = hidden ? L.F("Afficher {0}", MenuLabel(def)) : L.F("Masquer {0}", MenuLabel(def));
            var hideTitle = hidden ? L.T("Afficher") : L.T("Masquer");
            var hideIcon = hidden ? "🙈" : "👁";
            <div class="menu-order-item @(hidden ? "menu-hidden" : "")" data-rkey="@key" style="@(hidden ? "opacity:.55" : "")">
                <span class="reorder-handle" aria-hidden="true" title="@L.T("Glisser pour réordonner")">⋮⋮</span>
                <span class="menu-order-icon" aria-hidden="true">@def.Icon</span>
                <span class="menu-order-label">@MenuLabel(def) @(hidden ? L.T("(masqué)") : "")</span>
                <div class="menu-order-actions">
                    <button type="button" class="btn btn-secondary btn-sm menu-order-btn" disabled="@(idx == 0)" aria-label="@L.F("Monter {0}", MenuLabel(def))" @onclick="() => MoveMenuVisible(idx, -1)">▲</button>
                    <button type="button" class="btn btn-secondary btn-sm menu-order-btn" disabled="@(idx >= visibleMenu.Count - 1)" aria-label="@L.F("Descendre {0}", MenuLabel(def))" @onclick="() => MoveMenuVisible(idx, 1)">▼</button>
                    <button type="button" class="btn btn-secondary btn-sm menu-order-btn" aria-label="@hideLabel" title="@hideTitle" @onclick="() => ToggleMenuHidden(key)">@hideIcon</button>
                </div>
            </div>
        }
    </div>
    <div class="form-actions">
        <button type="button" class="btn btn-secondary" @onclick="ResetMenuOrder">@L.T("↺ Réinitialiser l'ordre d'origine")</button>
    </div>
</div>
}

@if (GereParametres)
{
<div class="card settings-card settings-card-listes @(IsCollapsed("listes") ? "collapsed" : "")">
    <span class="card-corner" aria-hidden="true"></span>
    <div class="settings-card-head">
        <span class="settings-deco settings-deco-listes" aria-hidden="true">📋</span>
        <h3>@L.T("Listes de choix")</h3>
        <button type="button" class="section-toggle" aria-label="@L.T("Réduire ou agrandir la section Listes de choix")" aria-expanded="@(!IsCollapsed("listes"))" @onclick='() => ToggleSection("listes")'>@(IsCollapsed("listes") ? "▸" : "▾")</button>
    </div>
    <p class="muted">@L.T("Les choix proposés dans les formulaires : types, liens de famille, priorités, catégories, états, statuts. Ajoutez, renommez, réordonnez, masquez ou supprimez-les vous-même.")</p>
    <div class="listes-choix">
        @foreach (var def in ListesChoix.Definitions)
        {
            var liste = def.Id;
            <button type="button" class="listes-choix-item" data-liste="@liste" @onclick="() => _listeOuverte = liste">
                <span class="listes-choix-titre">@L.T(def.Titre)</span>
                <span class="listes-choix-module">@L.T(def.Module) · @L.F("{0} choix", Store.Liste(liste).Count(e => !e.Masque))</span>
                <span class="listes-choix-go" aria-hidden="true">›</span>
            </button>
        }
    </div>
</div>
<ListesChoixEditor Show="_listeOuverte != null" ListeId="@_listeOuverte" OnClose="() => _listeOuverte = null" />
}

<div class="card settings-card settings-card-guide @(IsCollapsed("guide") ? "collapsed" : "")">
    <span class="card-corner" aria-hidden="true"></span>
    <div class="settings-card-head">
        <span class="settings-deco settings-deco-guide" aria-hidden="true">🧭</span>
        <h3>@L.T("Guide et aide")</h3>
        <button type="button" class="section-toggle" aria-label="@L.T("Réduire ou agrandir la section Guide et aide")" aria-expanded="@(!IsCollapsed("guide"))" @onclick='() => ToggleSection("guide")'>@(IsCollapsed("guide") ? "▸" : "▾")</button>
    </div>
    <div class="form-actions" style="gap:10px">
        <button type="button" class="btn btn-primary" @onclick="OpenGuide">@L.T("📖 Ouvrir le guide utilisateur")</button>
        <button type="button" class="btn btn-secondary" @onclick="ReplayTour">@L.T("▶ Revoir le mini-guide de démarrage")</button>
    </div>
    <div class="form-group" style="margin-top:12px">
        <label class="form-check" for="st-aides-contextuelles">
            <input id="st-aides-contextuelles" type="checkbox" checked="@ConseilsActifs"
                   @onchange="ToggleContextualHelp" />
            @L.T("Afficher un conseil la première fois que j'ouvre une fonctionnalité")
        </label>
        <span class="field-hint">@L.T("Votre choix personnel : il ne change pas celui des autres utilisateurs. Le bouton « ⓘ » reste disponible en haut de chaque écran.")</span>
    </div>
</div>

@if (Store.IsAdmin)
{
    <div class="card settings-card settings-card-cardemembre @(IsCollapsed("cartemembre") ? "collapsed" : "")">
        <span class="card-corner" aria-hidden="true"></span>
        <div class="settings-card-head">
            <span class="settings-deco settings-deco-cardemembre" aria-hidden="true">🪪</span>
            <h3>@L.T("Configuration carte de membre")</h3>
            <button type="button" class="section-toggle" aria-label="@L.T("Réduire ou agrandir la section Carte de membre")" aria-expanded="@(!IsCollapsed("cartemembre"))" @onclick='() => ToggleSection("cartemembre")'>@(IsCollapsed("cartemembre") ? "▸" : "▾")</button>
        </div>
        <div class="form-group">
            <label for="st-carte-slogan">@L.T("Slogan de la carte de membre")</label>
            <input id="st-carte-slogan" type="text" value="@_carteSlogan" maxlength="80"
                   placeholder="@L.T("Votre communauté, notre force")"
                   @oninput="e => _carteSlogan = e.Value?.ToString() ?? string.Empty" />
            <span class="field-hint">@L.T("Affiché en face avant de la carte de membre.")</span>
        </div>
        <div class="form-group">
            <label for="st-carte-citation">@L.T("Citation de la carte de membre")</label>
            <textarea id="st-carte-citation" rows="2" maxlength="180"
                      placeholder="@L.T("Ensemble, nous allons plus loin.")"
                      value="@_carteCitation"
                      @oninput="e => _carteCitation = e.Value?.ToString() ?? string.Empty"></textarea>
            <span class="field-hint">@L.T("Affichée au dos de la carte de membre.")</span>
        </div>
        <div class="form-group">
            <label for="st-carte-largeur">@L.T("Taille réelle à l'impression (mm)")</label>
            <div class="quota-input-row">
                <input id="st-carte-largeur" type="number" min="50" max="150" value="@_carteLargeurMm"
                       @oninput="e => _carteLargeurMm = int.TryParse(e.Value?.ToString(), out var w) ? w : 85"
                       aria-label="@L.T("Largeur de la carte en millimètres")" style="max-width:90px" />
                <span class="quota-input-unit">×</span>
                <input id="st-carte-hauteur" type="number" min="30" max="100" value="@_carteHauteurMm"
                       @oninput="e => _carteHauteurMm = int.TryParse(e.Value?.ToString(), out var h) ? h : 55"
                       aria-label="@L.T("Hauteur de la carte en millimètres")" style="max-width:90px" />
                <span class="quota-input-unit">mm</span>
            </div>
            <span class="field-hint">@L.T("Format standard : 85 × 55 mm. Appliqué au PDF et à l'impression.")</span>
        </div>
        <div class="form-group">
            <label for="st-matricule">@L.T("Format du matricule")</label>
            <input id="st-matricule" type="text" value="@_matriculeFormat" maxlength="30"
                   placeholder="@L.T("Ex : M-{NNNN}")"
                   @oninput="e => _matriculeFormat = e.Value?.ToString() ?? string.Empty" />
            <span class="field-hint">@L.T("Codes : {NNNN} numéro (un N par chiffre), {AAAA} ou {AA} année d'adhésion, {MM} mois, {INI} initiales. Laissez vide pour saisir les matricules à la main.")</span>
            @if (DataStore.ValiderFormatMatricule(_matriculeFormat) is { } errFormat)
            {
                <span class="form-error">@errFormat</span>
            }
            else if (!string.IsNullOrWhiteSpace(_matriculeFormat))
            {
                <span class="field-hint">@L.T("Prochain matricule :") <strong>@Store.ApercuMatricule(_matriculeFormat)</strong></span>
            }
            @if (_sansMatricule > 0 && !string.IsNullOrWhiteSpace(Store.Settings.MatriculeFormat) && Store.Can(Permissions.UsersManage))
            {
                <button type="button" class="btn btn-secondary btn-sm" style="align-self:flex-start;margin-top:6px" @onclick="AttribuerMatricules">@L.F("Attribuer un matricule aux {0} fiche(s) sans matricule", _sansMatricule)</button>
            }
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SaveAppearance" disabled="@_saving">@L.T("Enregistrer")</button>
        </div>
    </div>
}

@if (GereParametres)
{
    <div class="card settings-card settings-card-pagesize @(IsCollapsed("pagesize") ? "collapsed" : "")">
        <span class="card-corner" aria-hidden="true"></span>
        <div class="settings-card-head">
            <span class="settings-deco settings-deco-pagesize" aria-hidden="true">📄</span>
            <h3>@L.T("Nombre d'utilisateurs par page")</h3>
            <button type="button" class="section-toggle" aria-label="@L.T("Réduire ou agrandir la section")" aria-expanded="@(!IsCollapsed("pagesize"))" @onclick='() => ToggleSection("pagesize")'>@(IsCollapsed("pagesize") ? "▸" : "▾")</button>
        </div>
        <div class="form-group">
            <label for="st-pagesize">@L.T("Affichage de la liste des utilisateurs")</label>
            <select id="st-pagesize" value="@_pageSize" @onchange="e => _pageSize = int.TryParse(e.Value?.ToString(), out var p) ? Math.Clamp(p, 10, 100) : 10">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>

    <div class="card settings-card settings-card-security @(IsCollapsed("security") ? "collapsed" : "")">
        <span class="card-corner" aria-hidden="true"></span>
        <div class="settings-card-head">
            <span class="settings-deco settings-deco-security" aria-hidden="true">🔒</span>
            <h3>@L.T("Sécurité")</h3>
            <button type="button" class="section-toggle" aria-label="@L.T("Réduire ou agrandir la section Sécurité")" aria-expanded="@(!IsCollapsed("security"))" @onclick='() => ToggleSection("security")'>@(IsCollapsed("security") ? "▸" : "▾")</button>
        </div>
        <div class="form-group">
            <label for="st-session">@L.T("Déconnexion automatique après inactivité")</label>
            <select id="st-session" value="@_sessionTimeout" @onchange="OnSessionTimeoutChanged">
                <option value="5">@L.T("5 minutes")</option>
                <option value="15">@L.T("15 minutes")</option>
                <option value="30">@L.T("30 minutes")</option>
                <option value="60">@L.T("1 heure")</option>
                <option value="120">@L.T("2 heures")</option>
                <option value="0">@L.T("Jamais")</option>
            </select>
            <span class="field-hint">@L.T("Seule l'inactivité prolongée déconnecte. Ouvrir une autre application ne déconnecte pas.")</span>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SaveAppearance" disabled="@_saving">@L.T("Enregistrer")</button>
        </div>
    </div>
}

@if (Store.PeutOuvrir("fields"))
{
    <div class="card settings-card settings-card-fields @(IsCollapsed("fields") ? "collapsed" : "")">
        <span class="card-corner" aria-hidden="true"></span>
        <div class="settings-card-head">
            <span class="settings-deco settings-deco-fields" aria-hidden="true">🧩</span>
            <h3>@L.T("Champs personnalisés")</h3>
            <button type="button" class="section-toggle" aria-label="@L.T("Réduire ou agrandir la section Champs")" aria-expanded="@(!IsCollapsed("fields"))" @onclick='() => ToggleSection("fields")'>@(IsCollapsed("fields") ? "▸" : "▾")</button>
        </div>
        <p class="muted">@L.T("Personnalisez le formulaire utilisateur : texte, nombre, liste, choix, pièce jointe, image…")</p>
        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="GoFields">@L.T("🧩 Gérer les champs")</button>
        </div>
    </div>
}

@if (Store.Can(Permissions.ExportData) || Store.Can(Permissions.ImportData))
{
    <div class="card settings-card settings-card-actions @(IsCollapsed("actions") ? "collapsed" : "")">
        <span class="card-corner" aria-hidden="true"></span>
        <div class="settings-card-head">
            <span class="settings-deco settings-deco-actions" aria-hidden="true">⇄</span>
            <h3>@L.T("Actions")</h3>
            <button type="button" class="section-toggle" aria-label="@L.T("Réduire ou agrandir la section Actions")" aria-expanded="@(!IsCollapsed("actions"))" @onclick='() => ToggleSection("actions")'>@(IsCollapsed("actions") ? "▸" : "▾")</button>
        </div>
        <p class="muted">@L.T("L'export et l'import suivent les droits « Exporter les données » et « Importer des données » de Rôles et permissions.")</p>
        @if (Store.OnlineMode)
        {
            <p class="field-hint">@L.T("Les données sont sauvegardées automatiquement sur le serveur chaque semaine. L'export Excel ci-dessous reste disponible à tout moment.")</p>
        }
        else
        {
        <div class="form-group">
            <label class="form-check" for="st-autoexport">
                <input id="st-autoexport" type="checkbox" checked="@_autoExport" @onchange="OnAutoExportChanged" />
                @L.T("Export automatique mensuel de toutes les données")
            </label>
            <span class="field-hint">@L.F("Chaque mois, la sauvegarde complète (JSON) + la liste des utilisateurs (Excel) sont enregistrées dans Téléchargements. Dernier export : {0}.", LastAutoExportLabel)</span>
        </div>
        }
        <div class="form-actions">
            @if (Store.Can(Permissions.ExportData))
            {
                <button class="btn btn-secondary" @onclick="ExportExcel">@L.T("⇩ Exporter Excel")</button>
            }
            @if (Store.Can(Permissions.ImportData) && Store.Can(Permissions.UsersManage))
            {
                <button class="btn btn-secondary" @onclick="OpenRestore">@L.T("⇪ Importer Excel")</button>
            }
            @if (Store.Can(Permissions.ExportData))
            {
                <button class="btn btn-secondary" @onclick="ExportNowAsync" disabled="@_exporting">@(_exporting ? L.T("Export…") : L.T("⤓ Exporter maintenant"))</button>
            }
        </div>
    </div>
}

@* La zone dangereuse (réinitialisation des données) n'existe pas en ligne : elle
   effacerait les données partagées de tous les membres et désactiverait leurs comptes. *@

<div class="card logout-card">
    <button class="btn btn-danger-outline btn-block" @onclick="AskLogout">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        @L.T("Se déconnecter")
    </button>
</div>

<Modal Title="@L.T("Importer Excel")" Show="_showRestore" OnClose="() => _showRestore = false">
    <ChildContent>
        <p class="muted" style="margin-top:0">@L.T("Choisissez un fichier") <strong>.xlsx</strong> @L.T("exporté par l'application. Les utilisateurs absents sont ajoutés, les identifiants existants sont conservés.")</p>
        <div class="import-format">
            <div class="import-format-title">@L.T("📋 Format attendu du fichier")</div>
            <ul class="import-format-list">
                <li><strong>@L.T("Classeur Excel (.xlsx)")</strong> @L.T("— 1ère ligne = en-têtes.")</li>
                <li><strong>@L.T("Colonnes :")</strong> @L.T("Nom*, Prénom*, Identifiant, Email, Téléphone (+261…), Rôle (Administrateur / Gestionnaire / Utilisateur), Statut (Actif / Inactif), Date de création (JJ/MM/AAAA), Dernière connexion, Notes + champs personnalisés.")</li>
                <li><strong>@L.T("Dates :")</strong> @L.T("JJ/MM/AAAA (ex. 05/09/2026).")</li>
                <li><strong>@L.T("Exemple :")</strong> NOM | Prénom | prenom.nom | mail@domaine.fr | +261321234567 | Utilisateur | Actif | 05/09/2026 | …</li>
                <li>@L.T("Astuce : exportez d'abord avec « Exporter Excel » pour obtenir un modèle valide.")</li>
            </ul>
        </div>
        <div class="form-actions" style="margin:4px 0 8px">
            <button class="btn btn-secondary" @onclick="PickRestore">@L.T("📂 Choisir un fichier Excel")</button>
        </div>
        @if (_pendingImport != null)
        {
            <p class="muted">@L.F("{0} utilisateur(s) détecté(s), {1} déjà présent(s).", _pendingImport.Count, _pendingImport.Count(u => Store.FindUserByIdentifier(u.Identifiant) != null))</p>
        }
        <span class="form-error">@_restoreError</span>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _showRestore = false">@L.T("Annuler")</button>
        <button class="btn btn-primary" disabled="@(_pendingImport == null || (_pendingImport != null && _pendingImport.All(u => Store.FindUserByIdentifier(u.Identifiant) != null)))" @onclick="ApplyRestore">@L.T("Ajouter les nouveaux utilisateurs")</button>
    </FooterContent>
</Modal>

<ConfirmDialog Show="_confirmLogout" Title="@L.T("Déconnexion")"
               Message="@L.T("Voulez-vous vraiment vous déconnecter ?")"
               ConfirmLabel="@L.T("Se déconnecter")" Danger="true" OnConfirm="ConfirmLogout" OnCancel="() => _confirmLogout = false" />

<Modal Title="" Show="_logoPreview" OnClose="() => _logoPreview = false">
    <ChildContent>
        <div class="logo-preview-wrap">
            <img class="logo-preview-img" src="@Root.LogoOuDefaut(_logo)" alt="" />
        </div>
    </ChildContent>
</Modal>

@code {
    /// <summary>Liste de choix ouverte dans l'éditeur (null : aucune).</summary>
    private string? _listeOuverte;

    /// <summary>Nom affiché d'une entrée du menu (l'histoire porte le nom de l'application).</summary>
    private string MenuLabel(AppMenus.MenuDef def) => def.Key == "community" ? Store.LibelleHistoire() : L.T(def.Label);


    private string _name = "Gestion des utilisateurs";    private string _theme = "light";
    private string _color = "#4f46e5";
    private int _pageSize = 10;
    private int _sessionTimeout = 30;
    private int _storageQuotaMb = 5120;
    private bool _quotaDirty;
    private List<string> _menuOrder = new();
    private HashSet<string> _menuHidden = new(StringComparer.Ordinal);
    private string _logo = "";
    private string _carteSlogan = "";
    private string _carteCitation = "";
    private string _matriculeFormat = "";
    private int _sansMatricule => Store.Users.Count(u => string.IsNullOrWhiteSpace(u.Matricule));

    private void AttribuerMatricules()
    {
        var (res, n) = Store.AttribuerMatriculesManquants();
        if (res.Success) State.NotifySuccess(L.F("{0} matricule(s) attribué(s).", n));
        else State.NotifyError(res.Error);
    }
    private int _carteLargeurMm = 85;
    private int _carteHauteurMm = 55;
    private bool _saving;
    private bool _confirmLogout;
    private bool _logoPreview;
    private bool _autoExport = true;
    private bool _exporting;

    private string LastAutoExportLabel =>
        string.IsNullOrWhiteSpace(Store.Settings.DernierExportAuto) ? L.T("jamais") : Store.Settings.DernierExportAuto;

    private void OnAutoExportChanged(ChangeEventArgs e)
    {
        _autoExport = e.Value is bool b ? b : !(_autoExport);
    }

    private void OnQuotaInput(ChangeEventArgs e)
    {
        // Saisie libre : la valeur tapée est conservée telle quelle (plafond
        // appliqué uniquement à l'enregistrement). Sans le drapeau _quotaDirty,
        // chaque ré-affichage réécrasait la saisie par la valeur enregistrée.
        _quotaDirty = true;
        _storageQuotaMb = int.TryParse(e.Value?.ToString(), out var q) ? Math.Max(0, q) : 5120;
    }

    /// <summary>
    /// Plafond du champ quota : la place libre réelle de l'appareil (en Mo).
    /// Le champ reste libre en dessous de ce plafond ; la valeur enregistrée
    /// n'est jamais réduite automatiquement (seule la saisie est bornée).
    /// </summary>
    private static int QuotaMaxMb
    {
        get
        {
            var freeMb = DeviceStorage.GetFreeBytes() / (1024L * 1024L);
            if (freeMb <= 0) return 10240; // espace inconnu : plafond large, sans bloquer.
            if (freeMb < DataStore.StorageQuotaMbMin) return DataStore.StorageQuotaMbMin;
            return freeMb > int.MaxValue ? int.MaxValue : (int)freeMb;
        }
    }

    private string FreeSpaceLabel => StorageSettingsFormat(DeviceStorage.GetFreeBytes());

    // Sections minimisables, repliées par défaut (mémoire de session uniquement).
    private readonly HashSet<string> _collapsed = new(
        new[] { "appearance", "menu", "listes", "guide", "cartemembre", "pagesize", "storage", "security", "fields", "actions" },
        StringComparer.Ordinal);

    private bool IsCollapsed(string key) => _collapsed.Contains(key);

    private void ToggleSection(string key)
    {
        if (!_collapsed.Add(key)) _collapsed.Remove(key);
    }

    private string StorageUsageLabel =>
        StorageSettingsFormat(Store.StorageUsedBytes()) + " utilisés / " + StorageSettingsFormat(Store.CurrentStorageQuotaBytes);

    private static string StorageSettingsFormat(long bytes)
    {
        if (bytes < 1024) return bytes + " o";
        if (bytes < 1024 * 1024) return (bytes / 1024.0).ToString("0.0") + " Ko";
        if (bytes < 1024L * 1024L * 1024L) return (bytes / (1024.0 * 1024)).ToString("0.0") + " Mo";
        return (bytes / (1024.0 * 1024 * 1024)).ToString("0.0") + " Go";
    }

    private void MoveMenu(int index, int delta)
    {
        if (index < 0 || index >= _menuOrder.Count) return;
        var target = index + delta;
        if (target < 0 || target >= _menuOrder.Count) return;
        (_menuOrder[target], _menuOrder[index]) = (_menuOrder[index], _menuOrder[target]);
        Store.ReorderMenu(_menuOrder);
    }

    /// <summary>Entrée visible pour le compte connecté (mêmes règles que le menu « … ») ?</summary>
    /// <summary>Réglages communs (menu, listes, pagination) : gestionnaires ayant le droit « Gérer les paramètres ».</summary>
    private bool GereParametres => Store.IsManager && Store.Can(Permissions.SettingsManage);

    private bool MenuVisible(string key) => key == "data" ? Store.PeutOuvrir("data") && !Store.IsBaseAdmin : Store.PeutOuvrir(key);

    /// <summary>Déplace une entrée dans l'ordre visible (les entrées masquées gardent leur place).</summary>
    private void MoveMenuVisible(int visibleIndex, int delta)
    {
        var visible = _menuOrder.Where(MenuVisible).ToList();
        var target = visibleIndex + delta;
        if (visibleIndex < 0 || visibleIndex >= visible.Count || target < 0 || target >= visible.Count) return;
        var a = _menuOrder.IndexOf(visible[visibleIndex]);
        var b = _menuOrder.IndexOf(visible[target]);
        if (a < 0 || b < 0) return;
        (_menuOrder[a], _menuOrder[b]) = (_menuOrder[b], _menuOrder[a]);
        Store.ReorderMenu(_menuOrder);
    }

    private bool IsMenuHidden(string key)
        => _menuHidden.Contains(key);

    private void ToggleMenuHidden(string key)
    {
        var hidden = !_menuHidden.Contains(key);
        if (hidden) _menuHidden.Add(key);
        else _menuHidden.Remove(key);
        Store.SetMenuHidden(key, hidden);
        StateHasChanged();
    }

    private void ResetMenuOrder()
    {
        _menuOrder = AppMenus.All.Select(m => m.Key).ToList();
        _menuHidden.Clear();
        Store.ResetMenu();
        Store.ReorderMenu(_menuOrder);
    }

    private ElementReference _menuOrderListRef;
    private DotNetObjectReference<SettingsPage>? _reorderRef;
    private bool _reorderEnabled;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_reorderEnabled)
        {
            _reorderEnabled = true;
            try
            {
                _reorderRef ??= DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("guDragReorder.enable", "menu-order-list", _reorderRef, nameof(OnMenuReordered));
            }
            catch { }
        }
    }

    /// <summary>Ordre final après un glisser-déposer : fusionne l'ordre visible
    /// reçu dans _menuOrder en conservant la place exacte des entrées masquées
    /// (autres rôles), puis persiste via ReorderMenu.</summary>
    [JSInvokable]
    public void OnMenuReordered(string[] keys)
    {
        try
        {
            if (keys == null || keys.Length == 0) return;
            var wanted = keys.Where(k => !string.IsNullOrWhiteSpace(k)).ToList();
            if (wanted.Count == 0) return;
            var wantedSet = new HashSet<string>(wanted, StringComparer.Ordinal);
            var slots = new List<int>();
            for (var i = 0; i < _menuOrder.Count; i++)
                if (wantedSet.Contains(_menuOrder[i])) slots.Add(i);
            var n = Math.Min(slots.Count, wanted.Count);
            for (var s = 0; s < n; s++) _menuOrder[slots[s]] = wanted[s];
            // Clés inconnues (nouveau module) : ajoutées à la fin.
            foreach (var k in wanted)
                if (!_menuOrder.Contains(k)) _menuOrder.Add(k);
            Store.ReorderMenu(_menuOrder);
        }
        catch { }
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        try { _ = JSRuntime.InvokeVoidAsync("guDragReorder.disable", "menu-order-list"); } catch { }
        try { _reorderRef?.Dispose(); } catch { }
    }

    private void OpenGuide()
    {
        State.Navigate("guide");
    }

    private void ReplayTour()
    {
        if (Store.IsBaseAdmin) return;
        State.RequestTour();
    }

    private void ToggleContextualHelp(ChangeEventArgs e)
    {
        // Choix individuel : n'affecte que le compte connecté.
        var on = e.Value is bool b ? b : e.Value?.ToString() == "true";
        var me = Store.GetCurrentUser()?.Identifiant ?? "";
        if (string.IsNullOrEmpty(me)) return;
        Store.SetUserConseils(me, on);
    }

    private bool ConseilsActifs => Store.GetEffectiveConseils(Store.GetCurrentUser()?.Identifiant);

    private bool _showRestore;
    private string _restoreError = "";
    private List<UserAccount>? _pendingImport;

    protected override void OnParametersSet()
    {
        var s = Store.Settings;
        _name = s.AppName;
        // Thème affiché : choix individuel, sinon thème global.
        _theme = Store.GetEffectiveTheme(Store.GetCurrentUser()?.Identifiant);
        _color = s.Color;
        _pageSize = s.PageSize;
        _logo = s.Logo;
        _carteSlogan = s.CarteSlogan;
        _carteCitation = s.CarteCitation;
        _matriculeFormat = s.MatriculeFormat ?? "";
        _carteLargeurMm = s.CarteLargeurMm > 0 ? s.CarteLargeurMm : 85;
        _carteHauteurMm = s.CarteHauteurMm > 0 ? s.CarteHauteurMm : 55;
        _sessionTimeout = s.SessionTimeoutMinutes;
        _autoExport = s.ExportAutoMensuel;
        _storageQuotaMb = _quotaDirty ? _storageQuotaMb
            : (s.StorageQuotaMb > 0 ? s.StorageQuotaMb : 5120);
        _menuOrder = new List<string>(s.MenuOrder ?? new List<string>());
        foreach (var def in AppMenus.All)
            if (!_menuOrder.Contains(def.Key)) _menuOrder.Add(def.Key);
        _menuOrder.RemoveAll(k => !AppMenus.All.Any(m => m.Key == k));
        _menuHidden = new HashSet<string>(s.MenuHidden ?? new List<string>(), StringComparer.Ordinal);
    }

    private void AskLogout() => _confirmLogout = true;

    private void ConfirmLogout()
    {
        _confirmLogout = false;
        State.ResetNavigation();
        Store.Logout();
    }

    private void OnThemeChanged(ChangeEventArgs e)
    {
        _theme = e.Value?.ToString() ?? "light";
    }

    /// <summary>Thème individuel : appliqué aussitôt, sans toucher aux autres comptes.</summary>
    private async Task OnPersonalThemeChanged(ChangeEventArgs e)
    {
        _theme = e.Value?.ToString() ?? "light";
        var me = Store.GetCurrentUser()?.Identifiant ?? "";
        if (string.IsNullOrEmpty(me)) return;
        Store.SetUserTheme(me, _theme);
        try
        {
            var s = Store.Settings;
            await Js.ApplySettingsAsync(new AppSettings
            {
                AppName = s.AppName,
                Theme = _theme,
                Color = s.Color,
                Logo = s.Logo
            });
        }
        catch { }
    }

    private void OnSessionTimeoutChanged(ChangeEventArgs e)
    {
        _sessionTimeout = int.TryParse(e.Value?.ToString(), out var m) ? Math.Max(m, 0) : 30;
    }

    private void SelectAccentAsync(string color)
    {
        _color = color;
    }

    private async Task PickLogo()
    {
        var data = await Photos.PickPhotoAsync();
        if (data != null) _logo = data;
        else if (!string.IsNullOrEmpty(Photos.LastError)) State.NotifyError(Photos.LastError);
    }

    private async Task CaptureLogo()
    {
        var data = await Photos.CapturePhotoAsync();
        if (data != null) _logo = data;
        else if (!string.IsNullOrEmpty(Photos.LastError)) State.NotifyError(Photos.LastError);
    }

    private void GoProfile() => State.Navigate("profile");

    private void GoFields() => State.Navigate("fields");

    private void OnAccountKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") GoProfile();
    }

    private async Task SaveAppearance()
    {
        if (DataStore.ValiderFormatMatricule(_matriculeFormat) is { } errFormat)
        {
            State.NotifyError(errFormat);
            return;
        }
        _saving = true;
        try
        {
            // Préserve les choix individuels (guide vu, aides vues, conseil contextuel) :
            // l'enregistrement par un utilisateur n'écrase jamais ceux des autres.
            var prev = Store.Settings;
            Store.SaveSettings(new AppSettings
            {
                AppName = string.IsNullOrWhiteSpace(_name) ? "Gestion des utilisateurs" : _name.Trim(),
                Theme = _theme,
                Color = _color,
                PageSize = _pageSize,
                Logo = _logo,
                CarteSlogan = _carteSlogan.Trim(),
                CarteCitation = _carteCitation.Trim(),
                MatriculeFormat = _matriculeFormat.Trim(),
                CarteLargeurMm = Math.Clamp(_carteLargeurMm, 50, 150),
                CarteHauteurMm = Math.Clamp(_carteHauteurMm, 30, 100),
                SessionTimeoutMinutes = _sessionTimeout,
                ExportAutoMensuel = _autoExport,
                DernierExportAuto = prev.DernierExportAuto,
                Listes = prev.Listes,
                StorageQuotaMb = Math.Clamp(_storageQuotaMb, DataStore.StorageQuotaMbMin, QuotaMaxMb),
                MenuOrder = new List<string>(_menuOrder),
                MenuHidden = new List<string>(_menuHidden),
                AidesContextuelles = prev.AidesContextuelles,
                GuideVu = new List<string>(prev.GuideVu ?? new List<string>()),
                AideVu = new List<string>(prev.AideVu ?? new List<string>()),
                ThemesUtilisateurs = new Dictionary<string, string>(prev.ThemesUtilisateurs ?? new Dictionary<string, string>()),
                ConseilsUtilisateurs = new Dictionary<string, bool>(prev.ConseilsUtilisateurs ?? new Dictionary<string, bool>())
            });
            await Js.ApplySettingsAsync(Store.SettingsAffichees());
            _quotaDirty = false;
            State.NotifySuccess(L.T("Paramètres enregistrés."));
        }
        finally
        {
            _saving = false;
        }
    }

    [Inject] private GestionUtilisateurs.Online.Web.Services.AutoExportService AutoExport { get; set; } = default!;

    private async Task ExportNowAsync()
    {
        _exporting = true;
        try { await AutoExport.ExportNowAsync(); }
        finally { _exporting = false; StateHasChanged(); }
    }

    private async Task ExportExcel()
    {
        var bytes = Store.ExportUsersExcel();
        var path = await Saver.SaveAsync(ExportFileName("utilisateurs"), bytes, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        if (path != null)
        {
            Store.LogActivity(ActivityTypes.Export, "Export Excel des utilisateurs (" + Store.Users.Count + ")");
            State.NotifySuccess(L.F("Export réussi : {0}", path));
        }
        else
        {
            State.NotifyError(L.T("L'export a échoué. Réessayez."));
        }
    }

    private void OpenRestore()
    {
        _restoreError = "";
        _pendingImport = null;
        _showRestore = true;
    }

    private async Task PickRestore()
    {
        _restoreError = "";
        _pendingImport = null;
        var bytes = await Picker.PickXlsxAsync();
        if (bytes == null)
        {
            _restoreError = L.T("Fichier annulé ou illisible.");
            return;
        }

        var result = Store.ParseExcelImport(bytes);
        if (!result.Success)
        {
            _restoreError = L.F("Sauvegarde refusée : {0}", result.Error ?? L.T("fichier invalide."));
            return;
        }
        _pendingImport = result.Users;
    }

    private void ApplyRestore()
    {
        _restoreError = "";
        if (_pendingImport == null || _pendingImport.Count == 0)
        {
            _restoreError = L.T("Veuillez d'abord choisir un fichier Excel.");
            return;
        }

        var (res, count) = Store.ApplyImport(_pendingImport!);
        if (!res.Success)
        {
            _restoreError = res.Error;
            return;
        }

        _showRestore = false;
        _pendingImport = null;
        State.NotifySuccess(L.F("{0} utilisateur(s) ajouté(s) à l'annuaire.", count));
    }

    private static string ExportFileName(string stem) => stem + "-" + DateTime.Now.ToString("dd-MM-yyyy_HH-mm-ss") + ".xlsx";
}
