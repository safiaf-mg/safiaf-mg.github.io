@implements IDisposable
@inject AppState State
@inject DataStore Store
@inject JavascriptBridge Js

<div class="guide-hero">
    <span class="guide-hero-icon" aria-hidden="true">🧭</span>
    <div class="guide-hero-main">
        <h2 class="guide-hero-title">@L.T("Guide utilisateur")</h2>
        <p class="guide-hero-sub">@L.T("Le fonctionnement de l'application expliqué pas à pas, module par module.")</p>
    </div>
    @if (!Store.IsBaseAdmin)
    {
        <button type="button" class="btn btn-primary btn-sm guide-hero-tour" @onclick="ReplayTour">@L.T("▶ Mini-guide")</button>
    }
</div>

@if (_selected == null)
{
    <div class="guide-search-row">
        <input class="guide-search" type="search" placeholder="@L.T("🔍 Rechercher un module…")" value="@_search"
               @oninput="OnSearchInput" aria-label="@L.T("Rechercher un module du guide")" />
    </div>
    @if (Filtered.Count == 0)
    {
        <div class="card guide-empty">
            <p class="muted" style="margin:0">@L.F("Aucun module ne correspond à « {0} ».", _search)</p>
        </div>
    }
    else
    {
        <div class="guide-toc">
            @foreach (var e in Filtered)
            {
                <button type="button" class="guide-toc-item" @onclick="() => Select(e.Key)">
                    <span class="guide-toc-icon" aria-hidden="true">@e.Icon</span>
                    <span class="guide-toc-main">
                        <span class="guide-toc-label">@e.Title</span>
                        <span class="guide-toc-summary">@e.Summary</span>
                    </span>
                    <span class="guide-toc-chevron" aria-hidden="true">›</span>
                </button>
            }
        </div>
    }
}
else
{
    <div class="card guide-module" id="guide-top">
        <button type="button" class="btn btn-secondary btn-sm guide-back" @onclick="BackToToc">@L.T("← Tous les modules")</button>
        <div class="guide-module-head">
            <span class="guide-module-icon" aria-hidden="true">@_selected.Icon</span>
            <div>
                <h3 class="guide-module-title">@_selected.Title</h3>
                <p class="guide-module-summary">@_selected.Summary</p>
            </div>
        </div>

        @for (var i = 0; i < _selected.Sections.Length; i++)
        {
            var sec = _selected.Sections[i];
            <div class="help-section guide-section">
                <div class="guide-section-num" aria-hidden="true">@(i + 1)</div>
                <div class="guide-section-main">
                    <div class="help-section-title">@sec.Title</div>
                    <ul class="help-section-list">
                        @foreach (var point in sec.Points)
                        {
                            <li>@point</li>
                        }
                    </ul>
                </div>
            </div>
        }

        <div class="form-actions guide-module-actions">
            <button type="button" class="btn btn-secondary" @onclick="PrevModule">← @PrevModuleTitle</button>
            <button type="button" class="btn btn-primary" @onclick="NextModule">@NextModuleTitle →</button>
        </div>
    </div>
}

@code {
    private HelpEntry? _selected;
    private string _search = "";

    /// <summary>Modules du guide que le rôle du compte peut ouvrir (mêmes règles que le menu).</summary>
    private List<HelpEntry> Accessibles => HelpCatalog.Entries.Where(e => e.Key switch
    {
        "users" => Store.VoitListeMembres,
        "profile" => !Store.IsBaseAdmin,
        _ => Store.PeutOuvrir(e.Key)
    }).ToList();

    private List<HelpEntry> Filtered
    {
        get
        {
            var q = _search.Trim();
            if (q.Length == 0) return Accessibles;
            return Accessibles
                .Where(e => e.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || e.Summary.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
    }

    private void Select(string key)
    {
        _selected = HelpCatalog.Find(key);
        _search = "";
    }

    private void BackToToc()
    {
        _selected = null;
    }

    /// <summary>Geste « retour » : un module ouvert revient au sommaire du guide.</summary>
    private void RetourSousVue()
    {
        _selected = null;
        StateHasChanged();
    }

    protected override void OnAfterRender(bool firstRender)
        => State.SetSousVue(this, _selected != null ? RetourSousVue : null);

    public void Dispose() => State.SetSousVue(this, null);

    private int EntriesIndex()
    {
        var list = Accessibles;
        for (var i = 0; i < list.Count; i++)
            if (list[i].Key == _selected!.Key) return i;
        return -1;
    }

    private HelpEntry StepBy(int delta)
    {
        var entries = Accessibles;
        var idx = _selected == null ? -1 : EntriesIndex();
        return entries[(idx + delta + entries.Count) % entries.Count];
    }

    private string NextModuleTitle => StepBy(1).Title;
    private string PrevModuleTitle => StepBy(-1).Title;

    private void NextModule()
    {
        _selected = StepBy(1);
        _ = Js.ScrollToIdAsync("guide-top");
    }

    private void PrevModule()
    {
        _selected = StepBy(-1);
        _ = Js.ScrollToIdAsync("guide-top");
    }

    private void ReplayTour()
    {
        if (Store.IsBaseAdmin) return;
        State.RequestTour();
    }
}
