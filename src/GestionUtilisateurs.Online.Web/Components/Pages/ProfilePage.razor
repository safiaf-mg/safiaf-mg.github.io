@implements IDisposable
@inject DataStore Store
@inject AppState State

@if (_editing)
{
    <UserFormPage EditingId="@(Store.GetCurrentUser()?.Id)"
                  OnClose="@(() => { _editing = false; StateHasChanged(); })" />
}
else
{
    @if (Store.GetCurrentUser() is { } me)
    {
        <UserDetailPage UserId="@me.Id"
                        SelfView="true"
                        OnBack="@Back"
                        OnEdit="@(id => { _editing = true; StateHasChanged(); })" />
    }
    else
    {
        <EmptyState Icon="☹" Title="@L.T("Session expirée")" Message="@L.T("Veuillez vous reconnecter.")" />
    }
}

@code {
    private bool _editing;

    private void Back()
        => State.GoBack();

    /// <summary>Geste « retour » : ferme le formulaire de modification du profil.</summary>
    private void RetourSousVue()
    {
        _editing = false;
        StateHasChanged();
    }

    protected override void OnAfterRender(bool firstRender)
        => State.SetSousVue(this, _editing ? RetourSousVue : null);

    public void Dispose() => State.SetSousVue(this, null);
}