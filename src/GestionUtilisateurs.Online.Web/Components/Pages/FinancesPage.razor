@implements IDisposable
@inject DataStore Store
@inject AppState State

@if (!Store.Can(Permissions.FinancesManage))
{
    <EmptyState Icon="🔒" Title="@L.T("Accès réservé")" Message="@L.T("Les finances ne sont pas autorisées pour votre rôle.")" />
}
else
{
    <div class="page-head">
        <p>@L.T("Cotisations des membres et trésorerie, montants en Ariary.")</p>
    </div>

    <div class="stats-grid stats-grid-3">
        <StatCard Icon="💰" Value="@FormatSolde(Store.SoldeTresorerie())" Label="@L.T("Solde")" />
        <StatCard Icon="🧾" Value="@FormatSolde(Store.TotalCotisations(_periode))" Label="@L.F("Cotisations {0}", _periode)" Kind="active" />
        <StatCard Icon="⏳" Value="@FormatSolde(EnAttente.Sum(c => c.Montant))" Label="@(Impayes.Count > 1 ? L.F("Impayés ({0} membres)", Impayes.Count) : L.F("Impayés ({0} membre)", Impayes.Count))" Kind="inactive" />
    </div>

    <div class="search-box cal-search">
        <span class="search-icon" aria-hidden="true">&#128269;</span>
        <input type="search" placeholder="@L.T("Rechercher (membre, motif, montant)…")" aria-label="@L.T("Rechercher dans les finances")"
               value="@_search" @oninput="OnSearch" />
    </div>
    @if (!string.IsNullOrWhiteSpace(_search))
    {
        <div class="search-summary">@L.F("{0} résultat(s) pour « {1} »", SearchResultCount, _search.Trim())</div>
    }

    <div class="cal-view-tabs">
        <button class="cal-tab @(_tab == "cotisations" ? "active" : "")" @onclick='() => _tab = "cotisations"'>@L.T("Cotisations")</button>
        <button class="cal-tab @(_tab == "tresorerie" ? "active" : "")" @onclick='() => _tab = "tresorerie"'>@L.T("Trésorerie")</button>
    </div>

    @if (_tab == "cotisations")
    {
        <div class="inline-actions" style="justify-content:space-between;margin-bottom:10px">
            <select class="cal-year-select" aria-label="@L.T("Période")" value="@_periode" @onchange="e => _periode = e.Value?.ToString() ?? CurrentYear">
                @foreach (var y in Periodes)
                {
                    <option value="@y">@y</option>
                }
            </select>
            <div class="inline-actions">
                <button class="btn btn-secondary btn-sm" @onclick="StartConfigImpayes" title="@L.T("Indiquer les membres qui doivent une cotisation")">＋ @L.T("Impayés")</button>
                <button class="btn btn-secondary btn-sm" @onclick="StartAddCotisation">＋ @L.T("Paiement")</button>
            </div>
        </div>
        <p class="field-hint" style="margin:0 0 10px">@L.T("Les impayés ne sont plus automatiques : choisissez avec « ＋ Impayés » les membres qui doivent une cotisation, puis encaissez-la quand elle est payée.")</p>
        @if (FilteredCotisations.Count == 0)
        {
            <EmptyState Icon="🧾" Title="@L.T("Aucune cotisation")" Message="@L.T("Configurez les impayés de la période ou enregistrez un paiement.")" />
        }
        else
        {
            <div class="user-list">
                @foreach (var c in FilteredCotisations)
                {
                    var cot = c;
                    <div class="user-card @(_selCotId == cot.Id ? "selected" : "")" role="button" tabindex="0" @onclick="() => ToggleCot(cot.Id)" @onkeydown="(k) => OnCotKey(k, cot.Id)">
                        <span class="field-type-icon" aria-hidden="true">🧾</span>
                        <div class="user-card-main">
                            <div class="user-card-name">@DataStore.FormatMontant(cot.Montant) — @MemberName(cot.MembreIdentifiant)</div>
                            <div class="user-card-sub">@cot.Motif · @DataStore.FormatDateCourte(cot.Date)</div>
                            <div class="user-card-meta">
                                <Badge Text="@CotisationStatuts.Label(cot.Statut)" Kind="@(cot.Statut == CotisationStatuts.Payee ? "active" : "recent")" />
                            </div>
                        </div>
                        <div class="user-card-actions" @onclick:stopPropagation="true">
                            @if (cot.Statut == CotisationStatuts.EnAttente)
                            {
                                <button class="btn btn-primary btn-sm" @onclick="() => StartEncaisser(cot)">@L.T("Encaisser")</button>
                            }
                            <button class="btn-icon danger" aria-label="@L.T("Supprimer")" @onclick="() => AskDeleteCotisation(cot)">🗑</button>
                        </div>
                    </div>
                    @if (_selCotId == cot.Id)
                    {
                        <div class="cal-detail-box">
                            <div class="storage-line"><span>@L.T("Membre")</span><strong>@MemberName(cot.MembreIdentifiant)</strong></div>
                            <div class="storage-line"><span>@L.T("Montant")</span><strong>@DataStore.FormatMontant(cot.Montant)</strong></div>
                            <div class="storage-line"><span>@L.T("Motif")</span><strong>@cot.Motif</strong></div>
                            <div class="storage-line"><span>@L.T("Période")</span><strong>@cot.Periode</strong></div>
                            <div class="storage-line"><span>@L.T("Date")</span><strong>@DataStore.FormatDateCourte(cot.Date)</strong></div>
                            <div class="storage-line"><span>@L.T("Statut")</span><strong>@CotisationStatuts.Label(cot.Statut)</strong></div>
                            <div class="storage-line"><span>@L.T("Enregistrée par")</span><strong>@cot.CreatedBy</strong></div>
                            <div class="form-actions" style="margin-top:10px">
                                <button class="btn btn-secondary btn-sm" @onclick="() => StartEditCotisation(cot)">@L.T("Modifier")</button>
                                <button class="btn btn-secondary btn-sm" @onclick="() => _selCotId = null">@L.T("Réduire")</button>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        @if (Impayes.Count > 0)
        {
            <div class="card" style="margin-top:12px">
                <h3>⏳ @L.F("Impayés ({0}) — {1} membre(s), {2}", _periode, Impayes.Count, DataStore.FormatMontant(EnAttente.Sum(c => c.Montant)))</h3>
                <div class="search-box cal-search cal-opt-search">
                    <span class="search-icon" aria-hidden="true">&#128269;</span>
                    <input type="search" placeholder="@L.T("Écrire pour chercher un membre…")" aria-label="@L.T("Chercher un membre")"
                           value="@_impayeSearch" @oninput="e => _impayeSearch = e.Value?.ToString() ?? string.Empty" />
                </div>
                @foreach (var c in FilteredImpayes)
                {
                    var cot = c;
                    <div class="kv-row">
                        <span class="kv-label">@MemberName(cot.MembreIdentifiant)<small class="text-muted"> · @DataStore.FormatMontant(cot.Montant)@(string.IsNullOrWhiteSpace(cot.Motif) ? "" : " · " + cot.Motif)</small></span>
                        <span class="kv-value"><button class="btn btn-secondary btn-sm" @onclick="() => StartEncaisser(cot)">@L.T("Encaisser")</button></span>
                    </div>
                }
                @if (FilteredImpayes.Count == 0)
                {
                    <div class="cal-no-events">@L.F("Aucun membre trouvé pour « {0} ».", _impayeSearch)</div>
                }
            </div>
        }
    }
    else
    {
        <div class="inline-actions" style="justify-content:flex-end;margin-bottom:10px">
            <button class="btn btn-secondary btn-sm" @onclick="StartAddTransaction">＋ @L.T("Mouvement")</button>
        </div>
        @if (Store.Tresorerie.Count == 0)
        {
            <EmptyState Icon="💰" Title="@L.T("Aucun mouvement")" Message="@L.T("Enregistrez la première entrée ou sortie.")" />
        }
        else
        {
            <div class="user-list">
                @foreach (var t in FilteredTresorerie)
                {
                    var tr = t;
                    <div class="user-card @(_selTrId == tr.Id ? "selected" : "")" role="button" tabindex="0" @onclick="() => ToggleTr(tr.Id)" @onkeydown="(k) => OnTrKey(k, tr.Id)">
                        <span class="field-type-icon" aria-hidden="true">@TresorerieTypes.Icon(tr.Type)</span>
                        <div class="user-card-main">
                            <div class="user-card-name">@((tr.Type == TresorerieTypes.Sortie ? "−" : "+") + DataStore.FormatMontant(tr.Montant)) — @tr.Motif</div>
                            <div class="user-card-sub">@DataStore.FormatDateCourte(tr.Date) · @L.F("par {0}", tr.CreatedBy)</div>
                        </div>
                        <div class="user-card-actions" @onclick:stopPropagation="true">
                            <button class="btn-icon danger" aria-label="@L.T("Supprimer")" @onclick="() => AskDeleteTransaction(tr)">🗑</button>
                        </div>
                    </div>
                    @if (_selTrId == tr.Id)
                    {
                        <div class="cal-detail-box">
                            <div class="storage-line"><span>@L.T("Type")</span><strong>@TresorerieTypes.Label(tr.Type)</strong></div>
                            <div class="storage-line"><span>@L.T("Montant")</span><strong>@((tr.Type == TresorerieTypes.Sortie ? "− " : "+ ") + DataStore.FormatMontant(tr.Montant))</strong></div>
                            <div class="storage-line"><span>@L.T("Motif")</span><strong>@tr.Motif</strong></div>
                            <div class="storage-line"><span>@L.T("Date")</span><strong>@DataStore.FormatDateCourte(tr.Date)</strong></div>
                            <div class="storage-line"><span>@L.T("Enregistré par")</span><strong>@tr.CreatedBy</strong></div>
                            <div class="form-actions" style="margin-top:10px">
                                <button class="btn btn-secondary btn-sm" @onclick="() => _selTrId = null">@L.T("Réduire")</button>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }

    <button class="fab" aria-label="@L.T("Ajouter une cotisation ou un mouvement")" @onclick="OnFabAdd">+</button>

    <Modal Title="@(_editCotId == null ? L.T("Enregistrer un paiement") : L.T("Modifier la cotisation"))" Show="_showCotisation" OnClose="() => _showCotisation = false">
        <ChildContent>
            @if (_editCotId == null)
            {
                <div class="form-group">
                    <label>@L.T("Membre *")</label>
                    <MemberPicker Value="@_cMembre" ValueChanged="@((string v) => _cMembre = v)" Placeholder="@L.T("Écrire pour chercher un membre…")" />
                </div>
            }
            else
            {
                <p class="text-muted" style="margin-top:0">@MemberName(_cMembre)</p>
            }
            <div class="form-group">
                <label for="fi-montant">@L.T("Montant (Ar) *")</label>
                <input id="fi-montant" type="text" inputmode="decimal" placeholder="@L.T("Ex : 5000")" value="@_cMontant" @oninput="e => _cMontant = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="form-group">
                <label for="fi-motif">@L.T("Motif")</label>
                <input id="fi-motif" type="text" placeholder="@L.T("Ex : Cotisation annuelle")" value="@_cMotif" @oninput="e => _cMotif = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="form-group">
                <label for="fi-periode">@L.T("Période")</label>
                <input id="fi-periode" type="text" value="@_cPeriode" @oninput="e => _cPeriode = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="form-group">
                <label for="fi-date">@L.T("Date")</label>
                <DateInput Id="fi-date" Value="@_cDateIso" ValueChanged="@(v => _cDateIso = v)" />
            </div>
            @if (_editCotId != null)
            {
                <div class="form-group">
                    <label for="fi-statut">@L.T("Statut")</label>
                    <select id="fi-statut" value="@_cStatut" @onchange="e => _cStatut = e.Value?.ToString() ?? CotisationStatuts.Payee">
                        @foreach (var st in ListesChoix.Elements(ListesChoix.StatutsCotisation))
                        {
                            <option value="@st.Cle" selected="@(st.Cle == _cStatut)">@(st.Cle == CotisationStatuts.EnAttente ? ListesChoix.LibellePerso(ListesChoix.StatutsCotisation, st.Cle) ?? L.T("En attente (impayé)") : st.Libelle)</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <label class="form-check" for="fi-treso">
                    <input id="fi-treso" type="checkbox" checked="@_cTreso" @onchange="e => _cTreso = e.Value is bool b && b" />
                    @L.T("Ajouter aussi l'entrée en trésorerie")
                </label>
            }
            <span class="form-error">@_cError</span>
        </ChildContent>
        <FooterContent>
            <button class="btn btn-secondary" @onclick="() => _showCotisation = false">@L.T("Annuler")</button>
            <button class="btn btn-primary" @onclick="SaveCotisation">@L.T("Enregistrer")</button>
        </FooterContent>
    </Modal>

    <Modal Title="@L.T("Encaisser la cotisation")" Show="_encaisser != null" OnClose="() => _encaisser = null">
        <ChildContent>
            @if (_encaisser != null)
            {
                <p style="margin-top:0"><strong>@MemberName(_encaisser.MembreIdentifiant)</strong> · @DataStore.FormatMontant(_encaisser.Montant)@(string.IsNullOrWhiteSpace(_encaisser.Motif) ? "" : " · " + _encaisser.Motif) (@_encaisser.Periode)</p>
                <div class="form-group">
                    <label for="enc-date">@L.T("Date du paiement")</label>
                    <DateInput Id="enc-date" Value="@_encDateIso" ValueChanged="@(v => _encDateIso = v)" />
                </div>
                <label class="form-check" for="enc-treso">
                    <input id="enc-treso" type="checkbox" checked="@_cTreso" @onchange="e => _cTreso = e.Value is bool b && b" />
                    @L.T("Ajouter aussi l'entrée en trésorerie")
                </label>
                <span class="form-error">@_encError</span>
            }
        </ChildContent>
        <FooterContent>
            <button class="btn btn-secondary" @onclick="() => _encaisser = null">@L.T("Annuler")</button>
            <button class="btn btn-primary" @onclick="ConfirmEncaisser">@L.T("Encaisser")</button>
        </FooterContent>
    </Modal>

    <Modal Title="@L.T("Configurer des impayés")" Show="_showImpayes" OnClose="() => _showImpayes = false">
        <ChildContent>
            <p class="text-muted" style="margin-top:0">@L.T("Chaque membre coché devra cette cotisation. Un membre qui a déjà une cotisation de même motif sur la période est ignoré.")</p>
            <div class="form-group">
                <label for="imp-montant">@L.T("Montant dû (Ar) *")</label>
                <input id="imp-montant" type="text" inputmode="decimal" placeholder="@L.T("Ex : 5000")" value="@_iMontant" @oninput="e => _iMontant = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="form-group">
                <label for="imp-motif">@L.T("Motif")</label>
                <input id="imp-motif" type="text" value="@_iMotif" @oninput="e => _iMotif = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="form-group">
                <label for="imp-periode">@L.T("Période")</label>
                <input id="imp-periode" type="text" value="@_iPeriode" @oninput="e => _iPeriode = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="form-group">
                <label>@L.F("Membres concernés ({0})", _iChoix.Count)</label>
                <div class="inline-actions" style="margin-bottom:6px;flex-wrap:wrap">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ChoisirTous">@L.T("Tous les membres actifs")</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ChoisirMajeurs">@L.T("Seulement les 18 ans et plus")</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _iChoix.Clear()">@L.T("Aucun")</button>
                </div>
                <div class="search-box cal-search cal-opt-search">
                    <span class="search-icon" aria-hidden="true">&#128269;</span>
                    <input type="search" placeholder="@L.T("Chercher un membre…")" aria-label="@L.T("Chercher un membre")"
                           value="@_iSearch" @oninput="e => _iSearch = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="fin-member-list">
                    @foreach (var u in ImpayeCandidats)
                    {
                        var user = u;
                        <label class="form-check fin-member">
                            <input type="checkbox" checked="@_iChoix.Contains(user.Identifiant)" @onchange="e => ToggleChoix(user.Identifiant, e.Value is bool b && b)" />
                            <span>@user.NomComplet@(user.EstMineur ? " · " + L.T("moins de 18 ans") : "")</span>
                        </label>
                    }
                </div>
            </div>
            <span class="form-error">@_iError</span>
        </ChildContent>
        <FooterContent>
            <button class="btn btn-secondary" @onclick="() => _showImpayes = false">@L.T("Annuler")</button>
            <button class="btn btn-primary" @onclick="SaveImpayes">@L.T("Enregistrer")</button>
        </FooterContent>
    </Modal>

    <Modal Title="@L.T("Nouveau mouvement")" Show="_showTransaction" OnClose="() => _showTransaction = false">
        <ChildContent>
            <div class="form-group">
                <label>@L.T("Type")</label>
                <div class="radio-row">
                    <label class="radio-option">
                        <input type="radio" name="tr-type" checked="@(_tType == TresorerieTypes.Entree)" @onchange="() => _tType = TresorerieTypes.Entree" />
                        @TresorerieTypes.Icon(TresorerieTypes.Entree) @TresorerieTypes.Label(TresorerieTypes.Entree)
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="tr-type" checked="@(_tType == TresorerieTypes.Sortie)" @onchange="() => _tType = TresorerieTypes.Sortie" />
                        @TresorerieTypes.Icon(TresorerieTypes.Sortie) @TresorerieTypes.Label(TresorerieTypes.Sortie)
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label for="tr-montant">@L.T("Montant (Ar) *")</label>
                <input id="tr-montant" type="text" inputmode="decimal" placeholder="@L.T("Ex : 20000")" value="@_tMontant" @oninput="e => _tMontant = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="form-group">
                <label for="tr-motif">@L.T("Motif *")</label>
                <input id="tr-motif" type="text" value="@_tMotif" @oninput="e => _tMotif = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="form-group">
                <label for="tr-date">@L.T("Date")</label>
                <DateInput Id="tr-date" Value="@_tDateIso" ValueChanged="@(v => _tDateIso = v)" />
            </div>
            <span class="form-error">@_tError</span>
        </ChildContent>
        <FooterContent>
            <button class="btn btn-secondary" @onclick="() => _showTransaction = false">@L.T("Annuler")</button>
            <button class="btn btn-primary" @onclick="SaveTransaction">@L.T("Enregistrer")</button>
        </FooterContent>
    </Modal>

    <ConfirmDialog Show="_deleteCotisation != null" Title="@L.T("Supprimer la cotisation")"
                   Message="@L.T("Supprimer définitivement cette cotisation ?")"
                   ConfirmLabel="@L.T("Supprimer")" Danger="true" OnConfirm="ConfirmDeleteCotisation" OnCancel="() => _deleteCotisation = null" />
    <ConfirmDialog Show="_deleteTransaction != null" Title="@L.T("Supprimer le mouvement")"
                   Message="@L.T("Supprimer définitivement ce mouvement ?")"
                   ConfirmLabel="@L.T("Supprimer")" Danger="true" OnConfirm="ConfirmDeleteTransaction" OnCancel="() => _deleteTransaction = null" />
}

@code {
    private string _tab = "cotisations";
    private string CurrentYear => DateTime.Today.Year.ToString();
    private string _periode = "";
    private string _search = "";
    private string? _selCotId;
    private string? _selTrId;

    private void ToggleCot(string id) => _selCotId = _selCotId == id ? null : id;
    private void ToggleTr(string id) => _selTrId = _selTrId == id ? null : id;
    private void OnCotKey(KeyboardEventArgs e, string id) { if (e.Key is "Enter" or " ") ToggleCot(id); }
    private void OnTrKey(KeyboardEventArgs e, string id) { if (e.Key is "Enter" or " ") ToggleTr(id); }
    private List<Cotisation> FilteredCotisations =>
        Store.Cotisations.Where(c => c.Periode == _periode).Where(MatchCotisation).OrderByDescending(c => c.Date).ToList();

    private List<TransactionTresorerie> FilteredTresorerie
        => Store.Tresorerie.Where(MatchTransaction).OrderByDescending(t => t.Date).ToList();

    private bool MatchCotisation(Cotisation c)
    {
        var q = _search.Trim();
        if (q.Length == 0) return true;
        return (MemberName(c.MembreIdentifiant) + " " + c.Motif + " " + DataStore.FormatMontant(c.Montant))
            .Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchTransaction(TransactionTresorerie t)
    {
        var q = _search.Trim();
        if (q.Length == 0) return true;
        return (t.Motif + " " + t.CreatedBy + " " + DataStore.FormatMontant(t.Montant) + " " + TresorerieTypes.Label(t.Type))
            .Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private int SearchResultCount
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search)) return 0;
            return _tab == "cotisations" ? FilteredCotisations.Count : FilteredTresorerie.Count;
        }
    }

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? string.Empty;

    private IReadOnlyList<UserAccount> Impayes => Store.ImpayesCotisations(_periode);
    private IReadOnlyList<Cotisation> EnAttente => Store.CotisationsEnAttente(_periode);
    private string _impayeSearch = "";

    private List<Cotisation> FilteredImpayes
    {
        get
        {
            var q = _impayeSearch.Trim();
            var list = EnAttente.OrderBy(c => MemberName(c.MembreIdentifiant)).ToList();
            if (q.Length == 0) return list;
            return list.Where(c => (MemberName(c.MembreIdentifiant) + " " + c.MembreIdentifiant + " " + c.Motif)
                .Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    // ---- Configuration des impayés ----
    private bool _showImpayes;
    private string _iMontant = "";
    private string _iMotif = "";
    private string _iPeriode = "";
    private string _iSearch = "";
    private string _iError = "";
    private readonly HashSet<string> _iChoix = new(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<UserAccount> ImpayeCandidats
    {
        get
        {
            var q = _iSearch.Trim();
            var list = ActiveUsers.AsEnumerable();
            if (q.Length > 0)
                list = list.Where(u => (u.NomComplet + " " + u.Identifiant).Contains(q, StringComparison.OrdinalIgnoreCase));
            return list;
        }
    }

    private void StartConfigImpayes()
    {
        _iMontant = ""; _iMotif = "Cotisation " + _periode; _iPeriode = _periode;
        _iSearch = ""; _iError = ""; _iChoix.Clear();
        _showImpayes = true;
    }

    private void ToggleChoix(string identifiant, bool on)
    {
        if (on) _iChoix.Add(identifiant); else _iChoix.Remove(identifiant);
    }

    private void ChoisirTous() { _iChoix.Clear(); foreach (var u in ActiveUsers) _iChoix.Add(u.Identifiant); }
    private void ChoisirMajeurs() { _iChoix.Clear(); foreach (var u in ActiveUsers.Where(u => !u.EstMineur)) _iChoix.Add(u.Identifiant); }

    private void SaveImpayes()
    {
        _iError = "";
        var montant = ParseMontant(_iMontant);
        if (montant == null) { _iError = L.T("Montant invalide."); return; }
        var (res, ajoutes, ignores) = Store.AddCotisationsEnAttente(_iChoix, montant.Value, _iMotif, _iPeriode);
        if (!res.Success) { _iError = res.Error; return; }
        _periode = string.IsNullOrWhiteSpace(_iPeriode) ? _periode : _iPeriode.Trim();
        State.NotifySuccess(ignores > 0 ? L.F("{0} impayé(s) ajouté(s), {1} déjà présent(s).", ajoutes, ignores) : L.F("{0} impayé(s) ajouté(s).", ajoutes));
        _showImpayes = false;
    }

    // ---- Encaissement ----
    private Cotisation? _encaisser;
    private string _encDateIso = "";
    private string _encError = "";
    private bool _cTreso = true;

    private void StartEncaisser(Cotisation c)
    {
        _encaisser = c; _encDateIso = ""; _encError = ""; _cTreso = true;
    }

    private void ConfirmEncaisser()
    {
        if (_encaisser == null) return;
        var res = Store.EncaisserCotisation(_encaisser.Id, DataStore.ToYmd(_encDateIso), _cTreso);
        if (!res.Success) { _encError = res.Error; return; }
        State.NotifySuccess(L.T("Cotisation encaissée."));
        _encaisser = null;
    }
    private IReadOnlyList<UserAccount> ActiveUsers =>
        Store.Users.Where(u => u.Actif).OrderBy(u => u.NomComplet).ToList();

    private List<string> Periodes
    {
        get
        {
            var set = new HashSet<string>(Store.Cotisations.Select(c => c.Periode).Where(p => !string.IsNullOrWhiteSpace(p)));
            set.Add(CurrentYear);
            return set.OrderByDescending(p => p).ToList();
        }
    }

    private bool _showCotisation;
    private string? _editCotId;
    private string _cMembre = "";
    private string _cMontant = "";
    private string _cMotif = "";
    private string _cPeriode = "";
    private string _cDateIso = "";
    private string _cStatut = CotisationStatuts.Payee;
    private string _cError = "";
    private Cotisation? _deleteCotisation;

    private bool _showTransaction;
    private string _tType = TresorerieTypes.Entree;
    private string _tMontant = "";
    private string _tMotif = "";
    private string _tDateIso = "";
    private string _tError = "";
    private TransactionTresorerie? _deleteTransaction;

    protected override void OnInitialized()
    {
        Store.DataChanged += Refresh;
        _periode = CurrentYear;
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private string MemberName(string identifiant)
        => Store.FindUserByIdentifier(identifiant)?.NomComplet ?? identifiant;

    private static string FormatSolde(double montant)
        => (montant < 0 ? "−" : "") + DataStore.FormatMontant(Math.Abs(montant));

    private static double? ParseMontant(string raw)
    {
        var v = (raw ?? "").Trim().Replace(" ", "").Replace(',', '.');
        if (v.Length == 0) return null;
        if (double.TryParse(v, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var n))
            return n;
        return null;
    }

    private void OnFabAdd()
    {
        if (_tab == "tresorerie") StartAddTransaction();
        else StartAddCotisation();
    }

    private void StartAddCotisation()
    {
        _editCotId = null;
        _cMembre = ""; _cMontant = ""; _cMotif = "";
        _cPeriode = _periode; _cDateIso = ""; _cStatut = CotisationStatuts.Payee;
        _cError = ""; _cTreso = true;
        _showCotisation = true;
    }

    private void StartEditCotisation(Cotisation c)
    {
        _editCotId = c.Id;
        _cMembre = c.MembreIdentifiant;
        _cMontant = c.Montant.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _cMotif = c.Motif; _cPeriode = c.Periode; _cDateIso = c.Date; _cStatut = c.Statut;
        _cError = "";
        _showCotisation = true;
    }

    private void SaveCotisation()
    {
        _cError = "";
        var montant = ParseMontant(_cMontant);
        if (string.IsNullOrWhiteSpace(_cMembre)) { _cError = L.T("Choisissez un membre."); return; }
        if (montant == null) { _cError = L.T("Montant invalide."); return; }
        var cot = new Cotisation
        {
            Id = _editCotId ?? "",
            MembreIdentifiant = _cMembre,
            Montant = montant.Value,
            Motif = _cMotif,
            Periode = _cPeriode,
            Date = DataStore.ToYmd(_cDateIso),
            Statut = _editCotId == null ? CotisationStatuts.Payee : _cStatut
        };
        var res = _editCotId == null ? Store.AddCotisation(cot, _cTreso) : Store.UpdateCotisation(cot);
        if (!res.Success) { _cError = res.Error; return; }
        State.NotifySuccess(_editCotId == null ? L.T("Paiement enregistré.") : L.T("Cotisation modifiée."));
        _showCotisation = false;
    }

    private void AskDeleteCotisation(Cotisation c) => _deleteCotisation = c;

    private void ConfirmDeleteCotisation()
    {
        var t = _deleteCotisation;
        _deleteCotisation = null;
        if (t == null) return;
        var res = Store.DeleteCotisation(t.Id);
        if (res.Success) State.NotifySuccess(L.T("Cotisation supprimée."));
        else State.NotifyError(res.Error);
    }

    private void StartAddTransaction()
    {
        _tType = TresorerieTypes.Entree;
        _tMontant = ""; _tMotif = ""; _tDateIso = "";
        _tError = "";
        _showTransaction = true;
    }

    private void SaveTransaction()
    {
        _tError = "";
        var montant = ParseMontant(_tMontant);
        if (montant == null) { _tError = L.T("Montant invalide."); return; }
        var res = Store.AddTransaction(new TransactionTresorerie
        {
            Type = _tType,
            Montant = montant.Value,
            Motif = _tMotif,
            Date = DataStore.ToYmd(_tDateIso)
        });
        if (!res.Success) { _tError = res.Error; return; }
        State.NotifySuccess(L.T("Mouvement enregistré."));
        _showTransaction = false;
    }

    private void AskDeleteTransaction(TransactionTresorerie t) => _deleteTransaction = t;

    private void ConfirmDeleteTransaction()
    {
        var t = _deleteTransaction;
        _deleteTransaction = null;
        if (t == null) return;
        var res = Store.DeleteTransaction(t.Id);
        if (res.Success) State.NotifySuccess(L.T("Mouvement supprimé."));
        else State.NotifyError(res.Error);
    }

    public void Dispose() => Store.DataChanged -= Refresh;
}
