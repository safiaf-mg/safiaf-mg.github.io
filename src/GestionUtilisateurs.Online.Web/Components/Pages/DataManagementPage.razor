    private void RevealPassword(string userId) => _revealedPasswords.Add(userId);

    private void HidePassword(string userId) => _revealedPasswords.Remove(userId);

    private static string DataSetLabel(string key) =>
        DataStore.ManagedDataSets.FirstOrDefault(d => d.Key == key)?.Label ?? key;

    private void Reload()
    {
        _users = Store.Users.ToList();
        _fields = Store.ChampsPersonnalises.ToList();
        var s = Store.Settings;
        _appName = s.AppName;
        _theme = s.Theme;
        _color = s.Color;
        _autoExport = s.ExportAutoMensuel;
    }

    // ---------- Utilisateurs ----------

    private void StartAddUser()
    {
        _userEditId = null;
        _userDraft = new UserAccount { Role = Roles.Utilisateur, Actif = true };
        _userError = "";
        _userFormVisible = true;
    }

    private void StartEditUser(UserAccount u)
    {
        _userEditId = u.Id;
        // Copie complète : la mise à jour reprend aussi photo, signature, naissance,
        // matricule et champs personnalisés, qui ne doivent pas être effacés.
        _userDraft = System.Text.Json.JsonSerializer.Deserialize<UserAccount>(System.Text.Json.JsonSerializer.Serialize(u))!;
        _userError = "";
        _userFormVisible = true;
    }

    private void CancelUserForm()
    {
        _userDraft = null;
        _userEditId = null;
        _userFormVisible = false;
        _userError = "";
    }

    private void SaveUser()
    {
        _userError = "";
        if (_userDraft == null) return;
        if (string.IsNullOrWhiteSpace(_userDraft.Prenom) || string.IsNullOrWhiteSpace(_userDraft.Nom))
        {
            _userError = L.T("Le prénom et le nom sont obligatoires.");
            return;
        }
        if (!string.IsNullOrWhiteSpace(_userDraft.Email) && !Store.IsEmailValid(_userDraft.Email))
        {
            _userError = L.T("L'adresse e-mail n'est pas valide.");
            return;
        }
        if (!string.IsNullOrWhiteSpace(_userDraft.Telephone) && !DataStore.IsPhoneValid(_userDraft.Telephone))
        {
            _userError = L.T("Le numéro doit avoir 9 chiffres après +261 (ex. 341234567).");
            return;
        }

        if (_userEditId != null)
        {
            var draft = _userDraft;
            var res = Store.UpdateUser(_userEditId, draft, false);
            if (!res.Success)
            {
                _userError = res.Error;
                return;
            }
            State.NotifySuccess(L.F("Utilisateur « {0} » enregistré.", draft.NomComplet));
        }
        else
        {
            var draft = _userDraft;
            var res = Store.AddUser(draft);
            if (!res.Success)
            {
                _userError = res.Error;
                return;
            }
            State.NotifySuccess(L.F("Utilisateur « {0} » ajouté.", draft.NomComplet));
        }
        CancelUserForm();
    }

    private void AskDeleteUser(UserAccount u)
    {
        _confirm = new ConfirmState(true, L.T("Supprimer l'utilisateur"),
            L.F("Supprimer « {0} » ? Le compte sera archivé.", u.NomComplet),
            L.T("Supprimer"), true, () =>
            {
                var res = Store.DeleteUser(u.Id);
                if (res.Success) State.NotifySuccess(L.T("Utilisateur supprimé."));
                else State.NotifyError(L.F("Erreur : {0}", res.Error));
            });
    }

    // ---------- Champs ----------

    private void StartAddField()
    {
        _fieldEditId = null;
        _fieldDraft = new FieldDefinition { Type = FieldType.Texte, Actif = true };
        _fieldOptions = "";
        _fieldError = "";
        _fieldFormVisible = true;
    }

    private void StartEditField(FieldDefinition f)
    {
        _fieldEditId = f.Id;
        _fieldDraft = new FieldDefinition
        {
            Id = f.Id, Label = f.Label, Type = f.Type, Requis = f.Requis,
            Options = f.Options.ToList(), Ordre = f.Ordre, Actif = f.Actif, SystemField = f.SystemField
        };
        _fieldOptions = string.Join('\n', f.Options);
        _fieldError = "";
        _fieldFormVisible = true;
    }

    private void CancelFieldForm()
    {
        _fieldDraft = null;
        _fieldEditId = null;
        _fieldFormVisible = false;
        _fieldError = "";
    }

    private void SaveField()
    {
        _fieldError = "";
        if (_fieldDraft == null) return;
        _fieldDraft.Options = _fieldOptions
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var res = _fieldEditId == null ? Store.AddField(_fieldDraft) : Store.UpdateField(_fieldDraft);
        if (!res.Success)
        {
            _fieldError = res.Error;
            return;
        }
        State.NotifySuccess(_fieldEditId == null
            ? L.F("Champ « {0} » ajouté.", _fieldDraft.Label)
            : L.F("Champ « {0} » enregistré.", _fieldDraft.Label));
        CancelFieldForm();
    }

    private void AskDeleteField(FieldDefinition f)
    {
        _confirm = new ConfirmState(true, L.T("Supprimer le champ"),
            L.F("Supprimer le champ « {0} » du formulaire et des utilisateurs ?", f.Label),
            L.T("Supprimer"), true, () =>
            {
                var (res, _) = Store.DeleteField(f.Id);
                if (res.Success) State.NotifySuccess(L.T("Champ supprimé."));
                else State.NotifyError(L.F("Erreur : {0}", res.Error));
            });
    }

    private void OnFieldTypeChanged(ChangeEventArgs e)
    {
        if (_fieldDraft == null) return;
        var value = e.Value?.ToString() ?? FieldType.Texte.ToString();
        if (Enum.TryParse<FieldType>(value, true, out var type))
        {
            var previous = _fieldDraft.Type;
            _fieldDraft.Type = type;
            if (previous != type)
            {
                _fieldDraft.Options = new List<string>();
                _fieldOptions = "";
            }
        }
    }

