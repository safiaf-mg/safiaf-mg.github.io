    // ---------- Paramètres ----------

    private void SelectAccent(string color)
    {
        _color = color;
    }

    private void OnThemeChanged(ChangeEventArgs e)
    {
        _theme = e.Value?.ToString() ?? "light";
    }

    private async Task SaveSettingsAsync()
    {
        _saving = true;
        try
        {
            // Copie complète des paramètres : seuls le nom, la couleur et l'export changent ici
            // (avant, l'ordre du menu, la carte de membre, etc. étaient remis à zéro).
            var copie = System.Text.Json.JsonSerializer.Deserialize<AppSettings>(
                System.Text.Json.JsonSerializer.Serialize(Store.Settings)) ?? new AppSettings();
            copie.AppName = string.IsNullOrWhiteSpace(_appName) ? "Gestion des utilisateurs" : _appName.Trim();
            copie.Color = _color;
            copie.ExportAutoMensuel = _autoExport;
            Store.SaveSettings(copie);
            await Js.ApplySettingsAsync(Store.SettingsAffichees());
            State.NotifySuccess(L.T("Paramètres enregistrés."));
        }
        finally
        {
            _saving = false;
        }
    }

    public void Dispose() => Store.DataChanged -= OnChanged;
}