@implements IDisposable
@inject DataStore Store
@inject AppState State

@if (!Store.Can(Permissions.RappelsUse))
{
    <EmptyState Icon="🔒" Title="@L.T("Accès réservé")" Message="@L.T("Les rappels ne sont pas autorisés pour votre rôle.")" />
}
else
{
    <div class="page-head">
        <p>@L.T("Calculés automatiquement : tâches, anniversaires, événements, cotisations. Touchez un rappel pour ouvrir la page concernée.")</p>
    </div>

    <div class="search-box cal-search">
        <span class="search-icon" aria-hidden="true">&#128269;</span>
        <input type="search" placeholder="@L.T("Rechercher un rappel (titre, détail, catégorie)…")" aria-label="@L.T("Rechercher un rappel")"
               value="@_search" @oninput="OnSearch" />
    </div>
    @if (!string.IsNullOrWhiteSpace(_search))
    {
        <div class="search-summary">@L.F("{0} rappel(s) trouvé(s) pour « {1} »", _rappels.Count, _search.Trim())</div>
    }

    @if (_rappels.Count == 0)
    {
        <EmptyState Icon="⏰" Title="@L.T("Rien à signaler")" Message="@L.T("Aucun rappel pour le moment. Tout est à jour.")" />
    }
    else if (!FilteredRappels.Any())
    {
        <EmptyState Icon="⏰" Title="@L.T("Aucun résultat")" Message="@L.T("Aucun rappel ne correspond à cette recherche.")" />
    }
    else
    {
        @foreach (var group in FilteredRappels)
        {
            <div class="cal-list-day" style="margin-bottom:14px">
                <div class="cal-list-header">
                    <span class="cal-list-date">@group.Key</span>
                    <span class="cal-list-count">@L.F("{0} rappel(s)", group.Count())</span>
                </div>
                <div class="cal-events">
                    @foreach (var r in group)
                    {
                        var rappel = r;
                        <div class="cal-card @(_expanded == rappel.Id ? "selected" : "")" style="--evt-color:@RappelColor(rappel.Priorite)" role="button" tabindex="0" @onclick="() => Toggle(rappel.Id)" @onkeydown="(k) => OnKey(k, rappel.Id)">
                            <div class="cal-card-time">@RappelIcon(rappel.Priorite)</div>
                            <div class="cal-card-main">
                                <div class="cal-card-title">@rappel.Titre</div>
                                <div class="cal-card-meta">@rappel.Detail</div>
                            </div>
                            <div class="cal-card-menu" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg>
                            </div>
                        </div>
                        @if (_expanded == rappel.Id)
                        {
                            <div class="cal-detail-box">
                                <div class="storage-line"><span>@L.T("Priorité")</span><strong>@CalendarEventTypes.PrioriteLabel(rappel.Priorite)</strong></div>
                                <div class="storage-line"><span>@L.T("Catégorie")</span><strong>@rappel.Categorie</strong></div>
                                <div class="storage-line"><span>@L.T("Détail")</span><strong>@rappel.Detail</strong></div>
                                <div class="form-actions" style="margin-top:10px">
                                    <button class="btn btn-primary btn-sm" @onclick="() => State.Navigate(rappel.PageCible)" @onclick:stopPropagation="true">@L.T("Ouvrir la page") <span aria-hidden="true">→</span></button>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => _expanded = null">@L.T("Réduire")</button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
}

@code {
    private List<Rappel> _rappels = new();
    private string _search = "";
    private string? _expanded;

    protected override void OnInitialized()
    {
        Store.DataChanged += Refresh;
        RefreshList();
    }

    protected override void OnParametersSet() => RefreshList();

    private void Refresh() => _ = InvokeAsync(() => { RefreshList(); StateHasChanged(); });

    private void RefreshList() => _rappels = Store.GetRappels().ToList();

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? string.Empty;

    private bool MatchSearch(Rappel r)
    {
        var q = _search.Trim();
        if (q.Length == 0) return true;
        return (r.Titre + " " + r.Detail + " " + r.Categorie)
            .Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<IGrouping<string, Rappel>> FilteredRappels
        => _rappels.Where(MatchSearch).GroupBy(r => r.Categorie);

    private void OnKey(KeyboardEventArgs k, string id)
    {
        if (k.Key is "Enter" or " ") Toggle(id);
    }

    private void Toggle(string id) => _expanded = _expanded == id ? null : id;

    private static string RappelColor(string priorite) => priorite switch
    {
        CalendarEventTypes.PrioriteUrgente => "#dc2626",
        CalendarEventTypes.PrioriteImportante => "#d97706",
        _ => "#0891b2"
    };

    private static string RappelIcon(string priorite) => priorite switch
    {
        CalendarEventTypes.PrioriteUrgente => "⚠",
        CalendarEventTypes.PrioriteImportante => "⏰",
        _ => "🔔"
    };

    public void Dispose() => Store.DataChanged -= Refresh;
}
