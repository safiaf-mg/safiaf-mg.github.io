@implements IDisposable
@inject DataStore Store
@inject AppState State
@inject NativeFileSaver Saver
@inject NavigationManager Nav

@if (!Store.Can(Permissions.CarteMembreView))
{
    <EmptyState Icon="🔒" Title="@L.T("Accès réservé")" Message="@L.T("La carte de membre n'est pas autorisée pour votre rôle.")" />
}
else
{
    <div class="page-head">
        <p>@L.T("Carte de visite du membre avec QR code, imprimable ou exportable.")</p>
    </div>

    <div class="form-group no-print">
        <label>@L.T("Membre")</label>
        <MemberPicker Value="@_selectedIdent" ValueChanged="@((string v) => _selectedIdent = v)" ActiveOnly="false" Placeholder="@L.T("Écrire pour chercher un membre…")" />
    </div>

    @if (Current != null)
    {
        var user = Current;
        var memberCode = MemberCode(user);
        var isActive = user.Actif;
        <div class="cmc-scene">
            <div class="cmc @(_showBack ? "cmc-back-visible" : "")" id="member-card-print">
                <div class="cmc-face cmc-front">
                    <span class="cmc-wave" aria-hidden="true"></span>
                    <div class="cmc-leaf" aria-hidden="true">
                        <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.6">
                            <path d="M12 108C12 60 52 20 108 12c-4 56-44 96-96 96z" />
                            <path d="M108 12C76 34 48 62 24 96" />
                        </svg>
                    </div>
                    <div class="cmc-front-head">
                        <div class="cmc-brand">
                            <img class="cmc-logo" src="@Root.LogoOuDefaut(Store.Settings.Logo)" alt="@L.T("Logo de la communauté")" />
                            <div class="cmc-brand-text">
                                <strong>@Store.Settings.AppName</strong>
                                @if (!string.IsNullOrWhiteSpace(Store.Settings.CarteSlogan))
                                {
                                    <span>@Store.Settings.CarteSlogan</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="cmc-front-body">
                        <div class="cmc-id">
                            <Avatar UserName="@user.NomComplet" Seed="@user.Identifiant" Size="card" Photo="@user.Photo" />
                            <div class="cmc-id-text">
                                <div class="cmc-name">@user.NomComplet</div>
                                <div class="cmc-status @(isActive ? "is-active" : "is-suspended")">
                                    <span class="cmc-dot" aria-hidden="true"></span>@(isActive ? L.T("Membre actif") : L.T("Carte suspendue"))
                                    @if (user.EstMineur)
                                    {
                                        <span class="cmc-minor">@L.T("Mineur")</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(memberCode))
                                {
                                    <div class="cmc-field"><span>@L.T("Matricule")</span><strong>@memberCode</strong></div>
                                }
                                <div class="cmc-field"><span>@L.T("Adhésion")</span><strong>@DataStore.FormatDateCourte(user.DateCreation)</strong></div>
                            </div>
                        </div>
                        <div class="cmc-qr" role="button" tabindex="0" aria-label="@L.T("Agrandir le QR code du membre")" @onclick="() => OpenQrPreview(user, memberCode)" @onkeydown="OnQrKeyDown">
                            <div class="cmc-qr-img"><img src="@QrPngCached(user, memberCode)" alt="@L.T("QR code de la fiche contact du membre")" /></div>
                            <span>@L.T("Scanner pour identifier le membre")</span>
                        </div>
                    </div>
                </div>
                <div class="cmc-face cmc-back">
                    <span class="cmc-wave cmc-wave-back" aria-hidden="true"></span>
                    <div class="cmc-back-head">
                        <img class="cmc-logo" src="@Root.LogoOuDefaut(Store.Settings.Logo)" alt="" />
                        <strong>@Store.Settings.AppName</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Store.Settings.CarteCitation))
                    {
                        <blockquote class="cmc-quote">@Store.Settings.CarteCitation</blockquote>
                    }
                    <p class="cmc-usage">@L.T("Carte personnelle et non transférable. Elle doit être présentée lors des activités de la communauté. En cas de perte ou de vol, veuillez en informer l'administration.")</p>
                    @if (user.EstMineur)
                    {
                        var (respNom, respTel) = Store.ResponsableAffiche(user);
                        <p class="cmc-guardian"><span>@L.T("Responsable légal")</span> @(string.IsNullOrWhiteSpace(respNom) ? L.T("non renseigné") : respNom)@(string.IsNullOrWhiteSpace(respTel) ? "" : " · " + respTel)</p>
                    }
                    <div class="cmc-back-foot">
                        @if (!string.IsNullOrWhiteSpace(memberCode))
                        {
                            <div class="cmc-field"><span>@L.T("N° de membre")</span><strong>@memberCode</strong></div>
                        }
                        <div class="cmc-sign">
                            <span>@L.T("Signature du membre")</span>
                            @if (!string.IsNullOrWhiteSpace(user.Signature))
                            {
                                <img src="@user.Signature" alt="@L.T("Signature du membre")" />
                            }
                            else
                            {
                                <div class="cmc-sign-line" aria-hidden="true"></div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-actions no-print" style="margin-top:12px">
            <button class="btn btn-secondary" @onclick="() => _showBack = !_showBack">@(_showBack ? L.T("↺ Face avant") : L.T("↻ Voir le dos"))</button>
            <button class="btn btn-primary" @onclick="() => ExportPdfAsync(false)" disabled="@_exporting">@(_exporting ? L.T("Export…") : L.T("⤓ Exporter en PDF"))</button>
            <button class="btn btn-secondary" @onclick="() => ExportPdfAsync(true)" disabled="@_exporting">@L.T("🖨 Planche A4 à découper")</button>
        </div>
        <p class="muted no-print" style="font-size:12.5px">@L.T("Le même QR code sert à pointer la présence aux réunions (menu « Présence et réunions »).")</p>
        <p class="muted no-print" style="font-size:12.5px">@L.F("Le QR code contient la fiche contact (vCard) lisible par tout lecteur. « Exporter en PDF » donne 2 pages (recto, verso) à la taille réelle du badge ({0} × {1} mm), pour une imprimante de cartes. « Planche A4 » place le recto et le verso côte à côte sur une feuille A4 : imprimez à 100 % (taille réelle), découpez, pliez au milieu puis plastifiez ou glissez dans un porte-badge.", MmTexte(CardWidthMm), MmTexte(CardHeightMm))</p>
    }
    else
    {
        <EmptyState Icon="🪪" Title="@L.T("Aucun membre")" Message="@L.T("Ajoutez d'abord un utilisateur.")" />
    }

    <Modal Title="@L.T("QR code — fiche contact")" Show="_qrPreview != null" OnClose="() => _qrPreview = null">
        <ChildContent>
            @if (_qrPreview != null)
            {
                <div class="qr-preview-wrap">
                    <img class="qr-preview-img" src="@_qrPreview" alt="@L.T("QR code agrandi de la fiche contact")" />
                    <p class="muted" style="text-align:center;margin-bottom:0">@_qrPreviewTitle</p>
                </div>
            }
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-primary" @onclick="() => _qrPreview = null">@L.T("Fermer")</button>
        </FooterContent>
    </Modal>
}

@code {
    private string _selectedIdent = "";
    private bool _exporting;
    private bool _showBack;
    private string? _qrPreview;
    private string _qrPreviewTitle = "";

    private UserAccount? Current
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_selectedIdent))
            {
                var direct = Store.FindUserByIdentifier(_selectedIdent);
                if (direct != null) return direct;
            }
            var me = Store.GetCurrentUser();
            if (me != null) return me;
            return Store.Users.FirstOrDefault();
        }
    }

    protected override void OnInitialized()
    {
        Store.DataChanged += Refresh;
        var pending = State.PendingCarteIdent;
        if (!string.IsNullOrWhiteSpace(pending) && Store.FindUserByIdentifier(pending) != null)
        {
            _selectedIdent = pending;
            State.ConsumePendingCarte();
        }
        else
        {
            _selectedIdent = Store.GetCurrentUser()?.Identifiant ?? Store.Users.FirstOrDefault()?.Identifiant ?? "";
        }
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Matricule du membre, ou null si non renseigné (aucun code généré).</summary>
    private static string? MemberCode(UserAccount user)
        => string.IsNullOrWhiteSpace(user.Matricule) ? null : user.Matricule.Trim();

    private static string Initials(UserAccount u)
    {
        var p = (u.Prenom ?? "").Trim();
        var n = (u.Nom ?? "").Trim();
        var s = (p.Length > 0 ? p[0].ToString() : "") + (n.Length > 0 ? n[0].ToString() : "");
        return string.IsNullOrWhiteSpace(s) ? "?" : s.ToUpperInvariant();
    }

    /// <summary>
    /// QR code en PNG (data URL) — plus fiable à scanner qu'un SVG : pixels nets,
    /// correction d'erreur élevée (Q) et marge calme blanche (drawQuietZones).
    /// </summary>
    private string QrPng(UserAccount user, string? code, int pixelsPerModule = 8)
    {
        try
        {
            using var gen = new QRCoder.QRCodeGenerator();
            var data = gen.CreateQrCode(Store.VCardMembre(user), QRCoder.QRCodeGenerator.ECCLevel.Q);
            using var png = new QRCoder.PngByteQRCode(data);
            return "data:image/png;base64," + Convert.ToBase64String(png.GetGraphic(pixelsPerModule));
        }
        catch { return ""; }
    }

    private string _qrCacheKey = "";
    private string _qrCacheValue = "";

    /// <summary>QR mémoïsé pour le rendu : régénéré uniquement quand le membre affiché change,
    /// au lieu d'être recalculé (QRCoder + base64) à chaque rendu.</summary>
    private string QrPngCached(UserAccount user, string? code)
    {
        var key = user.Id + "|" + (code ?? "");
        if (key != _qrCacheKey)
        {
            _qrCacheKey = key;
            _qrCacheValue = QrPng(user, code);
        }
        return _qrCacheValue;
    }

    private void OpenQrPreview(UserAccount user, string? code)
    {
        _qrPreviewTitle = string.IsNullOrWhiteSpace(code) ? user.NomComplet : user.NomComplet + " — " + code;
        _qrPreview = QrPng(user, code, 16);
    }

    private void OnQrKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " " && Current != null)
            OpenQrPreview(Current, MemberCode(Current));
    }

    private async Task ExportPdfAsync(bool planche)
    {
        if (Current == null) return;
        _exporting = true;
        try
        {
            var user = Current;
            var fileName = "carte-membre-" + user.Identifiant + (planche ? "-a4" : "") + ".pdf";
            // Badge : une page PDF par face, à la taille réelle réglée dans les paramètres
            // (défaut : format carte bancaire 85,6 × 54 mm). Planche : une feuille A4.
            var pages = planche ? new[] { BuildPlancheHtml() } : new[] { BuildCardFrontHtml(), BuildCardBackHtml() };
            var (largeur, hauteur) = planche ? (A4LargeurMm, A4HauteurMm) : (CardWidthMm, CardHeightMm);
            var path = await Saver.SaveHtmlAsPdfAsync(fileName, pages, MmToPt(largeur), MmToPt(hauteur));
            if (path == null)
                State.NotifyError(L.T("Échec de l'export PDF de la carte."));
            else
                State.NotifySuccess(L.T("Carte prête : choisissez « Enregistrer au format PDF » dans la fenêtre d'impression."));
        }
        finally { _exporting = false; }
    }

    /// <summary>Taille réelle de la carte à l'impression (mm, réglable en paramètres).</summary>
    private double CardWidthMm => Store.Settings.CarteTailleMm.Largeur;
    private double CardHeightMm => Store.Settings.CarteTailleMm.Hauteur;

    private const double A4LargeurMm = 210, A4HauteurMm = 297;

    private static string MmTexte(double mm) => mm.ToString("0.#", System.Globalization.CultureInfo.CurrentCulture);

    private static string Css(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private static double MmToPt(double mm) => mm * 72.0 / 25.4;

    /// <summary>Logo de la carte imprimée : adresse complète, la fenêtre d'impression n'a pas l'adresse du site.</summary>
    private string LogoPourImpression => string.IsNullOrWhiteSpace(Store.Settings.Logo)
        ? Nav.ToAbsoluteUri(Root.LogoParDefaut).ToString()
        : Store.Settings.Logo;

    private string BuildCardFrontHtml() => CardDocHead() + CardFrontBody() + "</body></html>";

    private string BuildCardBackHtml() => CardDocHead() + CardBackBody() + "</body></html>";

    /// <summary>
    /// Feuille A4 : recto et verso côte à côte à taille réelle, séparés par la ligne de
    /// pliage, avec des traits de coupe aux coins pour découper au massicot ou aux ciseaux.
    /// </summary>
    private string BuildPlancheHtml()
    {
        var w = Css(CardWidthMm);
        var h = Css(CardHeightMm);
        var style = "<style>"
            + ".sheet{width:210mm;padding-top:20mm;display:flex;flex-direction:column;align-items:center;color:#41506b}"
            + ".pair{position:relative;display:flex}"
            + ".slot{width:" + w + "mm;height:" + h + "mm}"
            // Coins droits : la carte se découpe et se plie au ras du bord.
            + ".slot .card{border-radius:0}"
            + ".fold{position:absolute;left:50%;top:-6mm;bottom:-6mm;border-left:.3mm dashed #8a94a6}"
            + ".mark{position:absolute;background:#41506b}"
            + ".mh{width:5mm;height:.2mm}.mv{width:.2mm;height:5mm}"
            + ".tips{margin-top:12mm;font-size:10pt;line-height:1.5;max-width:" + Css(CardWidthMm * 2) + "mm}"
            + ".tips strong{color:#0b2a6b}"
            + "</style>";
        // Traits de coupe : 4 coins du rectangle recto + verso, décalés de 2 mm.
        var marks = new System.Text.StringBuilder();
        foreach (var (x, y) in new[] { ("0", "0"), ("100%", "0"), ("0", "100%"), ("100%", "100%") })
        {
            var dx = x == "0" ? "-7mm" : "2mm";
            var dy = y == "0" ? "-7mm" : "2mm";
            marks.Append("<span class=\"mark mh\" style=\"left:calc(" + x + " + " + dx + ");top:" + y + "\"></span>");
            marks.Append("<span class=\"mark mv\" style=\"left:" + x + ";top:calc(" + y + " + " + dy + ")\"></span>");
        }
        return CardDocHead() + style
            + "<div class=\"sheet\"><div class=\"pair\">"
            + "<div class=\"slot\">" + CardFrontBody() + "</div>"
            + "<div class=\"slot\">" + CardBackBody() + "</div>"
            + "<span class=\"fold\"></span>" + marks + "</div>"
            + "<div class=\"tips\"><strong>" + H(L.F("Badge {0} × {1} mm", MmTexte(CardWidthMm), MmTexte(CardHeightMm))) + "</strong><br />"
            + H(L.T("1. Imprimez à 100 % (taille réelle), sans « Ajuster à la page »."))+ "<br />"
            + H(L.T("2. Découpez le rectangle en suivant les traits de coupe."))+ "<br />"
            + H(L.T("3. Pliez sur le pointillé, dos contre dos, puis plastifiez ou glissez dans un porte-badge."))
            + "</div></div></body></html>";
    }

    private string CardDocHead()
    {
        var user = Current!;
        // Gabarit réservé au PDF : la carte remplit toute la largeur du rendu avec le
        // ratio exact configuré (défaut 85,6 × 54 mm). Le bitmap a donc le même ratio que
        // la page PDF et la carte y tient à taille réelle. Les dimensions internes sont
        // en cqw (proportionnelles à la carte, repli px pour les moteurs anciens).
        var ratio = Css(CardWidthMm) + "/" + Css(CardHeightMm);
        return "<!DOCTYPE html><html lang=\"" + L.Langue + "\"><head><meta charset=\"utf-8\" />"
            + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />"
            + "<title>" + H(L.F("Carte de membre — {0}", user.NomComplet)) + "</title>"
            + "<style>"
            + "*{box-sizing:border-box}"
            + "html,body{margin:0;padding:0}"
            + "body{font-family:'Segoe UI',system-ui,sans-serif;background:#fff}"
            + ".card{position:relative;overflow:hidden;width:100%;height:100%;margin:0;aspect-ratio:" + ratio + ";container-type:inline-size;"
            + "padding:22px 24px;padding:4.2cqw 4.6cqw;border-radius:26px;border-radius:5cqw;color:#fff;"
            + "background:linear-gradient(135deg,#0b2a6b 0%,#1e4fb0 55%,#4f9de0 100%)}"
            + ".card.back{background:linear-gradient(135deg,#f6f9ff 0%,#e3edff 100%);color:#0b2a6b}"
            + ".wave{position:absolute;right:-70px;top:-70px;right:-13.5cqw;top:-13.5cqw;width:240px;height:240px;width:46cqw;height:46cqw;border-radius:50%;background:rgba(255,255,255,.12)}"
            + ".leaf{position:absolute;left:-20px;bottom:-26px;left:-3.8cqw;bottom:-5cqw;width:150px;height:150px;width:29cqw;height:29cqw;color:rgba(255,255,255,.18)}"
            + ".head{display:flex;align-items:center;gap:12px;gap:2.3cqw;margin-bottom:16px;margin-bottom:3cqw;position:relative}"
            + ".logo{width:46px;height:46px;width:8.8cqw;height:8.8cqw;border-radius:14px;border-radius:2.7cqw;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-weight:800;overflow:hidden;flex:0 0 auto;aspect-ratio:1/1}"
            + ".logo img{width:100%;height:100%;object-fit:cover;display:block}"
            + ".brand strong{display:block;font-size:16px;font-size:3.1cqw;overflow-wrap:anywhere}.brand span{font-size:12px;font-size:2.3cqw;opacity:.85;overflow-wrap:anywhere}"
            + ".body{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;gap:3.5cqw;position:relative;align-items:center;max-width:100%}"
            + ".id{display:flex;gap:14px;gap:2.7cqw;align-items:center;min-width:0;max-width:100%}"
            + ".idtext{min-width:0;flex:1 1 auto;max-width:100%}"
            + ".photo{width:104px;min-width:104px;width:20cqw;min-width:20cqw;height:104px;height:20cqw;aspect-ratio:1/1;border-radius:50%;overflow:hidden;background:#fff;border:3px solid rgba(255,255,255,.65);display:flex;align-items:center;justify-content:center;font-size:34px;font-size:6.5cqw;font-weight:800;color:#1e4fb0;flex:0 0 auto}"
            + ".photo img{width:100%;height:100%;object-fit:cover;display:block;aspect-ratio:1/1}"
            + ".name{font-size:20px;font-size:3.85cqw;font-weight:800;line-height:1.15;overflow-wrap:anywhere;max-width:100%}"
            + ".status{display:inline-flex;align-items:center;gap:6px;gap:1.2cqw;font-size:11.5px;font-size:2.2cqw;font-weight:700;background:rgba(255,255,255,.2);border-radius:999px;padding:3px 10px;padding:.6cqw 1.9cqw;margin:6px 0;margin:1.2cqw 0;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}"
            + ".dot{width:7px;height:7px;min-width:7px;width:1.35cqw;height:1.35cqw;min-width:1.35cqw;border-radius:50%;background:#7ef0a8;flex:0 0 auto}"
            + ".field{font-size:12.5px;font-size:2.4cqw;margin-top:4px;margin-top:.8cqw;overflow-wrap:anywhere;max-width:100%}.field span{display:block;opacity:.75;font-size:10.5px;font-size:2cqw;text-transform:uppercase;letter-spacing:.06em}"
            + ".qr{background:#fff;border-radius:16px;border-radius:3.1cqw;padding:10px;padding:1.9cqw;text-align:center;flex:0 0 auto}"
            + ".qr svg,.qr img{width:120px;height:120px;width:23cqw;height:23cqw;aspect-ratio:1/1;display:block;object-fit:contain}"
            + ".qr span{display:block;font-size:9.5px;font-size:1.8cqw;color:#0b2a6b;font-weight:600;margin-top:6px;margin-top:1.2cqw;max-width:120px;max-width:23cqw}"
            + ".back .head{border-bottom:1px solid rgba(11,42,107,.12);padding-bottom:12px;padding-bottom:2.3cqw;margin-bottom:10px;margin-bottom:1.9cqw}"
            + ".back .logo{background:#0b2a6b;color:#fff}"
            + ".quote{font-style:italic;font-size:14px;font-size:2.7cqw;margin:8px 0 10px;margin:1.5cqw 0 1.9cqw;padding-left:14px;padding-left:2.7cqw;border-left:3px solid #4f9de0;color:#123a86;overflow-wrap:anywhere}"
            + ".usage{font-size:11.5px;font-size:2.2cqw;line-height:1.5;color:#41506b;margin:0}"
            + ".foot{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;gap:3.5cqw;position:absolute;left:24px;right:24px;left:4.6cqw;right:4.6cqw;bottom:22px;bottom:4.2cqw}"
            + ".sign span{display:block;font-size:10.5px;font-size:2cqw;text-transform:uppercase;letter-spacing:.06em;color:#41506b;margin-bottom:4px;margin-bottom:.8cqw}"
            + ".sign img{max-width:150px;max-height:60px;max-width:29cqw;max-height:11.5cqw}"
            + ".minor{display:inline-block;margin-left:6px;padding:1px 7px;border-radius:999px;background:#fef3c7;color:#92400e;font-size:10px;font-weight:700}"
            + ".guardian{margin:4px 0 0;font-size:11px;color:#0b2a6b}.guardian span{font-weight:700;margin-right:4px}"
            + ".signline{border-bottom:1.5px solid #0b2a6b;width:150px;width:29cqw;height:38px;height:7.3cqw}"
            + "</style></head><body>";
    }

    private string CardFrontBody()
    {
        var user = Current!;
        var memberCode = MemberCode(user);
        var logo = LogoPourImpression;
        var appName = Store.Settings.AppName;
        var slogan = Store.Settings.CarteSlogan;
        var photo = user.Photo ?? "";
        return "<div class=\"card\"><span class=\"wave\"></span>"
            + "<svg class=\"leaf\" viewBox=\"0 0 120 120\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M12 108C12 60 52 20 108 12c-4 56-44 96-96 96z\"/><path d=\"M108 12C76 34 48 62 24 96\"/></svg>"
            + "<div class=\"head\"><div class=\"logo\">" + "<img src=\"" + logo + "\" alt=\"\" />" + "</div>"
            + "<div class=\"brand\"><strong>" + H(appName) + "</strong><span>" + H(slogan) + "</span></div></div>"
            + "<div class=\"body\"><div class=\"id\"><div class=\"photo\">" + (string.IsNullOrWhiteSpace(photo) ? H(Initials(user)) : "<img src=\"" + photo + "\" alt=\"\" />") + "</div>"
            + "<div class=\"idtext\"><div class=\"name\">" + H(user.NomComplet) + "</div>"
            + "<div class=\"status\"><span class=\"dot\"></span>" + H(user.Actif ? L.T("Membre actif") : L.T("Carte suspendue")) + (user.EstMineur ? "<span class=\"minor\">" + H(L.T("Mineur")) + "</span>" : "") + "</div>"
            + (string.IsNullOrWhiteSpace(memberCode) ? "" : "<div class=\"field\"><span>" + H(L.T("Matricule")) + "</span>" + H(memberCode) + "</div>")
            + "<div class=\"field\"><span>" + H(L.T("Adhésion")) + "</span>" + H(DataStore.FormatDateCourte(user.DateCreation)) + "</div></div></div>"
            + "<div class=\"qr\"><img src=\"" + QrPng(user, memberCode) + "\" alt=\"" + H(L.T("QR code de la fiche contact")) + "\" /><span>" + H(L.T("Scanner pour identifier le membre")) + "</span></div></div></div>";
    }

    private string CardBackBody()
    {
        var user = Current!;
        var memberCode = MemberCode(user);
        var logo = LogoPourImpression;
        var appName = Store.Settings.AppName;
        var citation = Store.Settings.CarteCitation;
        var signature = user.Signature ?? "";
        var resp = Store.ResponsableAffiche(user);
        return "<div class=\"card back\"><span class=\"wave\" style=\"background:rgba(30,79,176,.08)\"></span>"
            + "<div class=\"head\"><div class=\"logo\">" + "<img src=\"" + logo + "\" alt=\"\" />" + "</div>"
            + "<div class=\"brand\"><strong>" + H(appName) + "</strong></div></div>"
            + (string.IsNullOrWhiteSpace(citation) ? "" : "<blockquote class=\"quote\">" + H(citation) + "</blockquote>")
            + "<p class=\"usage\">" + H(L.T("Carte personnelle et non transférable. Elle doit être présentée lors des activités de la communauté. En cas de perte ou de vol, veuillez en informer l'administration.")) + "</p>"
            + (user.EstMineur ? "<p class=\"guardian\"><span>" + H(L.T("Responsable légal")) + "</span> " + H(string.IsNullOrWhiteSpace(resp.Nom) ? L.T("non renseigné") : resp.Nom) + (string.IsNullOrWhiteSpace(resp.Telephone) ? "" : " · " + H(resp.Telephone)) + "</p>" : "")
            + "<div class=\"foot\">" + (string.IsNullOrWhiteSpace(memberCode) ? "" : "<div class=\"field\"><span>" + H(L.T("N° de membre")) + "</span><strong>" + H(memberCode) + "</strong></div>")
            + "<div class=\"sign\"><span>" + H(L.T("Signature du membre")) + "</span>" + (string.IsNullOrWhiteSpace(signature) ? "<div class=\"signline\"></div>" : "<img src=\"" + signature + "\" alt=\"\" />") + "</div></div></div>";
    }

    private static string H(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");

    public void Dispose() => Store.DataChanged -= Refresh;
}
