@implements IDisposable
@inject DataStore Store
@inject AppState State
@inject IJSRuntime Js

@if (!Store.Can(Permissions.MessagerieUse))
{
    <EmptyState Icon="🔒" Title="@L.T("Accès réservé")" Message="@L.T("La messagerie interne n'est pas autorisée pour votre rôle.")" />
}
else if (_conversation == null)
{
    <div class="page-head">
        <p>@L.T("Messagerie de la communauté : vos messages vous suivent sur tous vos appareils.")</p>
    </div>
    <div class="form-actions" style="margin-bottom:10px">
        <button class="btn btn-primary btn-sm" @onclick="ShowNewMessage">✉ @L.T("Nouveau message")</button>
        <button class="btn btn-secondary btn-sm" @onclick="ShowNouveauGroupe">👥 @L.T("Nouveau groupe")</button>
        <button class="btn btn-secondary btn-sm" @onclick="ShowAnnonce">📢 @L.T("Annonce")</button>
    </div>
    <div class="search-box cal-search">
        <span class="search-icon" aria-hidden="true">&#128269;</span>
        <input type="search" placeholder="@L.T("Rechercher une conversation (membre, annonce, texte)…")" aria-label="@L.T("Rechercher une conversation")"
               value="@_search" @oninput="OnSearch" />
    </div>
    @if (!string.IsNullOrWhiteSpace(_search))
    {
        <div class="search-summary">@L.F("{0} conversation(s) trouvée(s) pour « {1} »", VisibleConversations.Count, _search.Trim())</div>
    }
    @if (_conversations.Count == 0)
    {
        <EmptyState Icon="✉" Title="@L.T("Aucun message")" Message="@L.T("Écrivez le premier message ou publiez une annonce.")" />
    }
    else if (VisibleConversations.Count == 0)
    {
        <EmptyState Icon="✉" Title="@L.T("Aucun résultat")" Message="@L.T("Aucune conversation ne correspond à cette recherche.")" />
    }
    else
    {
        <div class="conv-list">
            @foreach (var conv in VisibleConversations)
            {
                var cid = conv.ConversationId;
                var dernier = conv.Dernier;
                var nonLus = conv.NonLus;
                <button type="button" class="conv-item @(nonLus > 0 ? "conv-unread" : "")" @onclick="() => OpenConversation(cid)">
                    @ConversationAvatar(cid)
                    <span class="conv-main">
                        <span class="conv-top">
                            <span class="conv-title">@ConversationTitle(cid)</span>
                            <span class="conv-time">@DateCourteMessage(dernier.Date)</span>
                        </span>
                        <span class="conv-bottom">
                            <span class="conv-preview">@AperçuMessage(cid, dernier)</span>
                            @if (nonLus > 0) { <span class="conv-badge" aria-label="@L.F("{0} non lu(s)", nonLus)">@nonLus</span> }
                        </span>
                    </span>
                </button>
            }
        </div>
    }
    <button class="fab" aria-label="@L.T("Écrire un nouveau message")" @onclick="ShowNewMessage">+</button>
}
else
{
    var participants = Store.ParticipantsConversation(_conversation);
    var aPlusieurs = _conversation != DataStore.ConversationAnnonces && participants.Count >= 3;
    var peutAjouter = Store.PeutAjouterAConversation(_conversation);
    var peutRenommer = Store.PeutRenommerConversation(_conversation);
    <div class="chat-head">
        <button type="button" class="chat-back" aria-label="@L.T("Retour aux conversations")" title="@L.T("Conversations")" @onclick="CloseConversation">‹</button>
        @ConversationAvatar(_conversation)
        <div class="chat-head-text">
            <div class="chat-title">@ConversationTitle(_conversation)</div>
            <div class="chat-sub">@ConversationSousTitre(_conversation, participants)</div>
        </div>
        <div class="chat-menu-wrap">
            <button type="button" class="chat-menu-btn" aria-label="@L.T("Options de la conversation")" aria-expanded="@_menuConv" @onclick="() => _menuConv = !_menuConv">⋮</button>
            @if (_menuConv)
            {
                <div class="chat-menu-backdrop" @onclick="() => _menuConv = false"></div>
                <div class="chat-menu" role="menu">
                    @if (aPlusieurs)
                    {
                        <button type="button" role="menuitem" @onclick="() => { _menuConv = false; _voirMembres = true; }">👥 @L.F("Participants ({0})", participants.Count)</button>
                    }
                    @if (peutAjouter)
                    {
                        <button type="button" role="menuitem" @onclick="() => { _menuConv = false; OuvrirAjout(); }">➕ @L.T("Ajouter des membres")</button>
                    }
                    @if (peutRenommer)
                    {
                        <button type="button" role="menuitem" @onclick="() => { _menuConv = false; OuvrirRenommer(); }">✏️ @L.T("Renommer la conversation")</button>
                    }
                    <button type="button" role="menuitem" class="danger" @onclick="() => { _menuConv = false; _supprimerConv = true; }">🗑 @L.T("Supprimer la conversation")</button>
                </div>
            }
        </div>
    </div>
    <div class="msg-thread" id="msg-thread">
        @if (_messages.Count == 0)
        {
            <div class="chat-empty">@L.T("Aucun message pour l'instant. Écrivez le premier !")</div>
        }
        @{
            string? jourPrecedent = null;
            string? auteurPrecedent = null;
        }
        @foreach (var m in _messages)
        {
            var mine = m.Expediteur.Equals(Me, StringComparison.OrdinalIgnoreCase);
            var jour = JourMessage(m.Date);
            if (jour != jourPrecedent)
            {
                <div class="chat-day"><span>@jour</span></div>
                jourPrecedent = jour;
                auteurPrecedent = null;
            }
            var suite = auteurPrecedent != null && auteurPrecedent.Equals(m.Expediteur, StringComparison.OrdinalIgnoreCase);
            auteurPrecedent = m.Supprime || m.Info ? null : m.Expediteur;
            @if (m.Info && !m.Supprime)
            {
                <div class="msg-info">@m.Texte · @HeureMessage(m.Date)</div>
            }
            else if (m.Supprime)
            {
                <div class="msg-bubble msg-deleted">
                    🗑 @L.T("Message supprimé") · @HeureMessage(string.IsNullOrWhiteSpace(m.SupprimeLe) ? m.Date : m.SupprimeLe)
                </div>
            }
            else
            {
                var choisi = _choisi == m.Id;
                var peutModifier = Store.CanEditMessage(m.Id);
                var peutSupprimer = mine || Store.IsAdmin;
                <div class="msg-row @(mine ? "msg-row-mine" : "msg-row-theirs") @(suite ? "msg-suite" : "")">
                    @if (!mine && (aPlusieurs || _conversation == DataStore.ConversationAnnonces))
                    {
                        @if (suite)
                        {
                            <span class="msg-avatar-space" aria-hidden="true"></span>
                        }
                        else
                        {
                            var auteur = Store.FindUserByIdentifier(m.Expediteur);
                            <Avatar UserName="@(auteur?.NomComplet ?? m.Expediteur)" Seed="@m.Expediteur" Size="sm" Photo="@auteur?.Photo" />
                        }
                    }
                    <div class="msg-bubble @(mine ? "msg-mine" : "msg-theirs") @(choisi ? "msg-choisi" : "")"
                         @onclick="() => _choisi = choisi ? null : m.Id">
                        @if (!mine && !suite && (aPlusieurs || _conversation == DataStore.ConversationAnnonces))
                        {
                            <div class="msg-author">@NomAuteur(m.Expediteur)</div>
                        }
                        <div class="msg-text">@m.Texte</div>
                        <div class="msg-time">@(string.IsNullOrWhiteSpace(m.DateModification) ? "" : L.T("modifié") + " · ")@HeureMessage(m.Date)</div>
                    </div>
                </div>
                @if (choisi && (peutModifier || peutSupprimer))
                {
                    <div class="msg-tools @(mine ? "msg-tools-mine" : "")">
                        @if (peutModifier)
                        {
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => AskEdit(m)">✏️ @L.T("Modifier")</button>
                        }
                        @if (peutSupprimer)
                        {
                            <button type="button" class="btn btn-danger-outline btn-sm" @onclick="() => AskDelete(m)">🗑 @L.T("Supprimer")</button>
                        }
                    </div>
                }
            }
        }
    </div>
    <div id="msg-fin"></div>
    <div class="msg-reply">
        <input type="text" placeholder="@L.T("Écrire un message…")" aria-label="@L.T("Répondre")"
               value="@_reply" @oninput="e => _reply = e.Value?.ToString() ?? string.Empty" @onkeydown="OnReplyKey" />
        <button class="msg-send" aria-label="@L.T("Envoyer")" title="@L.T("Envoyer")" @onclick="SendReply" disabled="@string.IsNullOrWhiteSpace(_reply)">➤</button>
    </div>
}

<Modal Title="@L.T("Participants")" Show="_voirMembres" OnClose="() => _voirMembres = false">
    <ChildContent>
        @if (_conversation != null)
        {
            <div class="chat-members">
                @foreach (var p in Store.ParticipantsConversation(_conversation))
                {
                    var u = Store.FindUserByIdentifier(p);
                    <div class="chat-member">
                        <Avatar UserName="@(u?.NomComplet ?? p)" Seed="@p" Size="sm" Photo="@u?.Photo" />
                        <span>@(u?.NomComplet ?? p)@(p.Equals(Me, StringComparison.OrdinalIgnoreCase) ? " (" + L.T("vous") + ")" : "")</span>
                    </div>
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        @if (_conversation != null && Store.PeutAjouterAConversation(_conversation))
        {
            <button class="btn btn-secondary" @onclick="() => { _voirMembres = false; OuvrirAjout(); }">➕ @L.T("Ajouter des membres")</button>
        }
        <button class="btn btn-primary" @onclick="() => _voirMembres = false">@L.T("Fermer")</button>
    </FooterContent>
</Modal>

<Modal Title="@(_annonce ? L.T("Publier une annonce") : _groupe ? L.T("Nouveau groupe") : L.T("Nouveau message"))" Show="_showNew" OnClose="() => _showNew = false">
    <ChildContent>
        @if (_groupe)
        {
            <div class="form-group">
                <label for="msg-grp-nom">@L.T("Nom du groupe *")</label>
                <input id="msg-grp-nom" type="text" maxlength="80" placeholder="@L.T("Ex : Comité de la kermesse")"
                       value="@_nomGroupe" @oninput="e => _nomGroupe = e.Value?.ToString() ?? string.Empty" />
            </div>
        }
        @if (!_annonce)
        {
            <div class="form-group">
                <label>@(_groupe ? L.T("Membres du groupe") : L.T("Destinataires"))</label>
                <div class="search-box cal-search cal-opt-search">
                    <span class="search-icon" aria-hidden="true">&#128269;</span>
                    <input type="search" placeholder="@L.T("Écrire pour chercher un membre…")" aria-label="@L.T("Chercher un membre")"
                           value="@_destSearch" @oninput="e => _destSearch = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="check-group">
                    @foreach (var u in FilteredDest)
                    {
                        <label class="form-check">
                            <input type="checkbox" checked="@_dest.Contains(u.Identifiant)" @onchange="() => ToggleDest(u.Identifiant)" />
                            @u.NomComplet <span class="text-muted" style="font-size:12px">@@@u.Identifiant</span>
                        </label>
                    }
                    @if (FilteredDest.Count == 0)
                    {
                        <div class="cal-no-events">@L.F("Aucun membre trouvé pour « {0} ».", _destSearch)</div>
                    }
                </div>
                <span class="field-hint">@(_groupe ? L.F("{0} membre(s) choisi(s), au moins deux.", _dest.Count) : L.T("Sans destinataire : le message part en annonce (tout le monde)."))</span>
            </div>
        }
        else
        {
            <p class="muted" style="margin-top:0">📢 @L.T("Visible par tous les membres.")</p>
        }
        <div class="form-group">
            <label for="msg-new-text">@L.T("Message *")</label>
            <textarea id="msg-new-text" rows="3" value="@_newTexte" @oninput="e => _newTexte = e.Value?.ToString() ?? string.Empty"></textarea>
        </div>
        <span class="form-error">@_newError</span>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _showNew = false">@L.T("Annuler")</button>
        <button class="btn btn-primary" @onclick="SendNew">@L.T("Envoyer")</button>
    </FooterContent>
</Modal>

<Modal Title="@L.T("Renommer la conversation")" Show="_renommer" OnClose="() => _renommer = false">
    <ChildContent>
        <div class="form-group">
            <label for="msg-conv-nom">@L.T("Nom de la conversation")</label>
            <input id="msg-conv-nom" type="text" maxlength="80" placeholder="@L.T("Ex : Comité de la kermesse")"
                   value="@_nouveauNom" @oninput="e => _nouveauNom = e.Value?.ToString() ?? string.Empty" />
            <span class="field-hint">@L.T("Le nom est visible par tous les participants.")</span>
        </div>
        <span class="form-error">@_renommerErreur</span>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _renommer = false">@L.T("Annuler")</button>
        <button class="btn btn-primary" @onclick="Renommer">@L.T("Enregistrer")</button>
    </FooterContent>
</Modal>

<Modal Title="@L.T("Ajouter des membres")" Show="_ajout" OnClose="() => _ajout = false">
    <ChildContent>
        <div class="search-box cal-search cal-opt-search">
            <span class="search-icon" aria-hidden="true">&#128269;</span>
            <input type="search" placeholder="@L.T("Écrire pour chercher un membre…")" aria-label="@L.T("Chercher un membre")"
                   value="@_destSearch" @oninput="e => _destSearch = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="check-group">
            @foreach (var u in AjoutPossibles)
            {
                <label class="form-check">
                    <input type="checkbox" checked="@_dest.Contains(u.Identifiant)" @onchange="() => ToggleDest(u.Identifiant)" />
                    @u.NomComplet <span class="text-muted" style="font-size:12px">@@@u.Identifiant</span>
                </label>
            }
            @if (AjoutPossibles.Count == 0)
            {
                <div class="cal-no-events">@L.T("Aucun autre membre à ajouter.")</div>
            }
        </div>
        <span class="field-hint">@L.T("Les membres ajoutés reçoivent les messages à partir de maintenant, sans l'historique.")</span>
        <span class="form-error">@_ajoutErreur</span>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _ajout = false">@L.T("Annuler")</button>
        <button class="btn btn-primary" disabled="@(_dest.Count == 0)" @onclick="Ajouter">@L.F("Ajouter ({0})", _dest.Count)</button>
    </FooterContent>
</Modal>

<Modal Title="@L.T("Supprimer la conversation")" Show="_supprimerConv" OnClose="() => _supprimerConv = false">
    <ChildContent>
        <p style="margin-top:0">@L.T("La conversation disparaît de votre liste. Elle reviendra si quelqu'un y écrit de nouveau, avec les nouveaux messages seulement.")</p>
        @if (Store.IsAdmin)
        {
            <p class="text-muted" style="font-size:13px">@L.T("Administrateur : « Pour tout le monde » efface définitivement tous ses messages, pour tous les participants.")</p>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _supprimerConv = false">@L.T("Annuler")</button>
        @if (Store.IsAdmin)
        {
            <button class="btn btn-danger-outline" @onclick="() => SupprimerConversation(true)">@L.T("Pour tout le monde")</button>
        }
        <button class="btn btn-danger" @onclick="() => SupprimerConversation(false)">@L.T("Supprimer pour moi")</button>
    </FooterContent>
</Modal>

<ConfirmDialog Show="_deleteTarget != null" Title="@L.T("Supprimer le message")"
               Message="@L.T("Le message sera masqué, mais un journal « Message supprimé » restera visible dans la conversation.")"
               ConfirmLabel="@L.T("Supprimer")" Danger="true" OnConfirm="ConfirmDelete" OnCancel="() => _deleteTarget = null" />

<Modal Title="@L.T("Modifier le message")" Show="_editTarget != null" OnClose="() => _editTarget = null">
    <ChildContent>
        <div class="form-group">
            <label for="msg-edit-text">@L.T("Message *")</label>
            <textarea id="msg-edit-text" rows="3" value="@_editTexte" @oninput="e => _editTexte = e.Value?.ToString() ?? string.Empty"></textarea>
        </div>
        <span class="field-hint">@L.T("Modifiable pendant 5 minutes après l'envoi.")</span>
        <span class="form-error">@_editError</span>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _editTarget = null">@L.T("Annuler")</button>
        <button class="btn btn-primary" @onclick="ConfirmEdit">@L.T("Enregistrer")</button>
    </FooterContent>
</Modal>

@code {
    private string Me => Store.GetCurrentUser()?.Identifiant ?? "";
    private List<(string ConversationId, Message Dernier, int NonLus)> _conversations = new();
    private string? _conversation;
    private List<Message> _messages = new();
    private string _reply = "";
    private string _search = "";
    private bool _showNew;
    private bool _annonce;
    private bool _groupe;
    private string _nomGroupe = "";
    private bool _supprimerConv;
    private bool _renommer;
    private string _nouveauNom = "";
    private string _renommerErreur = "";
    private bool _ajout;
    private bool _menuConv;
    private bool _voirMembres;
    /// <summary>Message touché : ses actions (modifier, supprimer) s'affichent dessous.</summary>
    private string? _choisi;
    private bool _defiler;
    private string _ajoutErreur = "";
    private HashSet<string> _dest = new();
    private string _newTexte = "";
    private string _newError = "";
    private Message? _deleteTarget;
    private Message? _editTarget;
    private string _editTexte = "";
    private string _editError = "";

    private IReadOnlyList<UserAccount> ActiveUsers =>
        Store.Users.Where(u => u.Actif).OrderBy(u => u.NomComplet).ToList();

    private string _destSearch = "";

    private List<UserAccount> FilteredDest
    {
        get
        {
            var q = _destSearch.Trim();
            var list = ActiveUsers.Where(u => !u.Identifiant.Equals(Me, StringComparison.OrdinalIgnoreCase));
            if (q.Length == 0) return list.ToList();
            return list.Where(u => (u.NomComplet + " " + u.Identifiant + " " + (u.Matricule ?? ""))
                .Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    protected override void OnInitialized()
    {
        Store.DataChanged += Refresh;
        RefreshList();
    }

    private void Refresh() => _ = InvokeAsync(() =>
    {
        RefreshList();
        if (_conversation != null) LoadThread();
        StateHasChanged();
    });

    private void RefreshList() => _conversations = Store.GetConversations(Me).ToList();

    private List<(string ConversationId, Message Dernier, int NonLus)> VisibleConversations
    {
        get
        {
            var q = _search.Trim();
            if (q.Length == 0) return _conversations;
            return _conversations.Where(c =>
                ConversationTitle(c.ConversationId).Contains(q, StringComparison.OrdinalIgnoreCase)
                || c.Dernier.Texte.Contains(q, StringComparison.OrdinalIgnoreCase)
                || c.Dernier.Expediteur.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? string.Empty;

    private void ShowNewMessage()
    {
        _showNew = true;
        _annonce = false;
        _groupe = false;
        _newTexte = "";
        _newError = "";
        _dest = new HashSet<string>();
    }

    private void ShowNouveauGroupe()
    {
        ShowNewMessage();
        _groupe = true;
        _nomGroupe = "";
    }

    private void ShowAnnonce()
    {
        _showNew = true;
        _annonce = true;
        _groupe = false;
        _newTexte = "";
        _newError = "";
        _dest = new HashSet<string>();
    }

    private void OpenConversation(string id)
    {
        _conversation = id;
        _menuConv = false;
        _choisi = null;
        _defiler = true;
        Store.MarkConversationRead(id, Me);
        LoadThread();
    }

    private void CloseConversation()
    {
        _conversation = null;
        _reply = "";
        RefreshList();
    }

    private void LoadThread()
    {
        _messages = Store.GetMessages(_conversation ?? "").ToList();
    }

    private string ConversationIcon(string cid)
        => cid == DataStore.ConversationAnnonces ? "📢"
            : Store.GroupeDeConversation(cid) != null ? "⛪"
            : DataStore.EstDiscussionDeGroupe(cid) || Store.ParticipantsConversation(cid).Count >= 3 ? "👥" : "💬";

    private string ParticipantsLabel(string cid)
        => string.Join(", ", Store.ParticipantsConversation(cid)
            .Select(p => p.Equals(Me, StringComparison.OrdinalIgnoreCase) ? L.T("vous") : Store.FindUserByIdentifier(p)?.NomComplet ?? p));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // À l'ouverture et après un envoi, la conversation s'affiche sur ses derniers messages.
        if (!_defiler || _conversation == null) return;
        _defiler = false;
        try { await Js.InvokeVoidAsync("guUi.scrollToId", "msg-fin"); } catch (JSException) { }
    }

    /// <summary>Photo de l'autre personne pour une conversation à deux, sinon une icône.</summary>
    private RenderFragment ConversationAvatar(string cid) => builder =>
    {
        var autres = Store.ParticipantsConversation(cid).Where(p => !p.Equals(Me, StringComparison.OrdinalIgnoreCase)).ToList();
        if (cid != DataStore.ConversationAnnonces && Store.GroupeDeConversation(cid) == null && autres.Count == 1)
        {
            var u = Store.FindUserByIdentifier(autres[0]);
            builder.OpenComponent<Avatar>(0);
            builder.AddAttribute(1, "UserName", u?.NomComplet ?? autres[0]);
            builder.AddAttribute(2, "Seed", autres[0]);
            builder.AddAttribute(3, "Photo", u?.Photo);
            builder.CloseComponent();
            return;
        }
        builder.OpenElement(4, "span");
        builder.AddAttribute(5, "class", "avatar conv-icon");
        builder.AddAttribute(6, "aria-hidden", "true");
        builder.AddContent(7, ConversationIcon(cid));
        builder.CloseElement();
    };

    private string ConversationSousTitre(string cid, IReadOnlyList<string> participants)
    {
        if (cid == DataStore.ConversationAnnonces) return L.T("Toute la communauté");
        if (Store.GroupeDeConversation(cid) != null) return L.F("Groupe et ministère · {0} membre(s)", participants.Count);
        if (participants.Count >= 3)
            return Store.NomDiscussion(cid).Length > 0 ? ParticipantsLabel(cid) : L.F("{0} participants", participants.Count);
        return L.T("Conversation privée");
    }

    private string NomAuteur(string identifiant)
        => Store.FindUserByIdentifier(identifiant)?.NomComplet ?? identifiant;

    private static DateTime? DateLocale(string? iso)
        => DateTimeOffset.TryParse(iso, out var d) ? d.LocalDateTime : null;

    /// <summary>Séparateur de jour dans la conversation : Aujourd'hui, Hier ou la date.</summary>
    private static string JourMessage(string? iso)
    {
        if (DateLocale(iso) is not { } d) return "";
        if (d.Date == DateTime.Today) return L.T("Aujourd'hui");
        if (d.Date == DateTime.Today.AddDays(-1)) return L.T("Hier");
        return d.ToString("dd/MM/yyyy");
    }

    private static string HeureMessage(string? iso) => DateLocale(iso)?.ToString("HH:mm") ?? "";

    /// <summary>Date du dernier message dans la liste : l'heure aujourd'hui, « Hier », sinon le jour.</summary>
    private static string DateCourteMessage(string? iso)
    {
        if (DateLocale(iso) is not { } d) return "";
        if (d.Date == DateTime.Today) return d.ToString("HH:mm");
        if (d.Date == DateTime.Today.AddDays(-1)) return L.T("Hier");
        return d.ToString("dd/MM/yy");
    }

    private string AperçuMessage(string cid, Message m)
    {
        if (m.Supprime) return "🗑 " + L.T("Message supprimé");
        if (m.Info) return m.Texte;
        var texte = Truncate(m.Texte.Replace('\n', ' '), 70);
        if (m.Expediteur.Equals(Me, StringComparison.OrdinalIgnoreCase)) return L.F("Vous : {0}", texte);
        if (cid == DataStore.ConversationAnnonces || Store.ParticipantsConversation(cid).Count >= 3)
        {
            var u = Store.FindUserByIdentifier(m.Expediteur);
            return (string.IsNullOrWhiteSpace(u?.Prenom) ? m.Expediteur : u!.Prenom) + " : " + texte;
        }
        return texte;
    }

    private string ConversationTitle(string cid)
    {
        if (cid == DataStore.ConversationAnnonces) return L.T("Annonces");
        var nom = Store.NomDiscussion(cid);
        if (nom.Length > 0) return nom;
        var names = Store.ParticipantsConversation(cid)
            .Where(p => !p.Equals(Me, StringComparison.OrdinalIgnoreCase))
            .Select(p => Store.FindUserByIdentifier(p)?.NomComplet ?? p)
            .ToList();
        return names.Count == 0 ? L.T("Discussion") : string.Join(", ", names);
    }

    private static string Truncate(string s, int max)
    {
        var v = s ?? "";
        return v.Length <= max ? v : v[..max] + "…";
    }

    private void ToggleDest(string identifiant)
    {
        if (!_dest.Add(identifiant)) _dest.Remove(identifiant);
    }

    private void SendNew()
    {
        _newError = "";
        var res = _groupe
            ? Store.CreerDiscussionDeGroupe(_nomGroupe, _dest, _newTexte)
            : Store.SendMessage(_annonce ? new List<string>() : _dest.ToList(), _newTexte);
        if (!res.Success) { _newError = res.Error; return; }
        _showNew = false;
        State.NotifySuccess(_annonce ? L.T("Annonce publiée.") : _groupe ? L.F("Groupe « {0} » créé.", _nomGroupe.Trim()) : L.T("Message envoyé."));
        RefreshList();
    }

    private void OnReplyKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SendReply();
    }

    private void SendReply()
    {
        if (_conversation == null || string.IsNullOrWhiteSpace(_reply)) return;
        var res = Store.RepondreConversation(_conversation, _reply);
        if (!res.Success) { State.NotifyError(res.Error); return; }
        _reply = "";
        _defiler = true;
        LoadThread();
    }

    private void OuvrirRenommer()
    {
        _nouveauNom = _conversation == null ? "" : Store.NomDiscussion(_conversation);
        _renommerErreur = "";
        _renommer = true;
    }

    private void Renommer()
    {
        if (_conversation == null) return;
        var res = Store.RenommerConversation(_conversation, _nouveauNom);
        if (!res.Success) { _renommerErreur = res.Error; return; }
        _renommer = false;
        State.NotifySuccess(L.T("Conversation renommée."));
        RefreshList();
    }

    /// <summary>Membres actifs qui ne sont pas encore dans la conversation ouverte.</summary>
    private List<UserAccount> AjoutPossibles
    {
        get
        {
            var deja = _conversation == null ? new List<string>() : Store.ParticipantsConversation(_conversation).ToList();
            return FilteredDest.Where(u => !u.EstDecede && !deja.Any(p => p.Equals(u.Identifiant, StringComparison.OrdinalIgnoreCase))).ToList();
        }
    }

    private void OuvrirAjout()
    {
        _dest = new HashSet<string>();
        _destSearch = "";
        _ajoutErreur = "";
        _ajout = true;
    }

    private void Ajouter()
    {
        if (_conversation == null) return;
        var (res, id) = Store.AjouterAConversation(_conversation, _dest);
        if (!res.Success) { _ajoutErreur = res.Error; return; }
        _ajout = false;
        State.NotifySuccess(L.F("{0} membre(s) ajouté(s).", _dest.Count));
        _conversation = id;
        LoadThread();
        RefreshList();
    }

    private void SupprimerConversation(bool pourTous)
    {
        _supprimerConv = false;
        if (_conversation == null) return;
        var res = Store.SupprimerConversation(_conversation, pourTous);
        if (!res.Success) { State.NotifyError(res.Error); return; }
        State.NotifySuccess(L.T("Conversation supprimée."));
        CloseConversation();
    }

    private void AskDelete(Message m) { _choisi = null; _deleteTarget = m; }

    private void ConfirmDelete()
    {
        var t = _deleteTarget;
        _deleteTarget = null;
        if (t == null) return;
        var res = Store.DeleteMessage(t.Id);
        if (res.Success) { State.NotifySuccess(L.T("Message supprimé.")); LoadThread(); RefreshList(); }
        else State.NotifyError(res.Error);
    }

    private void AskEdit(Message m)
    {
        _choisi = null;
        _editTarget = m;
        _editTexte = m.Texte;
        _editError = "";
    }

    private void ConfirmEdit()
    {
        var t = _editTarget;
        if (t == null) return;
        var res = Store.UpdateMessage(t.Id, _editTexte);
        if (!res.Success) { _editError = res.Error; return; }
        _editTarget = null;
        State.NotifySuccess(L.T("Message modifié."));
        LoadThread();
        RefreshList();
    }

    public void Dispose() => Store.DataChanged -= Refresh;
}
