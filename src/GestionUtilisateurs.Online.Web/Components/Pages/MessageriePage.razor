@implements IDisposable
@inject DataStore Store
@inject AppState State

@if (!Store.Can(Permissions.MessagerieUse))
{
    <EmptyState Icon="🔒" Title="@L.T("Accès réservé")" Message="@L.T("La messagerie interne n'est pas autorisée pour votre rôle.")" />
}
else if (_conversation == null)
{
    <div class="page-head">
        <p>@L.T("Messagerie de la communauté : vos messages vous suivent sur tous vos appareils.")</p>
    </div>
    <div class="form-actions" style="margin-bottom:10px">
        <button class="btn btn-primary btn-sm" @onclick="ShowNewMessage">✉ @L.T("Nouveau message")</button>
        <button class="btn btn-secondary btn-sm" @onclick="ShowNouveauGroupe">👥 @L.T("Nouveau groupe")</button>
        <button class="btn btn-secondary btn-sm" @onclick="ShowAnnonce">📢 @L.T("Annonce")</button>
    </div>
    <div class="search-box cal-search">
        <span class="search-icon" aria-hidden="true">&#128269;</span>
        <input type="search" placeholder="@L.T("Rechercher une conversation (membre, annonce, texte)…")" aria-label="@L.T("Rechercher une conversation")"
               value="@_search" @oninput="OnSearch" />
    </div>
    @if (!string.IsNullOrWhiteSpace(_search))
    {
        <div class="search-summary">@L.F("{0} conversation(s) trouvée(s) pour « {1} »", VisibleConversations.Count, _search.Trim())</div>
    }
    @if (_conversations.Count == 0)
    {
        <EmptyState Icon="✉" Title="@L.T("Aucun message")" Message="@L.T("Écrivez le premier message ou publiez une annonce.")" />
    }
    else if (VisibleConversations.Count == 0)
    {
        <EmptyState Icon="✉" Title="@L.T("Aucun résultat")" Message="@L.T("Aucune conversation ne correspond à cette recherche.")" />
    }
    else
    {
        <div class="user-list">
            @foreach (var conv in VisibleConversations)
            {
                var cid = conv.ConversationId;
                var dernier = conv.Dernier;
                var nonLus = conv.NonLus;
                <div class="user-card" @onclick="() => OpenConversation(cid)">
                    <span class="field-type-icon" aria-hidden="true">@ConversationIcon(cid)</span>
                    <div class="user-card-main">
                        <div class="user-card-name">@ConversationTitle(cid)</div>
                        <div class="user-card-sub">@(dernier.Supprime ? "🗑 " + L.T("Message supprimé") : Truncate(dernier.Texte, 80))</div>
                        <div class="user-card-meta">
                            <span class="text-muted" style="font-size:12px">@dernier.Expediteur · @DataStore.FormatDateHeure(dernier.Date)</span>
                            @if (nonLus > 0) { <Badge Text="@nonLus.ToString()" Kind="role" /> }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    <button class="fab" aria-label="@L.T("Écrire un nouveau message")" @onclick="ShowNewMessage">+</button>
}
else
{
    <div class="form-group" style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
        <button class="btn btn-secondary btn-sm" @onclick="CloseConversation">← @L.T("Conversations")</button>
        <div style="flex:1;min-width:0">
            <h2 style="margin:0;font-size:18px;font-weight:700">@ConversationIcon(_conversation) @ConversationTitle(_conversation)</h2>
            @if (DataStore.EstDiscussionDeGroupe(_conversation))
            {
                <div class="text-muted" style="font-size:12px">@ParticipantsLabel(_conversation)</div>
            }
        </div>
        <button type="button" class="btn-icon danger" aria-label="@L.T("Supprimer la conversation")" title="@L.T("Supprimer la conversation")" @onclick="() => _supprimerConv = true">🗑</button>
    </div>
    <div class="msg-thread">
        @foreach (var m in _messages)
        {
            var mine = m.Expediteur.Equals(Me, StringComparison.OrdinalIgnoreCase);
            @if (m.Supprime)
            {
                <div class="msg-bubble msg-deleted">
                    <div class="msg-meta"><strong>@(m.SupprimePar ?? m.Expediteur)</strong> · @(string.IsNullOrWhiteSpace(m.SupprimeLe) ? DataStore.FormatDateHeure(m.Date) : DataStore.FormatDateHeure(m.SupprimeLe))</div>
                    <div class="msg-text msg-text-deleted">🗑 @L.T("Message supprimé")</div>
                </div>
            }
            else
            {
                <div class="msg-bubble @(mine ? "msg-mine" : "msg-theirs")">
                    <div class="msg-meta"><strong>@m.Expediteur</strong> · @DataStore.FormatDateHeure(m.Date)@(string.IsNullOrWhiteSpace(m.DateModification) ? "" : " · " + L.T("modifié"))</div>
                    <div class="msg-text">@m.Texte</div>
                    <div class="msg-actions">
                        @if (Store.CanEditMessage(m.Id))
                        {
                            <button type="button" class="btn-icon msg-edit" aria-label="@L.T("Modifier")" @onclick="() => AskEdit(m)">✏️</button>
                        }
                        @if (mine || Store.IsAdmin)
                        {
                            <button type="button" class="btn-icon danger msg-del" aria-label="@L.T("Supprimer")" @onclick="() => AskDelete(m)">🗑</button>
                        }
                    </div>
                </div>
            }
        }
    </div>
    <div class="msg-reply">
        <input type="text" placeholder="@L.T("Écrire un message…")" aria-label="@L.T("Répondre")"
               value="@_reply" @oninput="e => _reply = e.Value?.ToString() ?? string.Empty" @onkeydown="OnReplyKey" />
        <button class="btn btn-primary btn-sm" @onclick="SendReply" disabled="@string.IsNullOrWhiteSpace(_reply)">@L.T("Envoyer")</button>
    </div>
}

<Modal Title="@(_annonce ? L.T("Publier une annonce") : _groupe ? L.T("Nouveau groupe") : L.T("Nouveau message"))" Show="_showNew" OnClose="() => _showNew = false">
    <ChildContent>
        @if (_groupe)
        {
            <div class="form-group">
                <label for="msg-grp-nom">@L.T("Nom du groupe *")</label>
                <input id="msg-grp-nom" type="text" maxlength="80" placeholder="@L.T("Ex : Comité de la kermesse")"
                       value="@_nomGroupe" @oninput="e => _nomGroupe = e.Value?.ToString() ?? string.Empty" />
            </div>
        }
        @if (!_annonce)
        {
            <div class="form-group">
                <label>@(_groupe ? L.T("Membres du groupe") : L.T("Destinataires"))</label>
                <div class="search-box cal-search cal-opt-search">
                    <span class="search-icon" aria-hidden="true">&#128269;</span>
                    <input type="search" placeholder="@L.T("Écrire pour chercher un membre…")" aria-label="@L.T("Chercher un membre")"
                           value="@_destSearch" @oninput="e => _destSearch = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="check-group">
                    @foreach (var u in FilteredDest)
                    {
                        <label class="form-check">
                            <input type="checkbox" checked="@_dest.Contains(u.Identifiant)" @onchange="() => ToggleDest(u.Identifiant)" />
                            @u.NomComplet <span class="text-muted" style="font-size:12px">@@@u.Identifiant</span>
                        </label>
                    }
                    @if (FilteredDest.Count == 0)
                    {
                        <div class="cal-no-events">@L.F("Aucun membre trouvé pour « {0} ».", _destSearch)</div>
                    }
                </div>
                <span class="field-hint">@(_groupe ? L.F("{0} membre(s) choisi(s), au moins deux.", _dest.Count) : L.T("Sans destinataire : le message part en annonce (tout le monde)."))</span>
            </div>
        }
        else
        {
            <p class="muted" style="margin-top:0">📢 @L.T("Visible par tous les membres.")</p>
        }
        <div class="form-group">
            <label for="msg-new-text">@L.T("Message *")</label>
            <textarea id="msg-new-text" rows="3" value="@_newTexte" @oninput="e => _newTexte = e.Value?.ToString() ?? string.Empty"></textarea>
        </div>
        <span class="form-error">@_newError</span>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _showNew = false">@L.T("Annuler")</button>
        <button class="btn btn-primary" @onclick="SendNew">@L.T("Envoyer")</button>
    </FooterContent>
</Modal>

<Modal Title="@L.T("Supprimer la conversation")" Show="_supprimerConv" OnClose="() => _supprimerConv = false">
    <ChildContent>
        <p style="margin-top:0">@L.T("La conversation disparaît de votre liste. Elle reviendra si quelqu'un y écrit de nouveau, avec les nouveaux messages seulement.")</p>
        @if (Store.IsAdmin)
        {
            <p class="text-muted" style="font-size:13px">@L.T("Administrateur : « Pour tout le monde » efface définitivement tous ses messages, pour tous les participants.")</p>
        }
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _supprimerConv = false">@L.T("Annuler")</button>
        @if (Store.IsAdmin)
        {
            <button class="btn btn-danger-outline" @onclick="() => SupprimerConversation(true)">@L.T("Pour tout le monde")</button>
        }
        <button class="btn btn-danger" @onclick="() => SupprimerConversation(false)">@L.T("Supprimer pour moi")</button>
    </FooterContent>
</Modal>

<ConfirmDialog Show="_deleteTarget != null" Title="@L.T("Supprimer le message")"
               Message="@L.T("Le message sera masqué, mais un journal « Message supprimé » restera visible dans la conversation.")"
               ConfirmLabel="@L.T("Supprimer")" Danger="true" OnConfirm="ConfirmDelete" OnCancel="() => _deleteTarget = null" />

<Modal Title="@L.T("Modifier le message")" Show="_editTarget != null" OnClose="() => _editTarget = null">
    <ChildContent>
        <div class="form-group">
            <label for="msg-edit-text">@L.T("Message *")</label>
            <textarea id="msg-edit-text" rows="3" value="@_editTexte" @oninput="e => _editTexte = e.Value?.ToString() ?? string.Empty"></textarea>
        </div>
        <span class="field-hint">@L.T("Modifiable pendant 5 minutes après l'envoi.")</span>
        <span class="form-error">@_editError</span>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="() => _editTarget = null">@L.T("Annuler")</button>
        <button class="btn btn-primary" @onclick="ConfirmEdit">@L.T("Enregistrer")</button>
    </FooterContent>
</Modal>

@code {
    private string Me => Store.GetCurrentUser()?.Identifiant ?? "";
    private List<(string ConversationId, Message Dernier, int NonLus)> _conversations = new();
    private string? _conversation;
    private List<Message> _messages = new();
    private string _reply = "";
    private string _search = "";
    private bool _showNew;
    private bool _annonce;
    private bool _groupe;
    private string _nomGroupe = "";
    private bool _supprimerConv;
    private HashSet<string> _dest = new();
    private string _newTexte = "";
    private string _newError = "";
    private Message? _deleteTarget;
    private Message? _editTarget;
    private string _editTexte = "";
    private string _editError = "";

    private IReadOnlyList<UserAccount> ActiveUsers =>
        Store.Users.Where(u => u.Actif).OrderBy(u => u.NomComplet).ToList();

    private string _destSearch = "";

    private List<UserAccount> FilteredDest
    {
        get
        {
            var q = _destSearch.Trim();
            var list = ActiveUsers.Where(u => !u.Identifiant.Equals(Me, StringComparison.OrdinalIgnoreCase));
            if (q.Length == 0) return list.ToList();
            return list.Where(u => (u.NomComplet + " " + u.Identifiant + " " + (u.Matricule ?? ""))
                .Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    protected override void OnInitialized()
    {
        Store.DataChanged += Refresh;
        RefreshList();
    }

    private void Refresh() => _ = InvokeAsync(() =>
    {
        RefreshList();
        if (_conversation != null) LoadThread();
        StateHasChanged();
    });

    private void RefreshList() => _conversations = Store.GetConversations(Me).ToList();

    private List<(string ConversationId, Message Dernier, int NonLus)> VisibleConversations
    {
        get
        {
            var q = _search.Trim();
            if (q.Length == 0) return _conversations;
            return _conversations.Where(c =>
                ConversationTitle(c.ConversationId).Contains(q, StringComparison.OrdinalIgnoreCase)
                || c.Dernier.Texte.Contains(q, StringComparison.OrdinalIgnoreCase)
                || c.Dernier.Expediteur.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? string.Empty;

    private void ShowNewMessage()
    {
        _showNew = true;
        _annonce = false;
        _groupe = false;
        _newTexte = "";
        _newError = "";
        _dest = new HashSet<string>();
    }

    private void ShowNouveauGroupe()
    {
        ShowNewMessage();
        _groupe = true;
        _nomGroupe = "";
    }

    private void ShowAnnonce()
    {
        _showNew = true;
        _annonce = true;
        _groupe = false;
        _newTexte = "";
        _newError = "";
        _dest = new HashSet<string>();
    }

    private void OpenConversation(string id)
    {
        _conversation = id;
        Store.MarkConversationRead(id, Me);
        LoadThread();
    }

    private void CloseConversation()
    {
        _conversation = null;
        _reply = "";
        RefreshList();
    }

    private void LoadThread()
    {
        _messages = Store.GetMessages(_conversation ?? "").ToList();
    }

    private string ConversationIcon(string cid)
        => cid == DataStore.ConversationAnnonces ? "📢"
            : Store.GroupeDeConversation(cid) != null ? "⛪"
            : DataStore.EstDiscussionDeGroupe(cid) ? "👥" : "💬";

    private string ParticipantsLabel(string cid)
        => string.Join(", ", Store.ParticipantsConversation(cid)
            .Select(p => p.Equals(Me, StringComparison.OrdinalIgnoreCase) ? L.T("vous") : Store.FindUserByIdentifier(p)?.NomComplet ?? p));

    private string ConversationTitle(string cid)
    {
        if (cid == DataStore.ConversationAnnonces) return L.T("Annonces");
        if (DataStore.EstDiscussionDeGroupe(cid))
        {
            var nom = Store.NomDiscussion(cid);
            return nom.Length > 0 ? nom : L.T("Discussion");
        }
        var parts = cid.StartsWith("mp:", StringComparison.OrdinalIgnoreCase)
            ? cid[3..].Split('+', StringSplitOptions.RemoveEmptyEntries)
            : new[] { cid };
        var names = parts
            .Where(p => !p.Equals(Me, StringComparison.OrdinalIgnoreCase))
            .Select(p => Store.FindUserByIdentifier(p)?.NomComplet ?? p)
            .ToList();
        return names.Count == 0 ? L.T("Discussion") : string.Join(", ", names);
    }

    private static string Truncate(string s, int max)
    {
        var v = s ?? "";
        return v.Length <= max ? v : v[..max] + "…";
    }

    private void ToggleDest(string identifiant)
    {
        if (!_dest.Add(identifiant)) _dest.Remove(identifiant);
    }

    private void SendNew()
    {
        _newError = "";
        var res = _groupe
            ? Store.CreerDiscussionDeGroupe(_nomGroupe, _dest, _newTexte)
            : Store.SendMessage(_annonce ? new List<string>() : _dest.ToList(), _newTexte);
        if (!res.Success) { _newError = res.Error; return; }
        _showNew = false;
        State.NotifySuccess(_annonce ? L.T("Annonce publiée.") : _groupe ? L.F("Groupe « {0} » créé.", _nomGroupe.Trim()) : L.T("Message envoyé."));
        RefreshList();
    }

    private void OnReplyKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SendReply();
    }

    private void SendReply()
    {
        if (_conversation == null || string.IsNullOrWhiteSpace(_reply)) return;
        var res = Store.RepondreConversation(_conversation, _reply);
        if (!res.Success) { State.NotifyError(res.Error); return; }
        _reply = "";
        LoadThread();
    }

    private void SupprimerConversation(bool pourTous)
    {
        _supprimerConv = false;
        if (_conversation == null) return;
        var res = Store.SupprimerConversation(_conversation, pourTous);
        if (!res.Success) { State.NotifyError(res.Error); return; }
        State.NotifySuccess(L.T("Conversation supprimée."));
        CloseConversation();
    }

    private void AskDelete(Message m) => _deleteTarget = m;

    private void ConfirmDelete()
    {
        var t = _deleteTarget;
        _deleteTarget = null;
        if (t == null) return;
        var res = Store.DeleteMessage(t.Id);
        if (res.Success) { State.NotifySuccess(L.T("Message supprimé.")); LoadThread(); RefreshList(); }
        else State.NotifyError(res.Error);
    }

    private void AskEdit(Message m)
    {
        _editTarget = m;
        _editTexte = m.Texte;
        _editError = "";
    }

    private void ConfirmEdit()
    {
        var t = _editTarget;
        if (t == null) return;
        var res = Store.UpdateMessage(t.Id, _editTexte);
        if (!res.Success) { _editError = res.Error; return; }
        _editTarget = null;
        State.NotifySuccess(L.T("Message modifié."));
        LoadThread();
        RefreshList();
    }

    public void Dispose() => Store.DataChanged -= Refresh;
}
