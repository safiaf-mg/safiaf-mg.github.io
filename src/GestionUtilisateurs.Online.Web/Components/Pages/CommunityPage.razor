@implements IDisposable
@inject DataStore Store
@inject AppState State
@inject PhotoService Photos
@inject JavascriptBridge Js

<div class="page-head">
    <p>@(string.IsNullOrWhiteSpace(Store.Community.SousTitre) ? L.T("Le récit vivant de notre communauté, chapitre par chapitre.") : Store.Community.SousTitre)</p>
</div>

<div class="search-box cal-search">
    <span class="search-icon" aria-hidden="true">&#128269;</span>
    <input type="search" placeholder="@L.T("Rechercher dans l'histoire (chapitre, texte)…")" aria-label="@L.T("Rechercher un chapitre")"
           value="@_search" @oninput="OnSearch" />
</div>
@if (!string.IsNullOrWhiteSpace(_search))
{
    <div class="search-summary">@L.F("{0} chapitre(s) trouvé(s) pour « {1} »", SearchResults.Count, _search.Trim())</div>
}

@if (_editing && CanEdit)
{
    <div class="card" style="margin-bottom:12px">
        <h3>@Store.LibelleHistoire()</h3>
        <div class="form-group">
            <label for="cm-titre">@L.T("Titre *")</label>
            <input id="cm-titre" type="text" value="@_storyTitre" @oninput="e => _storyTitre = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="form-group">
            <label for="cm-soustitre">@L.T("Sous-titre")</label>
            <input id="cm-soustitre" type="text" value="@_storySousTitre" @oninput="e => _storySousTitre = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="CancelStory">@L.T("Annuler")</button>
            <button class="btn btn-primary" @onclick="SaveStory">@L.T("Enregistrer")</button>
        </div>
    </div>

    <div class="card" style="margin-bottom:12px">
        <h3>@(_chapterId == null ? L.T("Ajouter un chapitre") : L.T("Modifier le chapitre"))</h3>
        <div class="form-group">
            <label for="cm-ch-titre">@L.T("Titre du chapitre *")</label>
            <input id="cm-ch-titre" type="text" placeholder="@L.T("Ex : La fondation")" value="@_cTitre" @oninput="e => _cTitre = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="form-group">
            <label>@L.T("Date")</label>
            <div class="chips-row" role="radiogroup" aria-label="@L.T("Précision de la date")">
                <button type="button" class="chip @(_cPrecision == "jour" ? "active" : "")" aria-pressed="@(_cPrecision == "jour" ? "true" : "false")" @onclick='() => _cPrecision = "jour"'>@L.T("Jour exact")</button>
                <button type="button" class="chip @(_cPrecision == "mois" ? "active" : "")" aria-pressed="@(_cPrecision == "mois" ? "true" : "false")" @onclick='() => _cPrecision = "mois"'>@L.T("Mois")</button>
                <button type="button" class="chip @(_cPrecision == "annee" ? "active" : "")" aria-pressed="@(_cPrecision == "annee" ? "true" : "false")" @onclick='() => _cPrecision = "annee"'>@L.T("Année")</button>
            </div>
            @if (_cPrecision == "jour")
            {
                <DateInput Id="cm-ch-date" Value="@_cDateIso" ValueChanged="@(v => _cDateIso = v)" />
                <span class="field-hint">@L.T("Affichée au format JJ/MM/AAAA.")</span>
            }
            else
            {
                <div class="community-date-row">
                    @if (_cPrecision == "mois")
                    {
                        <select aria-label="@L.T("Mois")" value="@_cMois" @onchange="e => _cMois = e.Value?.ToString() ?? string.Empty">
                            <option value="">@L.T("Mois")</option>
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m">@L.Majuscule(L.Mois(m))</option>
                            }
                        </select>
                    }
                    <input type="number" inputmode="numeric" min="1000" max="9999" placeholder="@L.T("Année (ex : 1993)")" aria-label="@L.T("Année")"
                           value="@_cAnnee" @oninput="e => _cAnnee = e.Value?.ToString() ?? string.Empty" />
                </div>
                <span class="field-hint">@L.T("Quand on ne connaît pas le jour exact, mettez seulement le mois ou l'année.")</span>
            }
        </div>
        <div class="form-group">
            <label for="cm-ch-texte">@L.T("Récit")</label>
            <textarea id="cm-ch-texte" rows="4" placeholder="@L.T("Racontez ce moment de la communauté…")" value="@_cTexte" @oninput="e => _cTexte = e.Value?.ToString() ?? string.Empty"></textarea>
        </div>
        <div class="form-group">
            <label>@L.F("Photos (facultatif, max 5 Mo chacune, {0} au plus)", DataStore.MaxPhotosChapitre)</label>
            @if (_cPhotos.Count == 0)
            {
                <div class="photo-placeholder">@L.T("Aucune image")</div>
            }
            <div class="community-photo-edit-list">
                @for (var i = 0; i < _cPhotos.Count; i++)
                {
                    var idx = i;
                    var ph = _cPhotos[idx];
                    <div class="community-photo-edit">
                        <img src="@ph.Image" alt="@L.F("Photo {0}", idx + 1)" />
                        <div class="community-photo-edit-main">
                            <input type="text" placeholder="@L.T("Légende (facultatif)")" aria-label="@L.F("Légende de la photo {0}", idx + 1)"
                                   value="@ph.Legende" @oninput="e => ph.Legende = e.Value?.ToString() ?? string.Empty" />
                            <div class="community-actions" style="margin-top:6px">
                                <button type="button" class="btn-icon" aria-label="@L.T("Monter")" disabled="@(idx == 0)" @onclick="() => MovePhoto(idx, -1)">↑</button>
                                <button type="button" class="btn-icon" aria-label="@L.T("Descendre")" disabled="@(idx == _cPhotos.Count - 1)" @onclick="() => MovePhoto(idx, 1)">↓</button>
                                <button type="button" class="btn-icon danger" aria-label="@L.T("Retirer")" @onclick="() => _cPhotos.RemoveAt(idx)">🗑</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="photo-actions" style="margin-top:8px">
                <button type="button" class="btn btn-secondary btn-sm" disabled="@(_cPhotos.Count >= DataStore.MaxPhotosChapitre)" @onclick="PickChapterImage">🖼 @L.T("Ajouter une photo")</button>
                <button type="button" class="btn btn-secondary btn-sm" disabled="@(_cPhotos.Count >= DataStore.MaxPhotosChapitre)" @onclick="CaptureChapterImage">📷 @L.T("Photo")</button>
            </div>
        </div>
        <span class="form-error">@_chapterError</span>
        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="CancelChapter">@L.T("Annuler")</button>
            <button class="btn btn-primary" @onclick="SaveChapter">@(_chapterId == null ? L.T("Ajouter") : L.T("Enregistrer"))</button>
        </div>
    </div>
}

<div class="inline-actions" style="justify-content:space-between;margin-bottom:10px">
    <p class="user-count">@L.F("{0} chapitre(s)", Store.Community.Chapitres.Count)</p>
    <div class="inline-actions">
        @if (CanEdit)
        {
            <button class="btn btn-secondary btn-sm" @onclick="ToggleEdit">@(_editing ? "👁 " + L.T("Voir") : "✏️ " + L.T("Modifier"))</button>
        }
        @if (ShowReader && Store.Community.Chapitres.Count > 1)
        {
            <button class="btn btn-secondary btn-sm" @onclick="Prev" disabled="@(_index <= 0)">‹ @L.T("Préc.")</button>
            <button class="btn btn-secondary btn-sm" @onclick="Next" disabled="@(_index >= Store.Community.Chapitres.Count - 1)">@L.T("Suiv.") ›</button>
        }
    </div>
</div>

@if (CanEdit)
{
    <button class="fab" aria-label="@L.T("Ajouter un chapitre")" @onclick="FabAddChapter">+</button>
}

@if (Store.Community.Chapitres.Count == 0)
{
    <EmptyState Icon="📖" Title="@L.T("Histoire à écrire")" Message="@(CanEdit ? L.T("Ajoutez le premier chapitre avec le mode Modifier.") : L.T("La communauté n'a pas encore raconté son histoire."))" />
}
else if (_editing && CanEdit)
{
    <div class="community-timeline">
        @for (var i = 0; i < Store.Community.Chapitres.Count; i++)
        {
            var idx = i;
            var c = Store.Community.Chapitres[idx];
            var photos = DataStore.PhotosChapitre(c);
            <div class="community-card">
                <div class="community-rail"><span class="community-dot">@(idx + 1)</span></div>
                <div class="community-main">
                    <div class="community-date">@ChapterDate(c)</div>
                    <div class="community-title">@c.Titre</div>
                    @if (!string.IsNullOrWhiteSpace(c.Texte))
                    {
                        <div class="community-text">@c.Texte</div>
                    }
                    @if (photos.Count > 0)
                    {
                        <img class="community-img" src="@photos[0].Image" alt="@c.Titre" loading="lazy" />
                        @if (photos.Count > 1)
                        {
                            <div class="field-hint">📷 @L.F("{0} photos", photos.Count)</div>
                        }
                    }
                    <div class="community-actions">
                        <button class="btn-icon" aria-label="@L.T("Monter")" disabled="@(idx == 0)" @onclick="() => Move(c.Id, -1)">↑</button>
                        <button class="btn-icon" aria-label="@L.T("Descendre")" disabled="@(idx == Store.Community.Chapitres.Count - 1)" @onclick="() => Move(c.Id, 1)">↓</button>
                        <button class="btn btn-secondary btn-sm" @onclick="() => StartEditChapter(c)">@L.T("Modifier")</button>
                        <button class="btn-icon danger" aria-label="@L.T("Supprimer")" @onclick="() => AskDelete(c)">🗑</button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrWhiteSpace(_search))
{
    <div class="user-list">
        @foreach (var c in SearchResults)
        {
            var ch = c;
            <div class="user-card" role="button" tabindex="0" @onclick="() => JumpToChapter(ch)" @onkeydown="(k) => OnJumpKey(k, ch)">
                <span class="field-type-icon" aria-hidden="true">📖</span>
                <div class="user-card-main">
                    <div class="user-card-name">@ch.Titre</div>
                    <div class="user-card-sub">@ChapterDate(ch)</div>
                    @if (!string.IsNullOrWhiteSpace(ch.Texte))
                    {
                        <div class="user-card-sub">@TruncateText(ch.Texte, 120)</div>
                    }
                </div>
                <span class="sel-count" aria-hidden="true">›</span>
            </div>
        }
    </div>
}
else
{
    var chapters = Store.Community.Chapitres;
    <div class="cal-view-tabs" role="tablist" aria-label="@L.T("Affichage de l'histoire")">
        <button class="cal-tab @(_vue == "lire" ? "active" : "")" role="tab" aria-selected="@(_vue == "lire" ? "true" : "false")" @onclick='() => _vue = "lire"'>📖 @L.T("Lire")</button>
        <button class="cal-tab @(_vue == "frise" ? "active" : "")" role="tab" aria-selected="@(_vue == "frise" ? "true" : "false")" @onclick='() => _vue = "frise"'>📜 @L.T("Frise")</button>
    </div>

    @if (_vue == "frise")
    {
        <div class="community-frise">
            @for (var i = 0; i < chapters.Count; i++)
            {
                var idx = i;
                var c = chapters[idx];
                var photos = DataStore.PhotosChapitre(c);
                var annee = DataStore.AnneeHistoire(c.Date);
                <div class="community-frise-item">
                    <div class="community-frise-rail">
                        <span class="community-frise-year">@(annee.Length > 0 ? annee : "?")</span>
                        <span class="community-frise-line" aria-hidden="true"></span>
                    </div>
                    <button type="button" class="community-frise-card" @onclick="() => ReadChapter(idx)">
                        @if (photos.Count > 0)
                        {
                            <img class="community-frise-thumb" src="@photos[0].Image" alt="" loading="lazy" />
                        }
                        <span class="community-frise-main">
                            <span class="community-date">@ChapterDate(c)</span>
                            <span class="community-title">@c.Titre</span>
                            @if (!string.IsNullOrWhiteSpace(c.Texte))
                            {
                                <span class="community-frise-excerpt">@TruncateText(c.Texte, 90)</span>
                            }
                        </span>
                        <span class="sel-count" aria-hidden="true">›</span>
                    </button>
                </div>
            }
        </div>
        <p class="user-count" style="text-align:center;margin-top:6px">@L.T("Touchez un chapitre pour le lire.")</p>
    }
    else
    {
        var current = chapters[Math.Clamp(_index, 0, chapters.Count - 1)];
        var photos = DataStore.PhotosChapitre(current);
        var photo = photos.Count == 0 ? null : photos[Math.Clamp(_photoIndex, 0, photos.Count - 1)];
        <div class="community-reader">
            <div class="community-progress">@(_index + 1) / @chapters.Count</div>
            <div class="community-bar"><div class="community-fill" style="width:@(((double)(_index + 1) / chapters.Count * 100.0).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
            <div class="community-card community-current">
                <div class="community-date">@ChapterDate(current)</div>
                <h3 class="community-title-lg">@current.Titre</h3>
                @if (photo != null)
                {
                    <div class="community-gallery">
                        <button type="button" class="community-img-btn" @onclick="() => _preview = photo" aria-label="@L.T("Agrandir l'image")">
                            <img class="community-img-lg" src="@photo.Image" alt="@(string.IsNullOrWhiteSpace(photo.Legende) ? current.Titre : photo.Legende)" />
                        </button>
                        @if (!string.IsNullOrWhiteSpace(photo.Legende))
                        {
                            <div class="community-caption">@photo.Legende</div>
                        }
                        @if (photos.Count > 1)
                        {
                            <div class="community-thumbs">
                                @for (var p = 0; p < photos.Count; p++)
                                {
                                    var pi = p;
                                    <button type="button" class="community-thumb @(pi == _photoIndex ? "active" : "")" aria-label="@L.F("Photo {0}", pi + 1)" @onclick="() => _photoIndex = pi">
                                        <img src="@photos[pi].Image" alt="" loading="lazy" />
                                    </button>
                                }
                                <span class="community-thumbs-count">@(_photoIndex + 1) / @photos.Count</span>
                            </div>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(current.Texte))
                {
                    @if (_expanded)
                    {
                        <div class="community-text-lg">@current.Texte</div>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _expanded = false">@L.T("Réduire")</button>
                    }
                    else if (current.Texte.Length > 220)
                    {
                        <div class="community-text-lg">@current.Texte.Substring(0, 220)…</div>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _expanded = true">@L.T("Lire la suite")</button>
                    }
                    else
                    {
                        <div class="community-text-lg">@current.Texte</div>
                    }
                }
            </div>
            <div class="community-dots">
                @for (var i = 0; i < chapters.Count; i++)
                {
                    var idx = i;
                    <button type="button" class="community-dot-btn @(idx == _index ? "active" : "")" aria-label="@L.F("Chapitre {0}", idx + 1)" @onclick="() => GoTo(idx)">@(idx + 1)</button>
                }
            </div>
        </div>
    }
}

<ConfirmDialog Show="_deleteTarget != null" Title="@L.T("Supprimer le chapitre")"
               Message="@(_deleteTarget == null ? "" : L.F("Supprimer « {0} » de l'histoire ?", _deleteTarget.Titre))"
               ConfirmLabel="@L.T("Supprimer")" Danger="true" OnConfirm="ConfirmDelete" OnCancel="() => _deleteTarget = null" />

<Modal Title="@L.T("Illustration")" Show="_preview != null" OnClose="() => _preview = null">
    @if (_preview != null)
    {
        <div class="image-viewer-wrap community-viewer">
            <img class="image-viewer-img" src="@_preview.Image" alt="@(string.IsNullOrWhiteSpace(_preview.Legende) ? L.T("Illustration") : _preview.Legende)" />
            @if (!string.IsNullOrWhiteSpace(_preview.Legende))
            {
                <div class="community-caption">@_preview.Legende</div>
            }
        </div>
    }
</Modal>

@code {
    private bool CanEdit => Store.IsManager;
    private bool _editing;
    private int _index;
    private int _photoIndex;
    private bool _expanded;
    private CommunityPhoto? _preview;
    private string _search = "";
    /// <summary>Vue de lecture : « lire » (un chapitre à la fois) ou « frise » (tous les chapitres).</summary>
    private string _vue = "lire";

    private bool ShowReader => !(_editing && CanEdit) && string.IsNullOrWhiteSpace(_search) && _vue == "lire";

    private List<CommunityChapter> SearchResults
    {
        get
        {
            var q = _search.Trim();
            if (q.Length == 0) return new List<CommunityChapter>();
            return Store.Community.Chapitres
                .Where(c => (c.Titre + " " + c.Texte + " " + ChapterDate(c) + " "
                        + string.Join(" ", DataStore.PhotosChapitre(c).Select(p => p.Legende)))
                    .Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _expanded = false;
    }

    private void JumpToChapter(CommunityChapter c)
    {
        var idx = Store.Community.Chapitres.ToList().FindIndex(x => x.Id == c.Id);
        _search = "";
        if (idx >= 0) ReadChapter(idx);
    }

    private void OnJumpKey(KeyboardEventArgs k, CommunityChapter c)
    {
        if (k.Key is "Enter" or " ") JumpToChapter(c);
    }

    private void ReadChapter(int idx)
    {
        _vue = "lire";
        GoTo(idx);
        _ = Js.ScrollToTopAsync();
    }

    private static string TruncateText(string s, int max)
    {
        var v = s ?? "";
        return v.Length <= max ? v : v[..max] + "…";
    }

    private string _storyTitre = "";
    private string _storySousTitre = "";

    private string? _chapterId;
    private string _cTitre = "";
    private string _cTexte = "";
    /// <summary>Précision de la date saisie : « jour », « mois » ou « annee ».</summary>
    private string _cPrecision = "jour";
    private string _cDateIso = "";
    private string _cMois = "";
    private string _cAnnee = "";
    private List<CommunityPhoto> _cPhotos = new();
    private string _chapterError = "";
    private CommunityChapter? _deleteTarget;

    protected override void OnInitialized()
    {
        Store.DataChanged += Refresh;
        ResetStoryDraft();
    }

    protected override void OnParametersSet()
    {
        var count = Store.Community.Chapitres.Count;
        if (_index >= count) _index = Math.Max(0, count - 1);
    }

    private void Refresh() => _ = InvokeAsync(() =>
    {
        var count = Store.Community.Chapitres.Count;
        if (_index >= count) _index = Math.Max(0, count - 1);
        StateHasChanged();
    });

    private void ResetStoryDraft()
    {
        _storyTitre = Store.Community.Titre;
        _storySousTitre = Store.Community.SousTitre;
    }

    private void ToggleEdit()
    {
        _editing = !_editing;
        if (_editing) { ResetStoryDraft(); CancelChapter(); }
    }

    private void FabAddChapter()
    {
        if (!CanEdit) return;
        if (!_editing) { _editing = true; ResetStoryDraft(); }
        CancelChapter();
        _ = Js.ScrollToIdAsync("cm-ch-titre");
    }

    private void CancelStory() => ResetStoryDraft();

    private void SaveStory()
    {
        var res = Store.SaveCommunityStory(_storyTitre, _storySousTitre);
        if (!res.Success) State.NotifyError(res.Error);
        else State.NotifySuccess(L.T("Histoire enregistrée."));
    }

    private void CancelChapter()
    {
        _chapterId = null;
        _cTitre = "";
        _cTexte = "";
        _cPrecision = "jour";
        _cDateIso = "";
        _cMois = "";
        _cAnnee = "";
        _cPhotos = new List<CommunityPhoto>();
        _chapterError = "";
    }

    private void StartEditChapter(CommunityChapter c)
    {
        CancelChapter();
        _chapterId = c.Id;
        _cTitre = c.Titre;
        _cTexte = c.Texte;
        _cPrecision = DataStore.PrecisionDateHistoire(c.Date);
        var parts = (c.Date ?? "").Trim().Split('/');
        if (_cPrecision == "annee") _cAnnee = parts[0];
        else if (_cPrecision == "mois") { _cMois = int.Parse(parts[0]).ToString(); _cAnnee = parts[1]; }
        else _cDateIso = ToIsoDate(c.Date ?? "");
        _cPhotos = DataStore.PhotosChapitre(c).Select(p => new CommunityPhoto { Image = p.Image, Legende = p.Legende }).ToList();
        _ = Js.ScrollToIdAsync("cm-ch-titre");
    }

    private async Task PickChapterImage()
    {
        var data = await Photos.PickPhotoAsync();
        if (data != null) AddPhoto(data);
        else if (!string.IsNullOrEmpty(Photos.LastError)) State.NotifyError(Photos.LastError);
    }

    private async Task CaptureChapterImage()
    {
        var data = await Photos.CapturePhotoAsync();
        if (data != null) AddPhoto(data);
        else if (!string.IsNullOrEmpty(Photos.LastError)) State.NotifyError(Photos.LastError);
    }

    private void AddPhoto(string data)
    {
        if (_cPhotos.Count < DataStore.MaxPhotosChapitre) _cPhotos.Add(new CommunityPhoto { Image = data });
    }

    private void MovePhoto(int idx, int dir)
    {
        var target = idx + dir;
        if (target < 0 || target >= _cPhotos.Count) return;
        (_cPhotos[idx], _cPhotos[target]) = (_cPhotos[target], _cPhotos[idx]);
    }

    /// <summary>Date saisie au format enregistré (JJ/MM/AAAA, MM/AAAA ou AAAA), ou null si elle est invalide.</summary>
    private string? DraftDate()
    {
        if (_cPrecision == "jour")
            return string.IsNullOrWhiteSpace(_cDateIso) ? "" : DataStore.FormatDateCourte(ToIsoOrDisplay(_cDateIso));
        var annee = _cAnnee.Trim();
        if (annee.Length == 0 && (_cPrecision == "annee" || _cMois.Length == 0)) return "";
        if (!System.Text.RegularExpressions.Regex.IsMatch(annee, @"^\d{4}$")) return null;
        if (_cPrecision == "annee") return annee;
        return int.TryParse(_cMois, out var m) && m is >= 1 and <= 12 ? m.ToString("00") + "/" + annee : null;
    }

    private void SaveChapter()
    {
        _chapterError = "";
        var date = DraftDate();
        if (date == null)
        {
            _chapterError = _cPrecision == "mois" ? L.T("Choisissez le mois et l'année (4 chiffres).") : L.T("Indiquez l'année avec 4 chiffres (ex : 1993).");
            return;
        }
        OperationResult res;
        if (_chapterId == null)
            res = Store.AddCommunityChapter(_cTitre, _cTexte, date, _cPhotos);
        else
            res = Store.UpdateCommunityChapter(_chapterId, _cTitre, _cTexte, date, _cPhotos);
        if (!res.Success) { _chapterError = res.Error; return; }
        State.NotifySuccess(_chapterId == null ? L.T("Chapitre ajouté.") : L.T("Chapitre enregistré."));
        CancelChapter();
    }

    private void AskDelete(CommunityChapter c) => _deleteTarget = c;

    private void ConfirmDelete()
    {
        var t = _deleteTarget;
        _deleteTarget = null;
        if (t == null) return;
        var res = Store.DeleteCommunityChapter(t.Id);
        if (res.Success) State.NotifySuccess(L.T("Chapitre supprimé."));
        else State.NotifyError(res.Error);
    }

    private void Move(string id, int dir) => Store.MoveCommunityChapter(id, dir);

    private void Prev() { if (_index > 0) GoTo(_index - 1); }
    private void Next() { if (_index < Store.Community.Chapitres.Count - 1) GoTo(_index + 1); }
    private void GoTo(int idx) { _index = idx; _photoIndex = 0; _expanded = false; }

    // --- Balayage horizontal (glisser vers la gauche/la droite pour changer de chapitre ou de photo) ---
    private DotNetObjectReference<CommunityPage>? _swipeRef;
    private bool _swipeStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _swipeRef = DotNetObjectReference.Create(this);
            await Js.EnableCommunitySwipeAsync(_swipeRef);
            _swipeStarted = true;
        }
    }

    [JSInvokable]
    public void OnSwipeChapter(int dir)
    {
        if (!ShowReader) return;
        if (dir < 0) Prev();
        else Next();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSwipePhoto(int dir)
    {
        if (!ShowReader || Store.Community.Chapitres.Count == 0) return;
        var current = Store.Community.Chapitres[Math.Clamp(_index, 0, Store.Community.Chapitres.Count - 1)];
        var count = DataStore.PhotosChapitre(current).Count;
        if (count < 2) { OnSwipeChapter(dir); return; }
        _photoIndex = Math.Clamp(_photoIndex + dir, 0, count - 1);
        StateHasChanged();
    }

    private static string ChapterDate(CommunityChapter c)
    {
        var f = DataStore.FormatDateHistoire(c.Date);
        return f.Length == 0 ? L.T("Date à venir") : f;
    }

    private static string ToIsoDate(string date)
    {
        if (string.IsNullOrWhiteSpace(date)) return "";
        // Stockage = JJ/MM/AAAA : reconvertit en yyyy-MM-dd pour l'input date.
        if (DateTime.TryParseExact(date.Trim(), "dd/MM/yyyy",
                System.Globalization.CultureInfo.GetCultureInfo("fr-FR"),
                System.Globalization.DateTimeStyles.None, out var d))
            return d.ToString("yyyy-MM-dd");
        if (DateTime.TryParse(date, out var any)) return any.ToString("yyyy-MM-dd");
        return "";
    }

    private static string ToIsoOrDisplay(string isoOrAny)
    {
        if (DateTime.TryParseExact(isoOrAny.Trim(), "yyyy-MM-dd",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var d))
            return d.ToString("dd/MM/yyyy");
        return isoOrAny;
    }

    public void Dispose()
    {
        if (_swipeStarted)
        {
            try { _ = Js.DisableCommunitySwipeAsync(); } catch { }
            _swipeRef?.Dispose();
        }
        Store.DataChanged -= Refresh;
    }
}
