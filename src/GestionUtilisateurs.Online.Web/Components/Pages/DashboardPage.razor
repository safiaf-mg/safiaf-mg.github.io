@implements IDisposable
@inject DataStore Store
@inject AppState State

<div class="page-head dash-head">
    <h1>@L.F("Bienvenue, {0}", Store.GetCurrentUser()?.Prenom ?? L.T("invité"))</h1>
    <p>@L.Majuscule(L.DateLongue(DateTime.Today)) · @L.T("Tableau de bord : un aperçu de votre communauté.")</p>
</div>

@* Pour vous : ce qui attend le membre connecté *@
<div class="card dash-mine">
    <h3>@L.T("Pour vous")</h3>
    <div class="dash-kpis">
        @if (Voit("messagerie", Permissions.MessagerieUse))
        {
            <div class="dash-kpi @(mesMessages > 0 ? "dash-kpi-warn" : "")" role="button" tabindex="0" @onclick='() => State.Navigate("messagerie")'>
                <span class="dash-kpi-value">✉ @mesMessages</span>
                <span class="dash-kpi-label">@L.T("Messages non lus")</span>
            </div>
        }
        @if (Voit("votes"))
        {
            <div class="dash-kpi @(mesVotes > 0 ? "dash-kpi-warn" : "")" role="button" tabindex="0" @onclick='() => State.Navigate("votes")'>
                <span class="dash-kpi-value">🗳 @mesVotes</span>
                <span class="dash-kpi-label">@L.T("Votes qui attendent votre voix")</span>
            </div>
        }
        @if (Voit("taches", Permissions.TachesUse))
        {
            <div class="dash-kpi @(mesTachesRetard > 0 ? "dash-kpi-danger" : "")" role="button" tabindex="0" @onclick='() => State.Navigate("taches")'>
                <span class="dash-kpi-value">☑ @mesTaches</span>
                <span class="dash-kpi-label">@(mesTachesRetard > 0 ? L.F("Mes tâches ({0} en retard)", mesTachesRetard) : L.T("Mes tâches à faire"))</span>
            </div>
        }
        @if (Store.PeutOuvrir("calendar"))
        {
            <div class="dash-kpi" role="button" tabindex="0" @onclick='() => State.Navigate("calendar")'>
                <span class="dash-kpi-value">📅 @evenementsAujourdhui</span>
                <span class="dash-kpi-label">@L.T("Événements aujourd'hui")</span>
            </div>
        }
        @if (mesImpayes > 0)
        {
            <div class="dash-kpi dash-kpi-warn dash-kpi-static">
                <span class="dash-kpi-value">💰 @FormatMoney(mesImpayes)</span>
                <span class="dash-kpi-label">@L.T("Ma cotisation à régler")</span>
            </div>
        }
    </div>
</div>

<div class="dash-two">
    @if (Store.PeutOuvrir("calendar"))
    {
    <div class="card dash-week">
        <div class="dash-card-head">
            <h3>📅 @L.T("Les 7 prochains jours")</h3>
            <button type="button" class="btn btn-secondary btn-sm" @onclick='() => State.Navigate("calendar")'>@L.T("Calendrier")</button>
        </div>
        @if (Semaine.Count == 0)
        {
            <p class="muted dash-empty-line">@L.T("Rien de prévu cette semaine.")</p>
        }
        else
        {
            <ul class="dash-list">
                @foreach (var (jour, ev) in Semaine)
                {
                    <li class="dash-list-item" @onclick='() => State.Navigate("calendar")'>
                        <span class="dash-list-day @(jour == DateTime.Today ? "is-today" : "")">@JourCourt(jour)</span>
                        <span class="dash-list-main">
                            <span class="dash-list-title">@CalendarEventTypes.Icon(ev.Type) @ev.Titre</span>
                            <span class="dash-list-sub">@Horaire(ev)@(string.IsNullOrWhiteSpace(ev.Lieu) ? "" : " · " + ev.Lieu)</span>
                        </span>
                    </li>
                }
            </ul>
        }
    </div>
    }

    @if (Voit("rappels", Permissions.RappelsUse) || Store.Can(Permissions.UsersManage))
    {
        <div class="card dash-todo">
            <div class="dash-card-head">
                <h3>🔔 @L.T("À traiter")</h3>
                @* Le bouton mène aux rappels : il n'apparaît que s'il y en a (les doublons se règlent dans Utilisateurs). *@
                @if (Voit("rappels", Permissions.RappelsUse) && rappelsCount > 0)
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick='() => State.Navigate("rappels")'>@L.F("Tous les rappels ({0})", rappelsCount)</button>
                }
            </div>
            @if (doublons == 0 && Rappels.Count == 0)
            {
                <p class="muted dash-empty-line">✅ @L.T("Rien à traiter pour le moment.")</p>
            }
            else
            {
                <ul class="dash-list">
                    @if (doublons > 0)
                    {
                        <li class="dash-list-item" @onclick='() => State.Navigate("users")'>
                            <span class="dash-dot prio-importante" aria-hidden="true"></span>
                            <span class="dash-list-main">
                                <span class="dash-list-title">@L.F("{0} fiche(s) en double à vérifier", doublons)</span>
                                <span class="dash-list-sub">@L.T("Utilisateurs › fusionner les doublons")</span>
                            </span>
                        </li>
                    }
                    @foreach (var r in Rappels)
                    {
                        <li class="dash-list-item" @onclick='() => State.Navigate(string.IsNullOrWhiteSpace(r.PageCible) ? "rappels" : r.PageCible)'>
                            <span class="dash-dot prio-@r.Priorite" aria-hidden="true"></span>
                            <span class="dash-list-main">
                                <span class="dash-list-title">@r.Titre</span>
                                <span class="dash-list-sub">@r.Detail</span>
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

@if (Store.VoitListeMembres)
{
<div class="stats-grid">
    <StatCard Icon="☺" Value="@total.ToString()" Label="@L.T("Utilisateurs total")" OnClick='() => GoToUsers(null, null)' Clickable="@Store.IsManager" />
    <StatCard Icon="✓" Value="@actifs.ToString()" Label="@L.T("Actifs")" Kind="active" OnClick='() => GoToUsers("Actif", null)' Clickable="@Store.IsManager" />
    <StatCard Icon="✗" Value="@inactifs.ToString()" Label="@L.T("Inactifs")" Kind="inactive" OnClick='() => GoToUsers("Inactif", null)' Clickable="@Store.IsManager" />
    <StatCard Icon="★" Value="@admins.ToString()" Label="@L.T("Administrateurs")" OnClick='() => GoToUsers(null, "Administrateur")' Clickable="@Store.IsManager" />
    <StatCard Icon="🗄" Value="@archives.ToString()" Label="@L.T("Archivés")" Kind="recent" OnClick='() => State.Navigate("archive")' Clickable="@Store.PeutOuvrir("archive")" />
    <StatCard Icon="✤" Value="@gestionnaires.ToString()" Label="@L.T("Gestionnaires")" Kind="recent" OnClick='() => GoToUsers(null, "Gestionnaire")' Clickable="@(Store.IsManager)" />
</div>

<div class="card dashboard-card-full">
    <h3>@L.T("Répartition par rôle")</h3>
    <ChartBars Items="@roleChart" />
</div>

<div class="card">
    <h3>@L.T("Derniers utilisateurs ajoutés")</h3>
    @if (RecentUsers.Count == 0)
    {
        <EmptyState Icon="☺" Title="@L.T("Aucun utilisateur")" Message="@L.T("Aucun utilisateur pour le moment.")" />
    }
    else
    {
        <div class="recent-users">
            @foreach (var u in RecentUsers)
            {
                <div class="recent-user recent-user-row" @onclick="() => GoToUser(u.Id)">
                    <button class="avatar-btn" type="button" @onclick:stopPropagation="true" @onclick="() => OpenPhoto(u)" aria-label="@L.T("Agrandir la photo")">
                        <Avatar UserName="@u.NomComplet" Seed="@u.Identifiant" Size="sm" Photo="@u.Photo" />
                    </button>
                    <div class="recent-user-main">
                        <div class="recent-user-name">@u.NomComplet</div>
                        <div class="recent-user-sub">@(string.IsNullOrWhiteSpace(u.Email) ? L.T(u.Role) : u.Email)</div>
                    </div>
                    <Badge Text="@L.T(u.Statut)" Kind="@(u.Actif ? "active" : "inactive")" />
                </div>
            }
        </div>
    }
</div>
}

@if (Store.Can(Permissions.PresenceManage) && ReunionsCount > 0)
{
    <div class="card">
        <div class="dash-card-head">
            <h3>👥 @L.T("Réunions & présence")</h3>
            <button type="button" class="btn btn-secondary btn-sm" @onclick='() => State.Navigate("reunions")'>@L.T("Ouvrir")</button>
        </div>
        @if (PresenceTotal > 0)
        {
            <div class="dash-presence-rate">
                <strong>@PresenceRate.ToString("0") %</strong>
                <span>@L.F("taux de présence global · {0} réunion(s)", ReunionsCount)</span>
            </div>
        }
        <ChartBars Items="@presenceChart" />
    </div>
}

@if (Store.PeutOuvrir("activity"))
{
<div class="card">
    <h3>@L.T("Dernière activité")</h3>
    @if (Store.Activity.Count == 0)
    {
        <EmptyState Icon="✎" Title="@L.T("Aucune activité")" Message="@L.T("Le journal est vide pour le moment.")" />
    }
    else
    {
        <div class="activity-list">
            @foreach (var e in Store.Activity.Take(6))
            {
                <div class="activity-item">
                    <span class="activity-icon" aria-hidden="true">@ActivityIcon(e.Type)</span>
                    <div class="activity-content">
                        <div class="activity-desc"><strong>@ActivityTypes.Label(e.Type)</strong> — @e.Description</div>
                        <div class="activity-meta">
                            <span class="activity-user">@e.User</span>
                            <span class="activity-date">@FormatTimeAgo(e.Date)</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
}

<PhotoViewer Current="@_viewer" OnClose="@(() => _viewer = null)" />

@code {
    private static readonly CultureInfo Fr = CultureInfo.GetCultureInfo("fr-FR");

    private int total, actifs, inactifs, admins, archives, gestionnaires;
    private IReadOnlyList<ChartBars.ChartItem> roleChart = Array.Empty<ChartBars.ChartItem>();
    private List<UserAccount> RecentUsers = new();
    private UserAccount? _viewer;

    private int mesMessages, mesVotes, mesTaches, mesTachesRetard, evenementsAujourdhui, rappelsCount, doublons;
    private double mesImpayes;
    private List<(DateTime Jour, CalendarEvent Ev)> Semaine = new();
    private List<Rappel> Rappels = new();

    private int presencePresent, presenceAbsent, presenceExcuse, presenceNonPointe;
    private IReadOnlyList<ChartBars.ChartItem> presenceChart = Array.Empty<ChartBars.ChartItem>();
    private int ReunionsCount;
    private int PresenceTotal => presencePresent + presenceAbsent + presenceExcuse + presenceNonPointe;
    private double PresenceRate => PresenceTotal == 0 ? 0 : presencePresent * 100.0 / PresenceTotal;

    /// <summary>Le menu est accessible au membre (permission) et n'a pas été masqué dans les paramètres.</summary>
    private bool Voit(string menu, string? permission = null) =>
        (permission == null || Store.Can(permission)) && !Store.IsMenuHidden(menu);

    /// <summary>« Aujourd'hui », « Demain » ou le jour abrégé (Lundi 20).</summary>
    private static string JourCourt(DateTime d)
    {
        if (d == DateTime.Today) return L.T("Aujourd'hui");
        if (d == DateTime.Today.AddDays(1)) return L.T("Demain");
        // Nom complet : en malgache, les jours commencent presque tous par « Ala… ».
        return L.Majuscule(L.Jour(d.DayOfWeek)) + " " + d.Day;
    }

    private static string Horaire(CalendarEvent e)
        => e.TouteLaJournee || string.IsNullOrWhiteSpace(e.HeureDebut)
            ? L.T("Toute la journée")
            : string.IsNullOrWhiteSpace(e.HeureFin) ? e.HeureDebut! : e.HeureDebut + " – " + e.HeureFin;

    protected override void OnInitialized()
    {
        Store.DataChanged += Refresh;
        Compute();
    }

    protected override void OnParametersSet() => Compute();

    private void Refresh() => _ = InvokeAsync(() => { Compute(); StateHasChanged(); });

    private void GoToUsers(string? status, string? role)
        => State.NavigateWithUsersFilter(status, role);

    private void GoToUser(string id) => State.NavigateToUser(id);

    private void OpenPhoto(UserAccount u) => _viewer = u;

    private static string FormatMoney(double value)
        => value.ToString("N0", Fr) + " Ar";

    private void Compute()
    {
        var users = Store.Users;
        total = users.Count;
        actifs = users.Count(u => u.Actif);
        inactifs = users.Count(u => !u.Actif);
        admins = users.Count(u => u.Role == "Administrateur");
        archives = Store.ArchivedUsers.Count;
        gestionnaires = users.Count(u => u.Role == "Gestionnaire");

        static int R(IReadOnlyList<UserAccount> list, string role) => list.Count(u => u.Role == role);
        roleChart = new List<ChartBars.ChartItem>
        {
            new(L.T("Administrateur"), R(users, "Administrateur"), "#4f46e5"),
            new(L.T("Gestionnaire"), R(users, "Gestionnaire"), "#0891b2"),
            new(L.T("Utilisateur"), R(users, "Utilisateur"), "#059669")
        };

        RecentUsers = users.OrderByDescending(u => u.DateCreation)
            .Take(5)
            .ToList();

        // Pour vous
        var today = DateTime.Today;
        var me = Store.GetCurrentUser()?.Identifiant ?? "";
        bool EstMoi(string? id) => !string.IsNullOrEmpty(me) && string.Equals(id, me, StringComparison.OrdinalIgnoreCase);
        mesMessages = me.Length > 0 && Store.Can(Permissions.MessagerieUse) ? Store.UnreadCount(me) : 0;
        mesVotes = Store.Votes.Count(v => v.EstOuvert && !v.Bulletins.Any(b => EstMoi(b.VotantIdentifiant)));
        var mes = Store.Taches.Where(t => t.Statut != TacheStatuts.Terminee && t.Assignes.Any(EstMoi)).ToList();
        mesTaches = mes.Count;
        mesTachesRetard = mes.Count(t => DataStore.TryParseYmd(t.Echeance, out var d) && d.Date < today);
        mesImpayes = Store.Cotisations.Where(c => c.Statut == CotisationStatuts.EnAttente && EstMoi(c.MembreIdentifiant)).Sum(c => c.Montant);

        // Les 7 prochains jours
        Semaine = Enumerable.Range(0, 7).Select(i => today.AddDays(i))
            .SelectMany(d => Store.Events.Where(e => CalendarPage.OccursOn(e, d))
                .OrderBy(e => e.TouteLaJournee ? "" : e.HeureDebut ?? "")
                .Select(e => (d, e)))
            .Take(8).ToList();
        evenementsAujourdhui = Store.Events.Count(e => CalendarPage.OccursOn(e, today));

        // À traiter
        var tous = Voit("rappels", Permissions.RappelsUse) ? Store.GetRappels() : Array.Empty<Rappel>();
        rappelsCount = tous.Count;
        static int Rang(string p) => p == CalendarEventTypes.PrioriteUrgente ? 0 : p == CalendarEventTypes.PrioriteImportante ? 1 : 2;
        Rappels = tous.OrderBy(r => Rang(r.Priorite)).Take(5).ToList();
        doublons = Store.Can(Permissions.UsersManage) ? Store.GroupesDeDoublons().Count : 0;

        // Réunions & présence
        ReunionsCount = Store.Reunions.Count;
        presencePresent = presenceAbsent = presenceExcuse = presenceNonPointe = 0;
        foreach (var r in Store.Reunions)
        {
            foreach (var p in r.Participants)
            {
                if (!r.Presences.TryGetValue(p, out var s)) presenceNonPointe++;
                else if (s == PresenceStatuts.Present) presencePresent++;
                else if (s == PresenceStatuts.Absent) presenceAbsent++;
                else if (s == PresenceStatuts.Excuse) presenceExcuse++;
                else presenceNonPointe++;
            }
        }
        presenceChart = new List<ChartBars.ChartItem>
        {
            new(L.T("Présents"), presencePresent, "#059669"),
            new(L.T("Excusés"), presenceExcuse, "#d97706"),
            new(L.T("Absents"), presenceAbsent, "#dc2626"),
            new(L.T("Non pointés"),presenceNonPointe, "#64748b")
        };
    }

    private static string ActivityIcon(string type) => type switch
    {
        ActivityTypes.Login => "🔐",
        ActivityTypes.Logout => "👋",
        ActivityTypes.Create => "➕",
        ActivityTypes.Update => "✏️",
        ActivityTypes.Delete => "🗑️",
        ActivityTypes.Activate => "✅",
        ActivityTypes.Deactivate => "⛔",
        ActivityTypes.PasswordReset => "🔑",
        ActivityTypes.Export => "⇩",
        ActivityTypes.Import => "⇪",
        ActivityTypes.FieldsChange => "🧩",
        _ => "•"
    };

    private static string FormatTimeAgo(string iso) => DataStore.FormatDateCourte(iso);

    public void Dispose() => Store.DataChanged -= Refresh;
}
