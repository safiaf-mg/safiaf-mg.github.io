@implements IDisposable
@inject DataStore Store
@inject AppState State
@inject NativeFileSaver Saver

@if (_user != null)
{
    <div class="detail-hero">
        <div class="detail-hero-main">
            <button class="avatar-btn" type="button" @onclick="OpenPhoto" aria-label="@L.T("Agrandir la photo")">
                <Avatar UserName="@_user.NomComplet" Seed="@_user.Identifiant" Size="lg" Photo="@_user.Photo" />
            </button>
            <h2>@_user.NomComplet</h2>
            <div class="detail-sub">@@@_user.Identifiant</div>
            <div class="detail-badges">
                <Badge Text="@L.T(_user.Role)" Kind="role" />
                <Badge Text="@L.T(_user.Statut)" Kind="@(_user.Actif ? "active" : "inactive")" />
                @if (_user.EstMineur)
                {
                    <span class="badge badge-minor">@L.T("Mineur")</span>
                }
            </div>
        </div>
        @if (Store.Can(Permissions.UsersManage))
        {
            <button class="btn btn-primary detail-edit-btn" @onclick="() => OnEdit.InvokeAsync(_user.Id)">✎ @L.T("Modifier")</button>
        }
    </div>

    <div class="section">
        <h3>@L.T("Coordonnées")</h3>
        <div class="kv-row"><span class="kv-label">@L.T("E-mail")</span><span class="kv-value">@(string.IsNullOrWhiteSpace(_user.Email) ? "—" : _user.Email)</span></div>
        <div class="kv-row"><span class="kv-label">@L.T("Téléphone")</span><span class="kv-value">@(string.IsNullOrWhiteSpace(_user.Telephone) ? "—" : _user.Telephone)</span></div>
        <div class="kv-row"><span class="kv-label">@L.T("Matricule")</span><span class="kv-value">@(string.IsNullOrWhiteSpace(_user.Matricule) ? "—" : _user.Matricule)</span></div>
        @if (_user.EstMineur || !string.IsNullOrWhiteSpace(_user.ResponsableLegal))
        {
            var (respNom, respTel) = Store.ResponsableAffiche(_user);
            <div class="kv-row"><span class="kv-label">@L.T("Responsable légal")</span><span class="kv-value">@(string.IsNullOrWhiteSpace(respNom) ? L.T("À renseigner") : respNom)</span></div>
            @if (!string.IsNullOrWhiteSpace(respTel))
            {
                <div class="kv-row"><span class="kv-label">@L.T("Tél. du responsable")</span><span class="kv-value">@respTel</span></div>
            }
        }
    </div>

    var famille = Store.Famille(_user);
    var peutGererFamille = Store.Can(Permissions.UsersManage);
    @if (!famille.EstVide || peutGererFamille)
    {
        <div class="section family-section">
            <h3>👪 @L.T("Famille")</h3>
            @if (famille.EstVide)
            {
                <p class="text-muted family-empty">@L.T("Aucun lien de famille. Reliez ses parents, enfants, conjoint(e), frères et sœurs, gendre ou belle-fille, oncles, cousins… déjà inscrits.")</p>
            }
            @foreach (var groupe in famille.Groupes)
            {
                @FamilleLigne(groupe.Titre, groupe.Membres)
            }
            @if (peutGererFamille)
            {
                <div class="form-actions" style="margin:8px 0 4px">
                    <button class="btn btn-secondary btn-sm" @onclick="OuvrirLien">＋ @L.T("Ajouter un lien de famille")</button>
                </div>
            }
        </div>
    }

    <Modal Show="_lienOpen" Title="@L.T("Ajouter un lien de famille")" OnClose="() => _lienOpen = false">
        <div class="form-group">
            <label for="fam-type">@L.T("Lien")</label>
            <select id="fam-type" value="@_lienType" @onchange="e => _lienType = e.Value?.ToString() ?? LiensFamille.Parent">
                @foreach (var (groupe, types) in GroupesLiens())
                {
                    <optgroup label="@L.T(groupe)">
                        @foreach (var type in types)
                        {
                            <option value="@type" selected="@(type == _lienType)">@LiensFamille.Choix(type)</option>
                        }
                    </optgroup>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="fam-search">@L.T("Membre")</label>
            <input id="fam-search" type="text" placeholder="@L.T("Écrire pour chercher un membre…")" value="@_lienSearch"
                   @oninput="e => { _lienSearch = e.Value?.ToString() ?? string.Empty; _lienChoix = null; }" />
            <div class="family-pick">
                @foreach (var m in LienCandidats())
                {
                    var membre = m;
                    <button type="button" class="family-pick-item @(_lienChoix == membre.Identifiant ? "active" : "")" @onclick="() => _lienChoix = membre.Identifiant">
                        <Avatar UserName="@membre.NomComplet" Seed="@membre.Identifiant" Size="sm" Photo="@membre.Photo" />
                        <span><strong>@membre.NomComplet</strong><small>@@@membre.Identifiant</small></span>
                    </button>
                }
            </div>
        </div>
        @if (_lienChoix != null && Store.FindUserByIdentifier(_lienChoix) is { } choisi)
        {
            <p class="family-summary">@L.F("{0} sera indiqué(e) comme", choisi.NomComplet) <strong>@LienPhrase(_lienType)</strong> @L.F("de {0}.", _user.NomComplet)</p>
        }
        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="() => _lienOpen = false">@L.T("Annuler")</button>
            <button class="btn btn-primary" disabled="@(_lienChoix == null)" @onclick="AjouterLien">@L.T("Ajouter")</button>
        </div>
    </Modal>

    <div class="section">
        <h3>@L.T("Organisation")</h3>
        @if (_user.EstDecede)
        {
            <div class="kv-row"><span class="kv-label">🕊 @L.T("Date du décès")</span><span class="kv-value">@FormatDate(_user.DateDeces)</span></div>
        }
        <div class="kv-row"><span class="kv-label">@L.T("Rôle")</span><span class="kv-value">@L.T(_user.Role)</span></div>
        <div class="kv-row"><span class="kv-label">@L.T("Créé le")</span><span class="kv-value">@FormatDate(_user.DateCreation)</span></div>
        @if (!string.IsNullOrWhiteSpace(_user.DerniereConnexion))
        {
            <div class="kv-row"><span class="kv-label">@L.T("Dernière connexion")</span><span class="kv-value">@FormatDate(_user.DerniereConnexion)</span></div>
        }
    </div>

    <div class="section">
        <h3>🎂 @L.T("Anniversaire")</h3>
        @if (!string.IsNullOrWhiteSpace(_user.DateNaissance))
        {
            <div class="kv-row"><span class="kv-label">@L.T("Date de naissance")</span><span class="kv-value">@FormatDate(_user.DateNaissance) (@L.F("{0} ans", AgeLabel(_user.DateNaissance)))</span></div>
        }
        else
        {
            <div class="kv-row"><span class="kv-label">@L.T("Date de naissance")</span><span class="kv-value">—</span></div>
        }
        @foreach (var evt in BirthdayEvents)
        {
            <div class="kv-row"><span class="kv-label">📅 @DataStore.FormatDateCourte(evt.Date)</span><span class="kv-value">@evt.Titre</span></div>
        }
        @if (Store.Can(Permissions.CalendarUse) && !string.IsNullOrWhiteSpace(_user.DateNaissance) && BirthdayEvents.Count == 0)
        {
            <div class="form-actions" style="margin:8px 0 4px">
                <button class="btn btn-secondary btn-sm" @onclick="CreateBirthdayEvent">🎂 @L.T("Créer l'événement d'anniversaire")</button>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_user.Notes))
    {
        <div class="section">
            <h3>@L.T("Notes")</h3>
            <div class="kv-row"><span class="kv-label">—</span><span class="kv-value">@_user.Notes</span></div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_user.Signature))
    {
        <div class="section">
            <h3>@L.T("Signature électronique")</h3>
            <div class="kv-row">
                <span class="kv-label">@L.T("Signée")</span>
                <span class="kv-value">
                    <img class="signature-preview" src="@_user.Signature" alt="@L.F("Signature de {0}", _user.NomComplet)"
                         @onclick="OpenSignature" />
                </span>
            </div>
        </div>
    }

    @if (ActiveFields.Count > 0)
    {
        <div class="section">
            <h3>@L.T("Champs personnalisés")</h3>
            @foreach (var f in ActiveFields)
            {
                var val = f.Id == FieldDefinition.FIELD_IDENTIFIANT
                    ? new FieldValue { Texte = _user.Identifiant }
                    : _user.GetChamp(f.Id);
                var isFileField = f.Type is FieldType.Image or FieldType.PieceJointe;
                <div class="kv-row @(isFileField ? "kv-row-field" : "")">
                    <span class="kv-label">@f.Label</span>
                    <span class="kv-value">
                        @switch (f.Type)
                        {
                            case FieldType.Image:
                                if (val?.Fichier != null && !string.IsNullOrWhiteSpace(val.Fichier.Data))
                                {
                                    <div class="field-file">
                                        <img class="file-preview-img file-preview-tappable" src="@val.Fichier.Data" alt="@val.Fichier.Nom"
                                             @onclick="() => OpenImage(val.Fichier.Nom, val.Fichier.Data)" />
                                        <span class="file-name">@val.Fichier.Nom</span>
                                        <div class="file-actions">
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => OpenImage(val.Fichier.Nom, val.Fichier.Data)">👁 @L.T("Voir")</button>
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => OpenFile(val.Fichier)">⇱ @L.T("Ouvrir")</button>
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SaveFile(val.Fichier)">⇩ @L.T("Enregistrer")</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span>@(val?.Fichier?.Nom ?? "—")</span>
                                }
                                break;
                            case FieldType.PieceJointe:
                                if (val?.Fichier != null)
                                {
                                    <div class="field-file">
                                        <span class="file-info">📎 <span class="file-name">@val.Fichier.Nom</span><span class="file-size"> (@FormatSize(val.Fichier.Taille))</span></span>
                                        @if (!string.IsNullOrWhiteSpace(val.Fichier.Data))
                                        {
                                            <div class="file-actions">
                                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => OpenFile(val.Fichier)">⇱ @L.T("Ouvrir")</button>
                                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SaveFile(val.Fichier)">⇩ @L.T("Enregistrer")</button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                                break;
                            default:
                                <span>@FieldDisplay(f, val)</span>
                                break;
                        }
                    </span>
                </div>
            }
        </div>
    }

    @if (Store.IsManager)
        {
            <div class="section">
                <h3>@L.T("Actions")</h3>
                <div class="form-actions">
                    @if (CanToggleActive)
                    {
                        <button class="btn btn-secondary" @onclick="AskToggle">@(_user.Actif ? "⛔ " + L.T("Désactiver") : "✓ " + L.T("Activer"))</button>
                    }
                    @if (Store.Can(Permissions.UsersManage) && _user.Id != Store.GetCurrentUser()?.Id)
                    {
                        @if (_user.EstDecede)
                        {
                            <button class="btn btn-secondary" @onclick="AskAnnulerDeces">↺ @L.T("Annuler le décès")</button>
                        }
                        else
                        {
                            <button class="btn btn-secondary" @onclick="() => _decesOpen = true">🕊 @L.T("Enregistrer le décès")</button>
                        }
                    }
                    @if (Store.Can(Permissions.CarteMembreView))
                    {
                        <button class="btn btn-secondary" @onclick="OpenCarte">🪪 @L.T("Voir la carte de membre")</button>
                    }
                    @if (Store.IsAdmin)
                    {
                        <button class="btn btn-danger-outline" @onclick="AskDelete">🗑 @L.T("Supprimer")</button>
                    }
                </div>
            </div>
        }
        else if (SelfView)
        {
            <div class="section">
                <h3>@L.T("Actions")</h3>
                <div class="form-actions">
                    <p class="text-muted" style="margin:0 0 8px">@L.T("Pour corriger vos informations, demandez à un gestionnaire. Votre mot de passe se change depuis votre avatar, en haut.")</p>
                    @if (Store.Can(Permissions.CarteMembreView))
                    {
                        <button class="btn btn-secondary btn-block" @onclick="OpenCarte">🪪 @L.T("Voir ma carte de membre")</button>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="section">
                <h3>@L.T("Actions")</h3>
                <p class="muted">@L.T("Consultation seule : votre rôle ne permet pas de modifier ce compte.")</p>
            </div>
        }

@if (!SelfView)
    {
        <div class="form-actions" style="margin-bottom:8px">
            <button class="btn btn-secondary btn-block" @onclick="OnBack">← @L.T("Retour à la liste")</button>
        </div>
    }

    <DecesModal Show="_decesOpen" Membre="_user" OnClose="() => _decesOpen = false" />

    <ConfirmDialog Show="@_confirm.Show" Title="@_confirm.Title" Message="@_confirm.Message"
                   ConfirmLabel="@_confirm.ConfirmLabel" Danger="@_confirm.Danger"
                   OnConfirm="@(() => _confirm.Action?.Invoke())"
                   OnCancel="@(() => _confirm = _confirm with { Show = false })" />

    <PhotoViewer Current="@_viewer" OnClose="@(() => _viewer = null)" />

    <Modal Show="_previewUrl != null" Title="@_previewTitle" OnClose="() => _previewUrl = null">
        @if (_previewUrl != null)
        {
            <div class="image-viewer-wrap">
                <img class="image-viewer-img" src="@_previewUrl" alt="@_previewTitle" />
            </div>
        }
    </Modal>
}
else
{
    <EmptyState Icon="☹" Title="@L.T("Utilisateur introuvable")" Message="@L.T("Ce compte n'existe plus.")" />
    @if (!SelfView)
    {
        <div class="form-actions" style="margin:12px 0 8px">
            <button class="btn btn-secondary btn-block" @onclick="OnBack">← @L.T("Retour à la liste")</button>
        </div>
    }
}

@code {
    private sealed record ConfirmState(bool Show, string Title, string Message, string ConfirmLabel, bool Danger, Action? Action)
    {
        public static ConfirmState Hidden() => new(false, "", "", "OK", true, null);
    }

    [Parameter] public string? UserId { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<string> OnEdit { get; set; }
    [Parameter] public bool SelfView { get; set; }
    /// <summary>Ouvre la fiche d'un autre membre (lien de famille).</summary>
    [Parameter] public EventCallback<string> OnOpenUser { get; set; }

    private bool _decesOpen;
    private bool _lienOpen;
    private string _lienType = LiensFamille.Parent;

    /// <summary>Liens proposés par groupe, dans l'ordre réglé ; les liens ajoutés vont dans le dernier groupe.</summary>
    private IEnumerable<(string Groupe, List<string> Types)> GroupesLiens()
    {
        var choix = ListesChoix.Choix(ListesChoix.LiensDeFamille, _lienType);
        var dernier = LiensFamille.Groupes[^1].Item1;
        foreach (var (groupe, types) in LiensFamille.Groupes)
        {
            var dans = choix.Where(c => types.Contains(c.Cle) || (groupe == dernier && !c.DOrigine)).Select(c => c.Cle).ToList();
            if (dans.Count > 0) yield return (groupe, dans);
        }
    }
    private string _lienSearch = "";
    private string? _lienChoix;

    private RenderFragment FamilleLigne(string titre, IReadOnlyList<UserAccount> membres) => __builder =>
    {
        if (membres.Count == 0) return;
        <div class="kv-row family-row">
            <span class="kv-label">@titre</span>
            <span class="kv-value family-chips">
                @foreach (var m in membres)
                {
                    var membre = m;
                    var direct = _user != null && Store.LienEntre(_user, membre.Identifiant) != null;
                    <span class="family-chip">
                        <button type="button" class="family-chip-name" @onclick="() => OuvrirMembre(membre)">@membre.NomComplet</button>
                        @if (direct && Store.Can(Permissions.UsersManage))
                        {
                            <button type="button" class="family-chip-x" aria-label="@L.F("Retirer le lien avec {0}", membre.NomComplet)" @onclick="() => AskRetirerLien(membre)">✕</button>
                        }
                    </span>
                }
            </span>
        </div>
    };

    private async Task OuvrirMembre(UserAccount m)
    {
        if (OnOpenUser.HasDelegate) await OnOpenUser.InvokeAsync(m.Id);
        else State.NavigateToUser(m.Id);
    }

    private void OuvrirLien()
    {
        _lienType = LiensFamille.Parent;
        _lienSearch = "";
        _lienChoix = null;
        _lienOpen = true;
    }

    private IEnumerable<UserAccount> LienCandidats()
    {
        if (_user == null) return Enumerable.Empty<UserAccount>();
        var q = _lienSearch.Trim();
        return Store.Users
            .Where(u => u.Id != _user.Id && Store.LienEntre(_user, u.Identifiant) == null)
            .Where(u => q.Length == 0 || (u.NomComplet + " " + u.Identifiant).Contains(q, StringComparison.CurrentCultureIgnoreCase))
            .OrderBy(u => u.NomComplet, StringComparer.CurrentCultureIgnoreCase)
            .Take(8);
    }

    private static string LienPhrase(string type) => LiensFamille.Libelle(type).ToLowerInvariant();

    private void AjouterLien()
    {
        if (_user == null || _lienChoix == null) return;
        var res = Store.AjouterLienFamille(_user.Id, _lienChoix, _lienType);
        if (!res.Success) { State.NotifyError(res.Error); return; }
        _lienOpen = false;
        State.NotifySuccess(L.T("Lien de famille ajouté."));
    }

    private void AskRetirerLien(UserAccount m)
    {
        if (_user == null) return;
        var userId = _user.Id;
        _confirm = new ConfirmState(true, L.T("Retirer le lien de famille"),
            L.F("Retirer le lien entre « {0} » et « {1} » ? Les deux fiches restent inchangées.", _user.NomComplet, m.NomComplet),
            L.T("Retirer"), true, () =>
            {
                _confirm = ConfirmState.Hidden();
                var res = Store.RetirerLienFamille(userId, m.Identifiant);
                if (res.Success) State.NotifySuccess(L.T("Lien retiré."));
                else State.NotifyError(res.Error);
            });
    }

    private UserAccount? _user;
    private UserAccount? _viewer;
    private ConfirmState _confirm = ConfirmState.Hidden();
    private string? _previewUrl;
    private string _previewTitle = "";

    protected override void OnInitialized()
    {
        Store.DataChanged += OnChanged;
    }

    protected override void OnParametersSet()
    {
        _user = Store.FindUser(UserId ?? "");
    }

    private void OnChanged() => _ = InvokeAsync(() => { _user = Store.FindUser(UserId ?? ""); StateHasChanged(); });

    private IReadOnlyList<CalendarEvent> BirthdayEvents =>
        _user == null
            ? new List<CalendarEvent>()
            : Store.GetBirthdayEventsForUser(_user.Identifiant, _user.NomComplet);

    private static string AgeLabel(string ymd)
    {
        if (!DataStore.TryParseYmd(ymd, out var birth)) return "—";
        var today = DateTime.Today;
        var age = today.Year - birth.Year;
        if (today < birth.AddYears(age)) age--;
        return age < 0 ? "—" : age.ToString();
    }

    private void CreateBirthdayEvent()
    {
        if (_user == null) return;
        var res = Store.EnsureBirthdayEvent(_user.Id);
        if (res.Success) State.NotifySuccess(L.T("Événement d'anniversaire créé dans le calendrier."));
        else State.NotifyError(res.Error);
    }

    private void OpenPhoto() => _viewer = _user;

    private void OpenSignature()
    {
        if (_user == null || string.IsNullOrWhiteSpace(_user.Signature)) return;
        OpenImage(L.F("Signature — {0}", _user.NomComplet), _user.Signature);
    }

    private void OpenCarte()
    {
        if (_user == null || string.IsNullOrWhiteSpace(_user.Identifiant)) return;
        State.NavigateToCarte(_user.Identifiant);
    }

    private void OpenImage(string title, string dataUrl)
    {
        _previewTitle = title;
        _previewUrl = dataUrl;
    }

    /// <summary>Ouvre le fichier : aperçu intégré pour les images, application externe sinon.</summary>
    private async Task OpenFile(FileRef file)
    {
        if (string.IsNullOrWhiteSpace(file.Data))
        {
            State.NotifyError(L.T("Le contenu de ce fichier n'est pas disponible."));
            return;
        }
        if ((file.Mime ?? "").StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            OpenImage(file.Nom, file.Data);
            return;
        }
        var bytes = DecodeDataUrl(file.Data);
        if (bytes == null)
        {
            State.NotifyError(L.T("Impossible de lire le contenu du fichier."));
            return;
        }
        var opened = await Saver.OpenExternalAsync(file.Nom, bytes, file.Mime ?? "application/octet-stream");
        if (!opened) opened = await Saver.OpenWithChooserAsync(file.Nom, bytes, file.Mime ?? "application/octet-stream");
        if (!opened) State.NotifyError(L.T("Aucune application disponible pour ouvrir ce fichier. Utilisez « Enregistrer » puis ouvrez-le depuis Téléchargements."));
    }

    private async Task SaveFile(FileRef file)
    {
        if (string.IsNullOrWhiteSpace(file.Data))
        {
            State.NotifyError(L.T("Le contenu de ce fichier n'est pas disponible."));
            return;
        }
        var bytes = DecodeDataUrl(file.Data);
        if (bytes == null)
        {
            State.NotifyError(L.T("Impossible de lire le contenu du fichier."));
            return;
        }
        var path = await Saver.SaveAsync(file.Nom, bytes, file.Mime);
        State.Notify(path == null ? L.T("Échec de l'enregistrement du fichier.") : L.F("Fichier enregistré : {0}", path),
            path == null ? "error" : "success");
    }

    private static byte[]? DecodeDataUrl(string dataUrl)
    {
        var idx = dataUrl.IndexOf("base64,", StringComparison.Ordinal);
        if (idx < 0) return null;
        try { return Convert.FromBase64String(dataUrl[(idx + 7)..]); }
        catch { return null; }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return L.F("{0} o", bytes);
        if (bytes < 1024 * 1024) return L.F("{0} Ko", Math.Round(bytes / 1024.0, 1));
        return L.F("{0} Mo", Math.Round(bytes / (1024.0 * 1024), 1));
    }

    private IReadOnlyList<FieldDefinition> ActiveFields =>
        Store.Fields.Where(f => f.Actif).OrderBy(f => f.Ordre).ToList();

    private static string FieldDisplay(FieldDefinition f, FieldValue? val)
    {
        if (val == null) return "—";
        return f.Type switch
        {
            FieldType.Booleen => val.Booleen ? L.T("Oui") : L.T("Non"),
            FieldType.Nombre => val.Nombre?.ToString(CultureInfo.InvariantCulture) ?? "—",
            FieldType.Liste => string.IsNullOrWhiteSpace(val.Texte) ? "—" : val.Texte,
            FieldType.Date => DataStore.FormatDateCourte(val.Texte),
            _ => string.IsNullOrWhiteSpace(val.Texte) ? "—" : val.Texte
        };
    }

    private static string FormatDate(string s) => DataStore.FormatDateCourte(s);

    /// <summary>Le gestionnaire gère les comptes applicatifs ; le compte technique (dba) reste réservé à l'admin/dba.</summary>
    private bool CanToggleActive
    {
        get
        {
            if (_user == null) return false;
            if (_user.Role == Roles.BaseAdmin) return Store.IsAdmin;
            return Store.IsManager;
        }
    }

    private void AskAnnulerDeces()
    {
        if (_user == null) return;
        var userId = _user.Id;
        _confirm = new ConfirmState(true, L.T("Annuler le décès"),
            L.F("Le décès de « {0} » a été saisi par erreur ? Sa fiche redevient active.", _user.NomComplet),
            L.T("Annuler le décès"), false, () =>
            {
                _confirm = ConfirmState.Hidden();
                var res = Store.AnnulerDeces(userId);
                if (res.Success) State.NotifySuccess(L.T("Décès annulé."));
                else State.NotifyError(res.Error);
            });
    }

    private void AskToggle()
    {
        if (_user == null) return;
        var activate = !_user.Actif;
        _confirm = new ConfirmState(true, activate ? L.T("Activer") : L.T("Désactiver"),
            activate ? L.F("Voulez-vous vraiment activer « {0} » ?", _user.NomComplet) : L.F("Voulez-vous vraiment désactiver « {0} » ?", _user.NomComplet),
            activate ? L.T("Activer") : L.T("Désactiver"), !activate, () =>
            {
                var res = Store.SetUserActive(_user.Id, activate);
                State.Notify(res.Success ? (activate ? L.T("Utilisateur activé.") : L.T("Utilisateur désactivé.")) : L.F("Erreur : {0}", res.Error),
                    res.Success ? "success" : "error");
            });
    }

    private void AskReset()
    {
        if (_user == null) return;
        _confirm = new ConfirmState(true, L.T("Réinitialiser le mot de passe"),
            L.F("Le nouveau mot de passe de « {0} » sera : « {1} ».", _user.NomComplet, DataStore.DEFAULT_PASSWORD),
            L.T("Réinitialiser"), false, () =>
            {
                var res = Store.ResetPassword(_user.Id);
                State.Notify(res.Success ? L.F("Mot de passe réinitialisé : « {0} ».", DataStore.DEFAULT_PASSWORD) : L.F("Erreur : {0}", res.Error),
                    res.Success ? "success" : "error");
            });
    }

    private void AskDelete()
    {
        if (_user == null) return;
        _confirm = new ConfirmState(true, L.T("Supprimer l'utilisateur"),
            L.F("Supprimer « {0} » ? Le compte sera placé dans les archives.", _user.NomComplet),
            L.T("Supprimer"), true, () =>
            {
                var actor = Store.GetCurrentUser()?.Id;
                var res = Store.DeleteUser(_user.Id, actor);
                if (res.Success)
                {
                    State.NotifySuccess(L.T("Utilisateur supprimé et archivé."));
                    _ = OnBack.InvokeAsync();
                }
                else
                {
                    State.NotifyError(L.F("Erreur : {0}", res.Error));
                }
            });
    }

    public void Dispose() => Store.DataChanged -= OnChanged;
}