@implements IDisposable
@inject DataStore Store
@inject AppState State

<div class="page-head">
    <p class="cal-subtitle">
        @L.T("Vos événements et rappels, partagés avec toute la communauté")
        <svg class="cal-offline-icon" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 3v1M4.2 6.9l.7.7M1 12h1M4.2 17.1l-.7.7M12 20v1M19.8 17.1l.7.7M23 12h-1"/><circle cx="12" cy="15" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 9V6M9.5 12h.5M12 12h.5M14.5 12h.5"/></svg>
    </p>
</div>

@if (Store.Can(Permissions.CalendarUse) && Store.DoublonsCalendrier().Count is var doublons and > 0)
{
    <div class="quota-banner" role="status" style="margin-bottom:12px">
        <span class="quota-banner-icon" aria-hidden="true">⧉</span>
        <div class="quota-banner-main">
            <strong>@L.F("{0} événement(s) en double", doublons)</strong>
            <span>@L.T("Même titre, même jour et même heure. Le premier enregistré est gardé.")</span>
        </div>
        <button class="btn btn-secondary btn-sm" @onclick="() => _confirmDoublons = true">@L.T("Supprimer les doublons")</button>
    </div>
}

<div class="cal-toolbar">
    <div class="search-box cal-search">
        <span class="search-icon" aria-hidden="true">&#128269;</span>
        <input type="text" placeholder="@L.T("Rechercher un événement…")" value="@_search" @oninput="OnSearch" />
    </div>
    <button class="btn btn-secondary btn-sm cal-filter-btn @(_HasActiveFilters ? "active" : "")" @onclick="OpenFilters">
        <span aria-hidden="true">⚲</span> @L.T("Filtres")
        @if (_HasActiveFilters)
        {
            <Badge Text="@_activeFilterCount.ToString()" Kind="role" />
        }
    </button>
</div>

<div class="cal-view-tabs">
    <button class="cal-tab @(ViewCls("mois"))" @onclick="SetViewMois">@L.T("Mois")</button>
    <button class="cal-tab @(ViewCls("liste"))" @onclick="SetViewListe">@L.T("Liste")</button>
</div>

@if (_view == "mois")
{
    <div class="cal-month-nav">
        <button class="cal-month-nav-btn" aria-label="@L.T("Mois précédent")" @onclick="PrevMonth">‹</button>
        <button class="cal-month-label" @onclick="GoToday">@MonthLabel</button>
        <button class="cal-month-nav-btn" aria-label="@L.T("Mois suivant")" @onclick="NextMonth">›</button>
        <button class="btn btn-secondary btn-sm cal-today-btn" @onclick="GoToday">@L.T("Aujourd'hui")</button>
        <select class="cal-year-select" aria-label="@L.T("Choisir l'année")" value="@_month.Year" @onchange="OnYear">
            @foreach (var y in AvailableYears)
            {
                <option value="@y">@y</option>
            }
        </select>
    </div>

    <div class="card cal-month-card">
        <div class="cal-weekdays">
            @foreach (var wd in WeekDays)
            {
                <div class="cal-weekday">@wd</div>
            }
        </div>
        <div class="cal-grid">
            @foreach (var cell in _cells)
            {
                <button class="cal-day @(cell.ThisMonth ? "" : "other") @(cell.Date == DateTime.Today ? "today" : "") @(cell.Selected ? "selected" : "")"
                        @onclick="() => SelectDay(cell.Date)" tabindex="0">
                    <span class="cal-day-num">@cell.Date.Day</span>
                    @if (cell.Holiday != null)
                    {
                        <span class="cal-holiday-tag" title="@cell.Holiday">🎌</span>
                    }
                    @if (cell.EventCount > 0)
                    {
                        <span class="cal-dots">
                            @foreach (var c in cell.DotColors)
                            {
                                <span class="cal-dot" style="background:@c"></span>
                            }
                        </span>
                    }
                </button>
            }
        </div>
    </div>

    <div class="cal-add-below">
        <button class="btn btn-primary btn-block cal-add-btn" @onclick="() => OpenTypeSheet(DefaultAddDate)">
            <span aria-hidden="true">＋</span> @L.T("Ajouter un évènement")
        </button>
        <p class="cal-add-hint">@L.F("Pour le {0} — choisissez le type puis complétez la fiche.", FrDate(DefaultAddDate))</p>
    </div>
}
else
{
    <div class="cal-list">
        @if (FilteredEvents.Count == 0)
        {
            <EmptyState Icon="📅" Title="@L.T("Aucun événement")" Message="@L.T("Votre calendrier est vide pour le moment. Ajoutez un anniversaire, une réunion ou un rappel.")" />
        }
        else
        {
            @foreach (var group in GroupedByDay ?? Enumerable.Empty<IGrouping<DateTime, CalendarEvent>>())
            {
                <div class="cal-list-day">
                    <div class="cal-list-header">
                        <span class="cal-list-date">@WeekdayLabel(group.Key) — @FrDate(group.Key)</span>
                        <span class="cal-list-count">@L.F("{0} événement(s)", group.Count())</span>
                    </div>
                    @if (Holidays.GetFixedHoliday(group.Key) is string holidayLabel)
                    {
                        <div class="cal-holiday-card">🎌 @holidayLabel</div>
                    }
                    @foreach (var evt in group)
                    {
                        @RenderEventCard(evt)
                    }
                </div>
            }
        }
    </div>
}

@if (_view == "mois")
{
    // « Événement ce jour » : tous les types d'événements du jour sélectionné,
    // y compris les récurrents (anniversaires chaque année…), même si un filtre masque certains types.
    var _dayAll = DayEventsAll(_selectedDay ?? DateTime.Today);
    <div class="cal-day-section">
        <div class="cal-day-title">
            <span>@SelectedDayTitle</span>
            @if (SelectedDayHoliday != null)
            {
                <span class="cal-holiday-label">🎌 @SelectedDayHoliday</span>
            }
            @if (_dayAll.Count > 0)
            {
                <span class="cal-list-count">@L.F("{0} événement(s) ce jour", _dayAll.Count)</span>
            }
        </div>
        @if (_dayAll.Count == 0)
        {
            @if (Store.Events.Count == 0)
            {
                <EmptyState Icon="📅" Title="@L.T("Aucun événement")" Message="@L.T("Votre calendrier est vide pour le moment. Ajoutez un anniversaire, une réunion ou un rappel.")" />
            }
            else
            {
                <div class="cal-no-events">@L.T("Aucun événement ce jour.")</div>
            }
        }
        else
        {
            <div class="cal-events">
                @foreach (var evt in _dayAll)
                {
                    @RenderEventCard(evt, _selectedDay ?? DateTime.Today)
                }
            </div>
        }
    </div>
}

<Modal Show="_typeSheet" Title="@L.T("Ajouter un événement")" OnClose="() => _typeSheet = false">
    <div class="type-grid">
        @foreach (var t in AllTypes)
        {
            <button class="type-option" @onclick="() => StartNew(t.Item1)">
                <span class="type-icon" style="background:@Soft(CalendarEventTypes.Color(t.Item1));color:@CalendarEventTypes.Color(t.Item1)">@CalendarEventTypes.Icon(t.Item1)</span>
                <span class="type-label">@t.Item2</span>
            </button>
        }
    </div>
</Modal>

<Modal Show="_showForm" Title="@(_editing == null ? L.T("Nouvel événement") : L.T("Modifier l'événement"))" OnClose="CancelForm">
    <div class="form-group">
        <label for="ev-titre">@L.T("Titre *")</label>
        <input id="ev-titre" type="text" placeholder="@TitrePlaceholder" value="@_draft.Titre" @oninput="OnTitre" />
    </div>
    <div class="form-group">
        <label>@L.T("Type d'événement")</label>
        <div class="type-chips">
            @foreach (var (key, label) in AllTypes)
            {
                <button type="button" class="type-chip @(_draft.Type == key ? "active" : "")" @onclick="() => SetType(key)">
                    <span style="color:@CalendarEventTypes.Color(key)">@CalendarEventTypes.Icon(key)</span> @label
                </button>
            }
        </div>
    </div>
    <div class="form-group">
        <label for="ev-date">@L.T("Date *") <span class="field-hint" style="display:inline">@L.T("— format JJ/MM/AAAA")</span></label>
        <button type="button" class="cal-field-btn" @onclick="OpenDatePicker">
            <span class="cal-field-icon" aria-hidden="true"><CalendarTodayIcon Size="sm" /></span>
            <span class="cal-field-value">@DraftDateLabel</span>
            <span class="cal-field-go" aria-hidden="true">›</span>
        </button>
    </div>
    <div class="form-check">
        <input id="ev-fullday" type="checkbox" checked="@_draft.TouteLaJournee" @onchange="OnFullDay" />
        <label for="ev-fullday">@L.T("Toute la journée")</label>
    </div>
    @if (!_draft.TouteLaJournee)
    {
        <div class="cal-time-row">
            <div class="form-group cal-time-col">
                <label for="ev-heure">@L.T("Début")</label>
                <button type="button" class="cal-field-btn" @onclick="OpenDebutTime">
                    <span class="cal-field-icon" aria-hidden="true">🕐</span>
                    <span class="cal-field-value">@DraftTimeLabel("debut")</span>
                    <span class="cal-field-go" aria-hidden="true">›</span>
                </button>
            </div>
            <div class="form-group cal-time-col">
                <label for="ev-fin">@L.T("Fin")</label>
                <button type="button" class="cal-field-btn" @onclick="OpenFinTime">
                    <span class="cal-field-icon" aria-hidden="true">🕐</span>
                    <span class="cal-field-value">@DraftTimeLabel("fin")</span>
                    <span class="cal-field-go" aria-hidden="true">›</span>
                </button>
            </div>
        </div>
    }
    @if (ShowLieu)
    {
        <div class="form-group">
            <label for="ev-lieu">@L.T("Lieu")</label>
            <input id="ev-lieu" type="text" placeholder="@L.T("Ex : Salle de réunion")" value="@_draft.Lieu" @oninput="OnLieu" />
        </div>
    }
    @if (ShowPersonne)
    {
        <div class="form-group">
            <label>@L.F("Personne(s) concernée(s) ({0} sélectionnée(s))", _draft.PersonnesConcernees.Count)</label>
            @if (_draft.PersonnesConcernees.Count > 0)
            {
                <div class="person-chips">
                    @foreach (var pid in _draft.PersonnesConcernees.ToList())
                    {
                        var person = ActiveUsers.FirstOrDefault(x => x.Identifiant == pid);
                        <span class="person-chip">
                            <Avatar UserName="@UserName(pid)" Seed="@pid" Size="sm" Photo="@person?.Photo" />
                            <span>@UserName(pid)</span>
                            <button type="button" class="person-chip-remove" aria-label="@L.F("Retirer {0}", UserName(pid))" @onclick="() => RemovePerson(pid)">×</button>
                        </span>
                    }
                </div>
            }
            <div class="search-box cal-search cal-opt-search">
                <span class="search-icon" aria-hidden="true">&#128269;</span>
                <input type="search" placeholder="@L.T("Rechercher une personne puis l'ajouter…")" aria-label="@L.T("Rechercher une personne")"
                       value="@_personSearch" @oninput="OnPersonSearch" />
            </div>
            <div class="cal-persons-tools">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="SelectAllPersons">@L.T("Toutes")</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ClearPersons">@L.T("Aucune")</button>
            </div>
            <div class="cal-persons">
                @foreach (var u in SearchedPersons)
                {
                    var sel = _draft.PersonnesConcernees.Contains(u.Identifiant);
                    <button type="button" class="cal-person-row @(sel ? "selected" : "")" @onclick="() => TogglePerson(u.Identifiant)">
                        <Avatar UserName="@u.NomComplet" Seed="@u.Identifiant" Size="sm" Photo="@u.Photo" />
                        <span class="cal-person-name">@u.NomComplet <span class="text-muted" style="font-size:11.5px">@@@u.Identifiant</span></span>
                        <span class="cal-person-check" aria-hidden="true">@(sel ? "✓" : "")</span>
                    </button>
                }
                @if (SearchedPersons.Count == 0)
                {
                    <div class="cal-no-events">@L.F("Aucune personne trouvée pour « {0} ».", _personSearch)</div>
                }
            </div>
        </div>
    }
    <div class="form-group">
        <label>@L.T("Répétition")</label>
        <div class="choice-chips">
            @foreach (var (key, label) in RepetitionChoices)
            {
                <button type="button" class="chip @(_draft.Repetition == key ? "active" : "")" @onclick="() => SetRepetition(key)">@label</button>
            }
        </div>
    </div>
    @if (ShowPriorite)
    {
        <div class="form-group">
            <label>@L.T("Priorité")</label>
            <div class="choice-chips">
                @foreach (var (key, label) in PriorityChoices)
                {
                    <button type="button" class="chip @(_draft.Priorite == key ? "active" : "")" @onclick="() => SetPriorite(key)">@label</button>
                }
            </div>
        </div>
    }
    @if (ShowRappel)
    {
        <div class="form-group">
            <label>@L.T("Rappel")</label>
            <div class="choice-chips">
                @foreach (var (minutes, label) in ReminderChoices)
                {
                    <button type="button" class="chip @(_draft.RappelAvant == minutes ? "active" : "")" @onclick="() => SetRappel(minutes)">@label</button>
                }
            </div>
        </div>
    }
    @if (ShowStatut)
    {
        <div class="form-group">
            <label>@L.T("Statut")</label>
            <div class="choice-chips">
                @foreach (var (key, label) in StatutChoices)
                {
                    <button type="button" class="chip @(_draft.Statut == key ? "active" : "")" @onclick="() => SetStatut(key)">@label</button>
                }
            </div>
        </div>
    }
    @if (ShowDescription)
    {
        <div class="form-group">
            <label for="ev-notes">@L.T("Notes")</label>
            <textarea id="ev-notes" placeholder="@L.T("Ajouter une note...")" value="@_draft.Notes" @oninput="OnNotes"></textarea>
        </div>
    }
    <div class="form-actions">
        <button type="button" class="btn btn-secondary" @onclick="CancelForm">@L.T("Annuler")</button>
        <button type="button" class="btn btn-primary" @onclick="SaveEvent" disabled="@(_saving || string.IsNullOrWhiteSpace(_draft.Titre))">@L.T("Enregistrer")</button>
    </div>
</Modal>

<Modal Show="_datePickerOpen" Title="@L.T("Choisir la date")" OnClose="() => _datePickerOpen = false">
    <div class="cal-picker-head">
        <button type="button" class="cal-month-nav-btn" aria-label="@L.T("Mois précédent")" @onclick="DatePickerPrevMonth">‹</button>
        <span class="cal-picker-month">@DatePickerMonthLabel</span>
        <button type="button" class="cal-month-nav-btn" aria-label="@L.T("Mois suivant")" @onclick="DatePickerNextMonth">›</button>
    </div>
    <div class="cal-weekdays">
        @foreach (var wd in WeekDays)
        {
            <div class="cal-weekday">@wd</div>
        }
    </div>
    <div class="cal-grid">
        @foreach (var d in DatePickerCells)
        {
            var isSel = d == _datePickerSelected;
            var isToday = d == DateTime.Today;
            <button type="button" class="cal-day @(d.Month == _datePickerMonth.Month ? "" : "other") @(isToday ? "today" : "") @(isSel ? "selected" : "")"
                    @onclick="() => PickDate(d)">
                <span class="cal-day-num">@d.Day</span>
            </button>
        }
    </div>
    <div class="form-actions" style="margin-top:14px">
        <button type="button" class="btn btn-secondary" @onclick="() => _datePickerOpen = false">@L.T("Annuler")</button>
        <button type="button" class="btn btn-primary" @onclick="ConfirmDate">OK</button>
    </div>
</Modal>

<Modal Show="_timePickerOpen" Title="@L.T("Choisir l'heure")" OnClose="() => _timePickerOpen = false">
    <div class="time-tabs">
        <button type="button" class="time-tab @(_timePickerTarget == "debut" ? "active" : "")" @onclick="SwitchToDebut">🕐 @L.T("Début")</button>
        <button type="button" class="time-tab @(_timePickerTarget == "fin" ? "active" : "")" @onclick="SwitchToFin">🕐 @L.T("Fin")</button>
    </div>
    <div class="time-display">@TimePickerLabel</div>
    <div class="time-steppers">
        <div class="time-stepper">
            <button type="button" class="time-stepper-btn" aria-label="@L.T("Heure précédente")" @onclick="DecHour">−</button>
            <div class="time-stepper-val">@(_timePickerHours.ToString("00"))</div>
            <button type="button" class="time-stepper-btn" aria-label="@L.T("Heure suivante")" @onclick="IncHour">+</button>
            <span class="time-stepper-unit">h</span>
        </div>
        <div class="time-stepper">
            <button type="button" class="time-stepper-btn" aria-label="@L.T("Minute précédente")" @onclick="DecMinute">−</button>
            <div class="time-stepper-val">@(_timePickerMinutes.ToString("00"))</div>
            <button type="button" class="time-stepper-btn" aria-label="@L.T("Minute suivante")" @onclick="IncMinute">+</button>
            <span class="time-stepper-unit">min</span>
        </div>
    </div>
    <div class="time-quick">
        <span class="time-quick-label">@L.T("Minutes rapides")</span>
        <div class="time-quick-chips">
            @foreach (var m in QuickMinutes)
            {
                <button type="button" class="chip @(_timePickerMinutes == m ? "active" : "")" @onclick="() => QuickMinute(m)">@m.ToString("00")</button>
            }
        </div>
    </div>
    @if (_timePickerTarget == "fin" && !string.IsNullOrWhiteSpace(_draft.HeureDebut))
    {
        <button type="button" class="btn btn-secondary btn-block" @onclick="SetFinAsDebut">@L.T("Même heure que le début")</button>
    }
    <div class="form-actions" style="margin-top:14px">
        <button type="button" class="btn btn-secondary" @onclick="() => _timePickerOpen = false">@L.T("Annuler")</button>
        <button type="button" class="btn btn-primary" @onclick="ConfirmTime">OK</button>
    </div>
</Modal>

<Modal Show="_filtersOpen" Title="@L.T("Filtrer le calendrier")" OnClose="() => _filtersOpen = false">
    <div class="cal-filter-section">
        <div class="divider-section">@L.T("Types")</div>
        <div class="check-group">
            @foreach (var (key, label) in FilterTypes)
            {
                <label class="form-check">
                    <input type="checkbox" checked="@_typeFilter.Contains(key)" @onchange="() => ToggleType(key)" />
                    <span style="color:@CalendarEventTypes.Color(key)">@CalendarEventTypes.Icon(key)</span> @label
                </label>
            }
        </div>
        <div class="divider-section">@L.T("Utilisateurs")</div>
        <div class="radio-row">
            <label class="radio-option">
                <input type="radio" name="ev-user" checked="@(_userFilter == null)" @onchange="() => { _userFilter = null; Compute(); }" />
                @L.T("Tous")
            </label>
            @foreach (var u in Store.Users.Where(u => u.Actif).OrderBy(u => u.NomComplet))
            {
                <label class="radio-option">
                    <input type="radio" name="ev-user" checked="@(_userFilter == u.Identifiant)" @onchange="() => { _userFilter = u.Identifiant; Compute(); }" />
                    @u.NomComplet
                </label>
            }
        </div>
        <div class="divider-section">@L.T("Priorité")</div>
        <div class="radio-row">
            @foreach (var (key, label) in PriorityFilterChoices)
            {
                <label class="radio-option">
                    <input type="radio" name="ev-prio" checked="@(PriorityChecked(key))" @onchange="() => SetPriority(key)" />
                    @label
                </label>
            }
        </div>
    </div>
    <div class="form-actions filter-actions">
        <button type="button" class="btn btn-secondary" @onclick="ResetFilters">@L.T("Réinitialiser")</button>
        <button type="button" class="btn btn-primary" @onclick="() => { _filtersOpen = false; Compute(); }">@L.T("Appliquer les filtres")</button>
    </div>
</Modal>

<Modal Show="_detailEvent != null" Title="@(_detailEvent == null ? "" : _detailEvent.Titre)" OnClose="CloseDetail">
    <ChildContent>
        @if (_detailEvent != null)
        {
            var d = _detailEvent;
            var c = CalendarEventTypes.Color(d.Type);
            <div class="cal-detail">
                <div class="cal-card-type" style="color:@c;background:@Soft(c)">@CalendarEventTypes.Icon(d.Type) @CalendarEventTypes.Label(d.Type)</div>
                <div class="cal-detail-row">📅 @WeekdayLabel(ParseDate(d.Date)) — @FrDate(ParseDate(d.Date))</div>
                @if (d.TouteLaJournee)
                {
                    <div class="cal-detail-row">⏳ @L.T("Toute la journée")</div>
                }
                else
                {
                    <div class="cal-detail-row">🕒 @L.T("Début") @(d.HeureDebut ?? "—")@(d.HeureFin != null ? " · " + L.T("Fin") + " " + d.HeureFin : "")</div>
                }
                @if (!string.IsNullOrWhiteSpace(d.Lieu))
                {
                    <div class="cal-detail-row">📍 @d.Lieu</div>
                }
                @if (EventPersons(d).Count > 0)
                {
                    <div class="cal-detail-label">@L.T("Personne(s) concernée(s)")</div>
                    <div class="cal-detail-persons">
                        @foreach (var pid in EventPersons(d))
                        {
                            var person = Store.Users.FirstOrDefault(x => x.Identifiant == pid);
                            <button type="button" class="cal-detail-person" @onclick="() => OpenPerson(person?.Id)">
                                <Avatar UserName="@UserName(pid)" Seed="@pid" Size="sm" Photo="@person?.Photo" />
                                <span>@UserName(pid)</span>
                            </button>
                        }
                    </div>
                }
                @if (d.Repetition != CalendarEventTypes.RepetitionAucune)
                {
                    <div class="cal-detail-row">🔁 @RepetitionShort(d.Repetition)</div>
                }
                @if (d.RappelAvant > 0)
                {
                    <div class="cal-detail-row">⏰ @L.T("Rappel") @ReminderShort(d.RappelAvant)</div>
                }
                @if (d.Priorite != CalendarEventTypes.PrioriteNormale)
                {
                    <div class="cal-detail-row cal-priority-@(d.Priorite)">⚑ @PriorityLabel(d.Priorite).TrimStart('⚠', ' ')</div>
                }
                @if (d.Type == CalendarEventTypes.Tache)
                {
                    <div class="cal-detail-row">☑ @L.F("Statut : {0}", StatutLabel(d.Statut))</div>
                }
                @if (!string.IsNullOrWhiteSpace(d.Description))
                {
                    <div class="cal-detail-label">@L.T("Description")</div>
                    <div class="cal-detail-notes">@d.Description</div>
                }
                @if (!string.IsNullOrWhiteSpace(d.Notes))
                {
                    <div class="cal-detail-label">@L.T("Notes")</div>
                    <div class="cal-detail-notes">@d.Notes</div>
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="CloseDetail">@L.T("Fermer")</button>
        <button type="button" class="btn btn-danger-outline" @onclick="DetailDelete">🗑 @L.T("Supprimer")</button>
