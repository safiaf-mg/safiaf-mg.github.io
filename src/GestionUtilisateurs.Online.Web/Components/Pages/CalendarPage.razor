    </FooterContent>
</Modal>

<ConfirmDialog Show="_confirmDoublons" Title="@L.T("Supprimer les doublons")"
               Message="@L.F("{0} événement(s) en double seront supprimés ; l'original de chacun reste dans le calendrier.", Store.DoublonsCalendrier().Count)"
               ConfirmLabel="@L.T("Supprimer")" Danger="true" OnConfirm="SupprimerDoublons" OnCancel="() => _confirmDoublons = false" />

<ConfirmDialog Show="_deleteTarget != null" Title="@L.T("Supprimer l'événement")"
               Message="@(_deleteTarget == null ? "" : L.F("Supprimer « {0} » du calendrier ?", _deleteTarget.Titre))"
               ConfirmLabel="@L.T("Supprimer")" Danger="true" OnConfirm="ConfirmDelete" OnCancel="() => _deleteTarget = null" />

@code {
    private bool _confirmDoublons;

    private void SupprimerDoublons()
    {
        _confirmDoublons = false;
        var n = Store.DoublonsCalendrier().Count;
        var res = Store.SupprimerDoublonsCalendrier();
        if (res.Success) State.NotifySuccess(L.F("{0} doublon(s) supprimé(s).", n));
        else State.NotifyError(res.Error);
    }

    private static readonly CultureInfo Fr = CultureInfo.GetCultureInfo("fr-FR");

    private string _view = "mois";
    private DateTime _month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _selectedDay = DateTime.Today;
    private string _search = "";

    private readonly HashSet<string> _typeFilter = new();
    private string? _userFilter;
    private string? _priorityFilter;

    private bool _typeSheet;
    private bool _showForm;
    private bool _filtersOpen;
    private bool _saving;
    private CalendarEvent? _editing;
    private CalendarEvent? _deleteTarget;
    private CalendarEvent? _detailEvent;
    private EventDraft _draft = new();

    /// <summary>Types proposés (Paramètres › Listes de choix), plus le type de l'événement modifié.</summary>
    private (string, string)[] AllTypes
        => ListesChoix.Choix(ListesChoix.TypesEvenement, _showForm ? _draft.Type : null).Select(c => (c.Cle, c.Libelle)).ToArray();

    /// <summary>Tous les types, masqués compris (filtre du calendrier).</summary>
    private static (string, string)[] FilterTypes
        => ListesChoix.Elements(ListesChoix.TypesEvenement).Select(c => (c.Cle, c.Libelle)).ToArray();

    private static readonly (string, string)[] RepetitionChoices = new[]
    {
        (CalendarEventTypes.RepetitionAucune, L.T("Aucune")),
        (CalendarEventTypes.RepetitionQuotidienne, L.T("Tous les jours")),
        (CalendarEventTypes.RepetitionHebdomadaire, L.T("Toutes les semaines")),
        (CalendarEventTypes.RepetitionMensuelle, L.T("Tous les mois")),
        (CalendarEventTypes.RepetitionAnnuelle, L.T("Tous les ans"))
    };

    private (string, string)[] PriorityChoices
        => ListesChoix.Choix(ListesChoix.Priorites, _draft.Priorite).Select(c => (c.Cle, c.Libelle)).ToArray();

    private static (string, string)[] PriorityFilterChoices
        => ListesChoix.Elements(ListesChoix.Priorites).Select(c => (c.Cle, c.Libelle)).Prepend(("", L.T("Toutes"))).ToArray();

    private static readonly (int, string)[] ReminderChoices = new[]
    {
        (0, L.T("Aucun")),
        (5, L.T("5 minutes avant")),
        (10, L.T("10 minutes avant")),
        (30, L.T("30 minutes avant")),
        (60, L.T("1 heure avant")),
        (1440, L.T("1 jour avant"))
    };

    private static (string, string)[] StatutChoices
        => ListesChoix.Elements(ListesChoix.StatutsTache).Select(c => (c.Cle, c.Libelle)).ToArray();

    private static readonly string[] WeekDays = { L.T("Lun"), L.T("Mar"), L.T("Mer"), L.T("Jeu"), L.T("Ven"), L.T("Sam"), L.T("Dim") };

    private sealed class EventDraft
    {
        public string Titre = "";
        public string Type = CalendarEventTypes.Autre;
        public string Date = "";
        public string? HeureDebut;
        public string? HeureFin;
        public bool TouteLaJournee;
        public string Lieu = "";
        public List<string> PersonnesConcernees = new();
        public string Priorite = CalendarEventTypes.PrioriteNormale;
        public string Repetition = CalendarEventTypes.RepetitionAucune;
        public string Statut = CalendarEventTypes.StatutAFaire;
        public int RappelAvant;
        public string Notes = "";
    }

    private sealed record DayCell(DateTime Date, bool ThisMonth, int EventCount, string[] DotColors, bool Selected, string? Holiday);

    private List<DayCell> _cells = new();

    private IReadOnlyList<CalendarEvent> FilteredEvents { get; set; } = new List<CalendarEvent>();

    private IEnumerable<IGrouping<DateTime, CalendarEvent>>? GroupedByDay { get; set; } = null;

    private bool _HasActiveFilters => _typeFilter.Count > 0 || _userFilter != null || _priorityFilter != null;

    private int _activeFilterCount => _typeFilter.Count + (_userFilter != null ? 1 : 0) + (_priorityFilter != null ? 1 : 0);

    private DateTime DefaultAddDate => _selectedDay ?? DateTime.Today;

    private IReadOnlyList<UserAccount> ActiveUsers =>
        Store.Users.Where(u => u.Actif).OrderBy(u => u.NomComplet).ToList();

    private string _personSearch = "";

    private IReadOnlyList<UserAccount> SearchedPersons
    {
        get
        {
            var all = ActiveUsers;
            var q = _personSearch.Trim();
            if (q.Length == 0) return all;
            return all.Where(u => (u.NomComplet + " " + u.Identifiant + " " + (u.Email ?? ""))
                .Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private void OnPersonSearch(ChangeEventArgs e) => _personSearch = e.Value?.ToString() ?? "";

    private string MonthLabel
    {
        get
        {
            return L.Majuscule(L.MoisAnnee(_month));
        }
    }

    private string SelectedDayTitle
    {
        get
        {
            var d = _selectedDay ?? DateTime.Today;
            return d == DateTime.Today ? L.T("Aujourd'hui") + " — " + FrDate(d) : WeekdayLabel(d) + " — " + FrDate(d);
        }
    }

    private int[] AvailableYears
    {
        get
        {
            var current = DateTime.Today.Year;
            return Enumerable.Range(current - 80, 101).ToArray();
        }
    }

    private void OnYear(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y) && y >= 1900 && y <= 2100)
        {
            _month = new DateTime(y, _month.Month, 1);
            Compute();
        }
    }

    private string? SelectedDayHoliday => Holidays.GetFixedHoliday(_selectedDay ?? DateTime.Today);

    private string TitrePlaceholder => _draft.Type switch
    {
        CalendarEventTypes.Anniversaire => L.T("Ex : Anniversaire de Marie Dupont"),
        CalendarEventTypes.Reunion => L.T("Ex : Réunion équipe"),
        CalendarEventTypes.Rappel => L.T("Ex : Rappel important"),
        CalendarEventTypes.Tache => L.T("Ex : Terminer le rapport"),
        CalendarEventTypes.Evenement => L.T("Ex : Pot de départ"),
        CalendarEventTypes.Conge => L.T("Ex : Congé annuel"),
        CalendarEventTypes.Echeance => L.T("Ex : Rendu du dossier"),
        _ => L.T("Ex : Autre événement")
    };

    private bool ShowLieu => _draft.Type is CalendarEventTypes.Reunion or CalendarEventTypes.Evenement or CalendarEventTypes.Autre;
    private bool ShowPersonne => _draft.Type is CalendarEventTypes.Anniversaire or CalendarEventTypes.Reunion or CalendarEventTypes.Evenement or CalendarEventTypes.Conge or CalendarEventTypes.Tache;
    private bool ShowPriorite => _draft.Type is CalendarEventTypes.Rappel or CalendarEventTypes.Tache or CalendarEventTypes.Echeance;
    private bool ShowRappel => _draft.Type is CalendarEventTypes.Rappel or CalendarEventTypes.Echeance or CalendarEventTypes.Anniversaire or CalendarEventTypes.Reunion;
    private bool ShowStatut => _draft.Type == CalendarEventTypes.Tache;
    private bool ShowDescription => _draft.Type is CalendarEventTypes.Reunion or CalendarEventTypes.Evenement or CalendarEventTypes.Conge or CalendarEventTypes.Rappel or CalendarEventTypes.Echeance or CalendarEventTypes.Autre;

    protected override void OnInitialized()
    {
        Store.DataChanged += Refresh;
        Compute();
    }

    protected override void OnParametersSet() => Compute();

    private void Refresh() => _ = InvokeAsync(() => { Compute(); StateHasChanged(); });

    private void Compute()
    {
        FilteredEvents = Store.Events
            .Where(MatchFilters)
            .Where(MatchSearch)
            .ToList();

        GroupedByDay = FilteredEvents
            .GroupBy(e => ParseDate(e.Date))
            .OrderBy(g => g.Key)
            .ToList();

        BuildMonthGrid();
    }

    private bool MatchFilters(CalendarEvent e)
    {
        if (_typeFilter.Count > 0 && !_typeFilter.Contains(e.Type)) return false;
        if (_userFilter != null && !(e.PersonnesConcernees ?? new List<string>()).Contains(_userFilter) && e.PersonneConcernee != _userFilter) return false;
        if (_priorityFilter != null && e.Priorite != _priorityFilter) return false;
        return true;
    }

    private bool MatchSearch(CalendarEvent e)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var q = _search.Trim();
        return e.Titre.Contains(q, StringComparison.OrdinalIgnoreCase)
            || e.Lieu.Contains(q, StringComparison.OrdinalIgnoreCase)
            || e.Notes.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private void BuildMonthGrid()
    {
        var firstDay = new DateTime(_month.Year, _month.Month, 1);
        var offset = ((int)firstDay.DayOfWeek + 6) % 7;
        var start = firstDay.AddDays(-offset);
        var today = DateTime.Today;
        var selected = _selectedDay ?? today;

        var cells = new List<DayCell>();
        for (var i = 0; i < 42; i++)
        {
            var date = start.AddDays(i);
            var thisMonth = date.Year == _month.Year && date.Month == _month.Month;
            var events = FilteredEvents.Where(e => OccursOn(e, date)).ToList();
            var dots = events.Select(e => CalendarEventTypes.Color(e.Type))
                .Distinct()
                .Take(3)
                .ToArray();
            cells.Add(new DayCell(date, thisMonth, events.Count, dots, date == selected, Holidays.GetFixedHoliday(date)));
        }
        _cells = cells;
    }

    private List<CalendarEvent> DayEvents(DateTime day) =>
        FilteredEvents.Where(e => TryDate(e.Date, out var d) && d == day)
            .OrderBy(e => e.TouteLaJournee ? 0 : 1)
            .ThenBy(e => e.HeureDebut ?? "00:00")
            .ToList();

    /// <summary>Dit si un événement a lieu un jour donné (date exacte ou répétition).</summary>
    internal static bool OccursOn(CalendarEvent e, DateTime day)
    {
        if (!TryDate(e.Date, out var d)) return false;
        if (d.Date == day.Date) return true;
        var rep = e.Repetition ?? CalendarEventTypes.RepetitionAucune;
        if (rep == CalendarEventTypes.RepetitionAucune) return false;
        if (day.Date < d.Date)
        {
            // Anniversaire : revient chaque année même pour les naissances passées.
            if (rep != CalendarEventTypes.RepetitionAnnuelle) return false;
        }
        return rep switch
        {
            CalendarEventTypes.RepetitionQuotidienne => day.Date >= d.Date,
            CalendarEventTypes.RepetitionHebdomadaire => day.Date >= d.Date && (day.Date - d.Date).Days % 7 == 0,
            CalendarEventTypes.RepetitionMensuelle => day.Date >= d.Date && day.Day == d.Day,
            // Né un 29 février : fêté le 28 les années non bissextiles.
            CalendarEventTypes.RepetitionAnnuelle => (day.Month == d.Month && day.Day == d.Day)
                || (d.Month == 2 && d.Day == 29 && day.Month == 2 && day.Day == 28 && !DateTime.IsLeapYear(day.Year)),
            _ => false
        };
    }

    /// <summary>
    /// Tous les événements du jour (tous types, récurrences incluses, sans filtre) :
    /// alimente automatiquement « Événement ce jour » dès qu'il y en a.
    /// </summary>
    private List<CalendarEvent> DayEventsAll(DateTime day) =>
        Store.Events.Where(e => OccursOn(e, day))
            .OrderBy(e => e.TouteLaJournee ? 0 : 1)
            .ThenBy(e => e.HeureDebut ?? "00:00")
            .ThenBy(e => e.Titre)
            .ToList();

    private void GoToday()
    {
        var today = DateTime.Today;
        _month = new DateTime(today.Year, today.Month, 1);
        _selectedDay = today;
        Compute();
    }

    private void PrevMonth()
    {
        _month = _month.AddMonths(-1);
        Compute();
    }

    private void NextMonth()
    {
        _month = _month.AddMonths(1);
        Compute();
    }

    private void SelectDay(DateTime d)
    {
        _selectedDay = d;
        Compute();
    }

    private string ViewCls(string v) => _view == v ? "active" : "";

    private void SetView(string v)
    {
        _view = v;
        Compute();
    }

    private void SetViewMois() => SetView("mois");

    private void SetViewListe() => SetView("liste");

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        Compute();
    }

    private void OpenTypeSheet(DateTime date)
    {
        _selectedDay = date;
        _month = new DateTime(date.Year, date.Month, 1);
        _typeSheet = true;
    }

    private void StartNew(string type)
    {
        _typeSheet = false;
        _editing = null;
        _personSearch = "";
        _draft = new EventDraft
        {
            Type = type,
            Date = (_selectedDay ?? DateTime.Today).ToString("yyyy-MM-dd"),
            Priorite = type is CalendarEventTypes.Rappel or CalendarEventTypes.Tache or CalendarEventTypes.Echeance
                ? CalendarEventTypes.PrioriteNormale : CalendarEventTypes.PrioriteNormale,
            Repetition = type == CalendarEventTypes.Anniversaire ? CalendarEventTypes.RepetitionAnnuelle : CalendarEventTypes.RepetitionAucune
        };
        _showForm = true;
    }

    private void OpenEdit(CalendarEvent e)
    {
        _detailEvent = null;
        _editing = e;
        _personSearch = "";
        var persons = new List<string>(e.PersonnesConcernees ?? new List<string>());
        if (persons.Count == 0 && !string.IsNullOrWhiteSpace(e.PersonneConcernee))
            persons.Add(e.PersonneConcernee);
        _draft = new EventDraft
        {
            Titre = e.Titre,
            Type = e.Type,
            Date = e.Date,
            HeureDebut = e.HeureDebut,
            HeureFin = e.HeureFin,
            TouteLaJournee = e.TouteLaJournee,
            Lieu = e.Lieu,
            PersonnesConcernees = persons,
            Priorite = e.Priorite,
            Repetition = e.Repetition,
            Statut = e.Statut,
            RappelAvant = e.RappelAvant,
            Notes = e.Notes
        };
        _showForm = true;
    }

    private void CancelForm()
    {
        _showForm = false;
        _editing = null;
    }

    private void SaveEvent()
    {
        if (string.IsNullOrWhiteSpace(_draft.Titre)) return;
        if (string.IsNullOrWhiteSpace(_draft.Date)) return;

        _saving = true;
        StateHasChanged();
        try
        {
            if (_editing == null)
            {
                var result = Store.AddEvent(new CalendarEvent
                {
                    Type = _draft.Type,
                    Titre = _draft.Titre.Trim(),
                    Date = _draft.Date,
                    HeureDebut = _draft.TouteLaJournee ? null : _draft.HeureDebut,
                    HeureFin = _draft.TouteLaJournee ? null : _draft.HeureFin,
                    TouteLaJournee = _draft.TouteLaJournee,
                    Lieu = _draft.Lieu.Trim(),
                    PersonneConcernee = null,
                    PersonnesConcernees = _draft.PersonnesConcernees.Where(p => !string.IsNullOrWhiteSpace(p)).Distinct().ToList(),
                    Priorite = _draft.Priorite,
                    Repetition = _draft.Repetition,
                    Statut = _draft.Statut,
                    RappelAvant = _draft.TouteLaJournee ? 0 : _draft.RappelAvant,
                    Notes = _draft.Notes.Trim(),
                    Description = _draft.Notes.Trim()
                });
                if (result.Success)
                {
                    State.NotifySuccess(L.F("✓ {0} ajouté au calendrier.", CalendarEventTypes.Label(_draft.Type)));
                }
                else
                {
                    State.NotifyError(result.Error);
                }
            }
            else
            {
                var result = Store.UpdateEvent(_editing.Id, new CalendarEvent
                {
                    Type = _draft.Type,
                    Titre = _draft.Titre.Trim(),
                    Date = _draft.Date,
                    HeureDebut = _draft.TouteLaJournee ? null : _draft.HeureDebut,
                    HeureFin = _draft.TouteLaJournee ? null : _draft.HeureFin,
                    TouteLaJournee = _draft.TouteLaJournee,
                    Lieu = _draft.Lieu.Trim(),
                    PersonneConcernee = null,
                    PersonnesConcernees = _draft.PersonnesConcernees.Where(p => !string.IsNullOrWhiteSpace(p)).Distinct().ToList(),
                    Priorite = _draft.Priorite,
                    Repetition = _draft.Repetition,
                    Statut = _draft.Statut,
                    RappelAvant = _draft.TouteLaJournee ? 0 : _draft.RappelAvant,
                    Notes = _draft.Notes.Trim(),
                    Description = _draft.Notes.Trim()
                });
                if (result.Success)
                {
                    State.NotifyInfo(L.T("Événement modifié."));
                }
                else
                {
                    State.NotifyError(result.Error);
                }
            }

            _showForm = false;
            _editing = null;
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmDelete()
    {
        var target = _deleteTarget;
        _deleteTarget = null;
        if (target == null) return;
        var result = Store.DeleteEvent(target.Id);
        if (result.Success)
            State.NotifySuccess(L.T("Événement supprimé."));
        else
            State.NotifyError(result.Error);
    }

    private void OpenFilters() => _filtersOpen = true;

    private void ResetFilters()
    {
        _typeFilter.Clear();
        _userFilter = null;
        _priorityFilter = null;
        Compute();
    }

    private bool PriorityChecked(string key) => (_priorityFilter ?? string.Empty) == key;

    /// <summary>« Toutes » (clé vide) retire le filtre au lieu de chercher une priorité vide.</summary>
    private void SetPriority(string key)
    {
        _priorityFilter = string.IsNullOrEmpty(key) ? null : key;
        Compute();
    }

    private void ToggleType(string key)
    {
        if (!_typeFilter.Add(key)) _typeFilter.Remove(key);
        Compute();
    }

    private RenderFragment RenderEventCard(CalendarEvent e, DateTime? jour = null) => __builder =>
    {
        var c = CalendarEventTypes.Color(e.Type);
        var (m, _) = TimeLabel(e);
        var persons = EventPersons(e);
        <div class="cal-card" style="--evt-color:@c" role="button" tabindex="0" aria-label="@L.T("Afficher les détails")" @onclick="() => OpenDetail(e)" @onkeydown="(k) => OnCardKeyDown(k, e)">
            <div class="cal-card-time">@m</div>
            <div class="cal-card-main">
                <div class="cal-card-title">@e.Titre</div>
                <div class="cal-card-type" style="color:@c;background:@Soft(c)">@CalendarEventTypes.Icon(e.Type) @CalendarEventTypes.Label(e.Type)</div>
                @if (!string.IsNullOrWhiteSpace(e.Lieu))
                {
                    <div class="cal-card-meta"><span role="img" aria-label="@L.T("Lieu")">📍</span> @e.Lieu</div>
                }
                @if (_draft_isAnniversaire(e.Type))
                {
                    var age = AgeLabel(e, jour);
                    if (age != "")
                    {
                        <div class="cal-card-meta">@age</div>
                    }
                }
                @if (persons.Count > 0)
                {
                    <div class="cal-card-meta cal-card-persons">
                        @foreach (var pid in persons.Take(4))
                        {
                            <Avatar UserName="@UserName(pid)" Seed="@pid" Size="sm" Photo="@Store.Users.FirstOrDefault(u => u.Identifiant == pid)?.Photo" />
                        }
                        <span>@PersonsLabel(persons)</span>
                    </div>
                }
                @if (e.RappelAvant > 0)
                {
                    <div class="cal-card-meta">⏰ @L.T("Rappel") @ReminderShort(e.RappelAvant)</div>
                }
                @if (e.Priorite != CalendarEventTypes.PrioriteNormale)
                {
                    <div class="cal-card-meta cal-priority-@(e.Priorite)">@PriorityLabel(e.Priorite)</div>
                }
                @if (e.Type == CalendarEventTypes.Tache)
                {
                    <div class="cal-card-meta">@L.F("Statut : {0}", StatutLabel(e.Statut))</div>
                }
            </div>
            <div class="cal-card-menu" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg>
            </div>
        </div>
    };

    private void OpenDetail(CalendarEvent e) => _detailEvent = e;

    private void CloseDetail() => _detailEvent = null;

    private void DetailEdit()
    {
        var e = _detailEvent;
        if (e != null) OpenEdit(e);
    }

    private void DetailDelete()
    {
        var e = _detailEvent;
        _detailEvent = null;
        if (e != null) _deleteTarget = e;
    }

    private void OpenPerson(string? userId)
    {
        if (string.IsNullOrEmpty(userId)) return;
        if (Store.IsManager)
        {
            State.NavigateToUser(userId);
        }
        else
        {
            var u = Store.Users.FirstOrDefault(x => x.Id == userId);
            State.NotifyInfo(L.F("Votre profil : {0}", u?.NomComplet ?? L.T("utilisateur inconnu")));
        }
    }

    private void OnCardKeyDown(KeyboardEventArgs k, CalendarEvent e)
    {
        if (k.Key is "Enter" or " ") OpenDetail(e);
    }

    private static string PersonsLabel(List<string> persons) => persons.Count switch
    {
        0 => "",
        1 => persons[0],
        _ => L.F("{0} personnes", persons.Count)
    };

    private static List<string> EventPersons(CalendarEvent e)
    {
        var persons = e.PersonnesConcernees ?? new List<string>();
        if (persons.Count > 0) return persons;
        return string.IsNullOrWhiteSpace(e.PersonneConcernee)
            ? new List<string>()
            : new List<string> { e.PersonneConcernee };
    }

    private static string RepetitionShort(string rep) => rep switch
    {
        CalendarEventTypes.RepetitionQuotidienne => L.T("Tous les jours"),
        CalendarEventTypes.RepetitionHebdomadaire => L.T("Une fois par semaine"),
        CalendarEventTypes.RepetitionMensuelle => L.T("Une fois par mois"),
        CalendarEventTypes.RepetitionAnnuelle => L.T("Une fois par an"),
        _ => CalendarEventTypes.RepetitionAucune
    };

    private static bool _draft_isAnniversaire(string type) => type == CalendarEventTypes.Anniversaire;

    private void OnTitre(ChangeEventArgs e) => _draft.Titre = e.Value?.ToString() ?? "";

    private void SetType(string key)
    {
        if (key == _draft.Type) return;
        _draft.Type = key;
        if (key == CalendarEventTypes.Anniversaire && _draft.Repetition == CalendarEventTypes.RepetitionAucune)
            _draft.Repetition = CalendarEventTypes.RepetitionAnnuelle;
    }

    private void SetRepetition(string key) => _draft.Repetition = key;

    private void SetPriorite(string key) => _draft.Priorite = key;

    private void SetStatut(string key) => _draft.Statut = key;

    private void SetRappel(int minutes) => _draft.RappelAvant = minutes;

    private void OnFullDay(ChangeEventArgs e)
    {
        _draft.TouteLaJournee = e.Value is bool b ? b : e.Value?.ToString() == "on";
    }

    private void OnLieu(ChangeEventArgs e) => _draft.Lieu = e.Value?.ToString() ?? "";

    private void TogglePerson(string ident)
    {
        if (!_draft.PersonnesConcernees.Remove(ident))
            _draft.PersonnesConcernees.Add(ident);
    }

    private void RemovePerson(string ident) => _draft.PersonnesConcernees.Remove(ident);

    private void SelectAllPersons()
    {
        _draft.PersonnesConcernees = ActiveUsers.Select(u => u.Identifiant).Distinct().ToList();
    }

    private void ClearPersons() => _draft.PersonnesConcernees.Clear();

    private void OnNotes(ChangeEventArgs e) => _draft.Notes = e.Value?.ToString() ?? "";

    // ---------- Sélecteur de date personnalisé (français) ----------

    private bool _datePickerOpen;
    private DateTime _datePickerMonth;
    private DateTime? _datePickerSelected;

    private void OpenDatePicker()
    {
        if (TryDate(_draft.Date, out var current))
        {
            _datePickerMonth = new DateTime(current.Year, current.Month, 1);
            _datePickerSelected = current;
        }
        else
        {
            var today = DateTime.Today;
            _datePickerMonth = new DateTime(today.Year, today.Month, 1);
            _datePickerSelected = today;
        }
        _datePickerOpen = true;
    }

    private string DraftDateLabel
    {
        get
        {
            if (TryDate(_draft.Date, out var d))
                return WeekdayLabel(d) + " " + d.ToString("dd/MM/yyyy");
            return L.T("Choisir une date (JJ/MM/AAAA)");
        }
    }

    private string DatePickerMonthLabel
    {
        get
        {
            return L.Majuscule(L.MoisAnnee(_datePickerMonth));
        }
    }

    private List<DateTime> DatePickerCells
    {
        get
        {
            var first = new DateTime(_datePickerMonth.Year, _datePickerMonth.Month, 1);
            var offset = ((int)first.DayOfWeek + 6) % 7;
            var start = first.AddDays(-offset);
            var cells = new List<DateTime>();
            for (var i = 0; i < 42; i++) cells.Add(start.AddDays(i));
            return cells;
        }
    }

    private void DatePickerPrevMonth() => _datePickerMonth = _datePickerMonth.AddMonths(-1);

    private void DatePickerNextMonth() => _datePickerMonth = _datePickerMonth.AddMonths(1);

    private void PickDate(DateTime d) => _datePickerSelected = d;

    private void ConfirmDate()
    {
        if (_datePickerSelected != null)
            _draft.Date = _datePickerSelected.Value.ToString("yyyy-MM-dd");
        _datePickerOpen = false;
    }

    // ---------- Sélecteur d'heure personnalisé ----------

    private bool _timePickerOpen;
    private string _timePickerTarget = "debut";
    private int _timePickerHours;
    private int _timePickerMinutes;

    private static readonly int[] QuickMinutes = { 0, 5, 10, 15, 30, 45 };

    private void OpenTimePicker(string target)
    {
        _timePickerTarget = target;
        var (h, m) = ParseTime(target == "debut" ? _draft.HeureDebut : _draft.HeureFin);
        _timePickerHours = h;
        _timePickerMinutes = m;
        _timePickerOpen = true;
    }

    private string DraftTimeLabel(string target)
    {
        var t = target == "debut" ? _draft.HeureDebut : _draft.HeureFin;
        return string.IsNullOrWhiteSpace(t) ? "--:--" : t;
    }

    private string TimePickerLabel => _timePickerHours.ToString("00") + ":" + _timePickerMinutes.ToString("00");

    private void IncHour() => _timePickerHours = (_timePickerHours + 1) % 24;

    private void DecHour() => _timePickerHours = (_timePickerHours + 23) % 24;

    private void IncMinute() => _timePickerMinutes = (_timePickerMinutes + 5) % 60;

    private void DecMinute() => _timePickerMinutes = (_timePickerMinutes + 55) % 60;

    private void QuickMinute(int m) => _timePickerMinutes = m % 60;

    private void SwitchTimeTarget(string target) => _timePickerTarget = target;

    private void OpenDebutTime() => OpenTimePicker("debut");

    private void OpenFinTime() => OpenTimePicker("fin");

    private void SwitchToDebut() => SwitchTimeTarget("debut");

    private void SwitchToFin() => SwitchTimeTarget("fin");

    private void SetFinAsDebut()
    {
        var (h, m) = ParseTime(_draft.HeureDebut);
        _timePickerHours = h;
        _timePickerMinutes = m;
    }

    private void ConfirmTime()
    {
        var value = TimePickerLabel;
        if (_timePickerTarget == "debut") _draft.HeureDebut = value;
        else _draft.HeureFin = value;
        _timePickerOpen = false;
    }

    private static (int, int) ParseTime(string? t)
    {
        if (!string.IsNullOrWhiteSpace(t))
        {
            var parts = t.Split(':');
            if (parts.Length >= 2 && int.TryParse(parts[0], out var h) && int.TryParse(parts[1], out var m))
                return (Math.Clamp(h, 0, 23), Math.Clamp(m, 0, 59));
        }
        return (9, 0);
    }

    public void Dispose() => Store.DataChanged -= Refresh;

    // ---------- Helpers ----------

    private static DateTime ParseDate(string iso) => TryDate(iso, out var d) ? d : DateTime.Today;

    private static bool TryDate(string iso, out DateTime date)
    {
        date = DateTime.Today;
        return DateTime.TryParseExact(iso, "yyyy-MM-dd", Fr, DateTimeStyles.None, out date);
    }

    private static string FrDate(DateTime d) => d.ToString("dd/MM/yyyy");

    private static string WeekdayLabel(DateTime d) => L.Majuscule(L.Jour(d.DayOfWeek));

    private static string FrDateCourte(string iso) => DataStore.FormatDateCourte(iso);

    private static (string, string?) TimeLabel(CalendarEvent e)
    {
        if (e.TouteLaJournee) return (L.T("Toute la journée"), null);
        var h = e.HeureDebut ?? "—";
        if (h.Length >= 8 && h.EndsWith(":00", StringComparison.Ordinal)) h = h[..5];
        return (h, null);
    }

    private static string Soft(string hex) => hex.Length == 7 ? hex + "24" : hex;

    /// <summary>Âge fêté le jour affiché (ou âge actuel dans la liste).</summary>
    private static string AgeLabel(CalendarEvent e, DateTime? jour = null)
    {
        if (!TryDate(e.Date, out var birth)) return "";
        var ref_ = (jour ?? DateTime.Today).Date;
        var age = ref_.Year - birth.Year;
        if (ref_ < birth.AddYears(age)) age--;
        return age <= 0 ? "" : L.F("🎂 {0} ans", age);
    }

    private string UserName(string identifiant)
        => Store.Users.FirstOrDefault(u => u.Identifiant == identifiant)?.NomComplet ?? identifiant;

    private static string ReminderShort(int minutes) => minutes switch
    {
        5 => L.T("5 min avant"),
        10 => L.T("10 min avant"),
        30 => L.T("30 min avant"),
        60 => L.T("1 h avant"),
        1440 => L.T("1 jour avant"),
        _ => L.F("{0} min avant", minutes)
    };

    /// <summary>Priorité affichée sur la carte (rien pour « Normale »).</summary>
    private static string PriorityLabel(string p) => string.IsNullOrEmpty(p) || p == CalendarEventTypes.PrioriteNormale ? ""
        : (p == CalendarEventTypes.PrioriteUrgente ? "⚠ " : "") + CalendarEventTypes.PrioriteLabel(p);

    private static string StatutLabel(string s) => TacheStatuts.Label(s);
}