@inject DataStore Store
@inject JavascriptBridge Js
@inject IJSRuntime JSRuntime

@* Mini-guide de démarrage : visite fléchée ancrée aux éléments (spotlight).
   Chaque étape vise un repère réel (barre du bas, menu ⋮, avatar, logo, aide)
   avec flèche et texte adaptés à l'emplacement ; accueil et fin centrés.
   Responsive téléphone / tablette. *@
@if (Show)
{
    <div class="ob-overlay @(_place != null ? "ob-popmode" : "")" @ontouchstart="OnTouchStart" @ontouchend="OnTouchEnd">
        @if (_place == null)
        {
            <div class="ob-card" id="ob-card" role="dialog" aria-modal="true" aria-label="@L.T("Mini-guide de démarrage")"
                 tabindex="0" @ref="_cardRef" @onkeydown="OnKeyDown">
                <button type="button" class="ob-skip" @onclick="Skip">@L.T("Passer")</button>
                <div class="ob-anim" @key="_index">
                    <div class="ob-illus" aria-hidden="true">
                        <div class="ob-float">@Illustration(Steps[_index].Art)</div>
                    </div>
                    <div class="ob-body">
                        <h2 class="ob-title">@Steps[_index].Title</h2>
                        <p class="ob-text">@Steps[_index].Text</p>
                    </div>
                </div>
                @NavDots()
                @NavRow()
            </div>
        }
        else
        {
            @* La flèche est hors de la bulle (qui défile si l'écran est petit),
               sinon elle serait rognée et ne pointerait plus vers l'élément. *@
            <div class="ob-pop-wrap" style="left:@Px(_place.Left);@VAnchor(_place.Top, _place.Bottom)width:@Px(_place.Width)">
            @if (_place.ArrowLeft)
            {
                <div class="ob-arrow ob-left" aria-hidden="true" style="@VAnchor(_place.ArrowTop, _place.ArrowBottom)"></div>
            }
            else
            {
                <div class="ob-arrow @(_place.ArrowDown ? "ob-down" : "ob-up")" aria-hidden="true"
                     style="left:@Px(_place.ArrowX - 11)"></div>
            }
            <div class="ob-card ob-pop" id="ob-card" role="dialog" aria-modal="true" aria-label="@L.T("Mini-guide de démarrage")"
                 tabindex="0" @ref="_cardRef" @onkeydown="OnKeyDown">
                <button type="button" class="ob-skip" @onclick="Skip">@L.T("Passer")</button>
                <div class="ob-anim" @key="_index">
                    <h2 class="ob-title ob-title-pop">@Steps[_index].Title</h2>
                    <p class="ob-text">@Steps[_index].Text</p>
                </div>
                @NavDots()
                @NavRow()
            </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private sealed record Step(string Art, string Title, string Text, string? Target, bool Side = false);
    private sealed record Rect(double X, double Y, double W, double H, double Vw, double Vh, double Br = 0);
    /// <summary>
    /// Position de la bulle. Elle est ancrée par le haut (Top) ou par le bas
    /// (Bottom, distance au bas de l'écran) : la hauteur réelle de la bulle
    /// n'est pas connue ici, et l'ancrer du côté de la cible garde la flèche
    /// collée à l'élément, quelle que soit la longueur du texte.
    /// </summary>
    private sealed record Place(double Left, double? Top, double? Bottom, double Width,
        double ArrowX, bool ArrowDown, bool ArrowLeft = false, double? ArrowTop = null, double? ArrowBottom = null);

    private List<Step> Steps = new();
    private int _index;
    private bool _wasShown;
    private bool _openAck;
    private bool _busy;
    private Place? _place;
    private ElementReference _cardRef;
    private double? _touchX;

    protected override void OnInitialized() => Steps = BuildSteps(desktop: false);

    /// <summary>
    /// Étapes du guide. Sur ordinateur (≥ 1024 px), la barre du bas, le menu
    /// « ⋮ » et le logo du haut sont remplacés par le menu latéral : le guide
    /// présente donc ce menu à la place.
    /// </summary>
    private List<Step> BuildSteps(bool desktop)
    {
        var appName = string.IsNullOrWhiteSpace(Store.Settings.AppName)
            ? L.T("Gestion des utilisateurs") : Store.Settings.AppName;
        var steps = new List<Step>();
        // Le dernier écran montre le menu « Guide utilisateur », quelle que soit sa
        // place dans le menu ; Paramètres seulement s'il a été masqué du menu.
        var guide = !Store.IsMenuHidden("guide");
        // Les exemples cités suivent le rôle : on ne montre que ce que le membre peut ouvrir.
        var bas = new List<string> { L.T("Accueil"), Store.VoitListeMembres ? L.T("Utilisateurs") : L.T("Mes informations") };
        if (Store.PeutOuvrir("calendar")) bas.Add(L.T("Calendrier"));
        if (Store.PeutOuvrir("activity")) bas.Add(L.T("Activité"));
        var menu = new (string Cle, string Libelle)[]
        {
            ("messagerie", L.T("Messagerie")), ("services", L.T("Planning des services")), ("prieres", L.T("Intentions de prière")),
            ("taches", L.T("Tâches et suivi")), ("votes", L.T("Votes et décisions")),
            ("finances", L.T("Finances")), ("materiel", L.T("Matériel")), ("documents", L.T("Gestion documentaire")),
            ("carte", L.T("Carte de membre")), ("rappels", L.T("Rappels intelligents"))
        }.Where(m => Store.PeutOuvrir(m.Cle) && !Store.IsMenuHidden(m.Cle)).Select(m => m.Libelle).Take(4).ToList();
        var exemples = menu.Count > 0 ? string.Join(", ", menu) : L.T("Guide utilisateur");
        if (desktop)
        {
            steps.Add(new("", L.T("En haut à gauche : le logo"),
                L.T("Cliquez sur le logo pour afficher l'image en grand et parcourir l'histoire de votre communauté."), ".web-sidebar-logo", Side: true));
            steps.Add(new("", L.T("À gauche : le menu"),
                L.F("Toutes les pages sont dans ce menu : {0}…", string.Join(", ", bas.Concat(menu).Append(L.T("Paramètres")))), ".web-sidebar-nav", Side: true));
            steps.Add(new("", L.T("En haut à droite : votre avatar"),
                L.T("Cliquez sur votre photo pour ouvrir Mes informations, changer votre mot de passe ou vous déconnecter."), ".avatar-button"));
            steps.Add(new("", L.T("Sur chaque écran : l'aide ⓘ"),
                L.T("Ce bouton, à côté de votre avatar, ouvre l'aide de la page en cours. En cas de doute, il sait quoi faire."), ".topbar-help-btn"));
            steps.Add(guide
                ? new("ready", L.T("Vous êtes prêt·e !"),
                    L.T("Vous pouvez revoir ce guide à tout moment depuis « Guide utilisateur », ici dans le menu. Bon usage !"), ".web-nav-item[data-nav=\"guide\"]", Side: true)
                : new("ready", L.T("Vous êtes prêt·e !"),
                    L.T("Vous pouvez revoir ce guide à tout moment depuis Paramètres, ici dans le menu. Bon usage !"), ".web-nav-item[data-nav=\"settings\"]", Side: true));
        }
        else
        {
            steps.Add(new("", L.T("Tout se passe en bas"),
                L.F("Regardez la barre du bas : {0}, toujours à portée de pouce.", string.Join(", ", bas.Append(L.T("Paramètres")))), ".bottom-nav"));
            steps.Add(new("", L.T("Ici, le menu « ⋮ »"),
                L.F("En haut à droite : {0}… Tout le reste se trouve derrière ce bouton.", exemples), "[aria-label=\"" + L.T("Plus d'options") + "\"]"));
            steps.Add(new("", L.T("Juste à côté : votre avatar"),
                L.T("Touchez votre photo en haut à droite pour ouvrir Mes informations, changer votre mot de passe ou vous déconnecter."), ".avatar-button"));
            steps.Add(new("", L.T("En haut à gauche : le logo"),
                L.T("Touchez le logo pour afficher l'image en grand et parcourir l'histoire de votre communauté."), ".logo-btn"));
            steps.Add(new("", L.T("Sur chaque écran : l'aide ⓘ"),
                L.T("Ce bouton ouvre l'aide de la page en cours. En cas de doute, il sait quoi faire."), ".topbar-help-btn"));
            steps.Add(new("ready", L.T("Vous êtes prêt·e !"),
                guide
                    ? L.T("Pour revoir ce guide, ouvrez « ⋮ » puis « Guide utilisateur ». Astuce : glissez du bord gauche vers la droite pour revenir en arrière.")
                    : L.T("Pour revoir ce guide, ouvrez « ⋮ » puis Paramètres. Astuce : glissez du bord gauche vers la droite pour revenir en arrière."),
                "[aria-label=\"" + L.T("Plus d'options") + "\"]"));
        }
        steps.Insert(0, new("welcome", L.F("Bienvenue sur {0}", appName),
            L.F("Votre gestion communautaire en ligne, partagée avec tous les membres. Laissez-vous guider en {0} étapes.", steps.Count), null));
        return steps;
    }

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown) { _index = 0; _place = null; }
        _wasShown = Show;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Show && !_openAck)
        {
            _openAck = true;
            var desktop = false;
            try { desktop = await JSRuntime.InvokeAsync<bool>("guOnboarding.isDesktop"); } catch { }
            Steps = BuildSteps(desktop);
            _index = 0;
            try { await Js.LockBodyScrollAsync(); } catch { }
            try { await JSRuntime.InvokeVoidAsync("guOnboarding.focus", "ob-card"); } catch { }
            await RefreshSpotAsync();
        }
        else if (!Show && _openAck)
        {
            _openAck = false;
            try { await JSRuntime.InvokeVoidAsync("guCoach.unspot"); } catch { }
            try { await Js.UnlockBodyScrollAsync(); } catch { }
        }
    }

    private async Task RefreshSpotAsync()
    {
        try
        {
            _place = null;
            if (_index < 0 || _index >= Steps.Count) _index = Math.Clamp(_index, 0, Steps.Count - 1);
            var target = Steps[_index].Target;
            if (!string.IsNullOrWhiteSpace(target))
            {
                try
                {
                    var rect = await JSRuntime.InvokeAsync<Rect?>("guCoach.spot", target);
                    if (rect != null && rect.W > 0 && rect.H > 0 && rect.Vw > 0 && rect.Vh > 0)
                        _place = ComputePlace(rect, Steps[_index].Side);
                    else
                        try { await JSRuntime.InvokeVoidAsync("guCoach.unspot"); } catch { }
                }
                catch { _place = null; }
            }
            else
            {
                try { await JSRuntime.InvokeVoidAsync("guCoach.unspot"); } catch { }
            }
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
            try { await JSRuntime.InvokeVoidAsync("guOnboarding.focus", "ob-card"); } catch { }
        }
    }

    private static Place? ComputePlace(Rect r, bool side = false)
    {
        // Hauteur réelle d'une bulle (titre + texte + points + boutons) : ~340-380 px
        // sur téléphone étroit. Marge large pour ne jamais chevaucher la cible
        // (la cible est au-dessus du voile : tout chevauchement vole les clics).
        const double estH = 380;
        if (r.Vw <= 0 || r.Vh <= 0) return null;
        // Écran trop petit pour une bulle ancrée : carte centrée (toujours cliquable).
        if (r.Vh < estH + 60) return null;
        var phone = r.Vw < 720;
        var popW = phone ? r.Vw - 24 : 380;
        if (popW < 240) popW = Math.Max(200, r.Vw - 24);
        if (popW > r.Vw - 24) popW = Math.Max(200, r.Vw - 24);
        // Élément du menu latéral (ordinateur) : bulle à sa droite, flèche vers la gauche.
        if (side && SidePlace(r, popW, estH) is { } sp) return sp;
        var cx = r.X + r.W / 2;
        var left = Math.Min(Math.Max(cx - popW / 2, 12), Math.Max(12, r.Vw - popW - 12));
        var arrowX = Math.Min(Math.Max(cx - left, 30), popW - 30);
        if (r.Y + r.H + 12 + estH <= r.Vh)
            return new Place(left, r.Y + r.H + 12, null, popW, arrowX, false);
        if (r.Y - 12 - estH >= 0)
            return new Place(left, null, r.Vh - r.Y + 12, popW, arrowX, true);
        return SidePlace(r, popW, estH);
    }

    /// <summary>Bulle à droite de la cible, flèche vers la gauche à hauteur de la cible.</summary>
    private static Place? SidePlace(Rect r, double popW, double estH)
    {
        var left = Math.Max(r.X + r.W, r.Br) + 16;
        if (left + popW + 12 > r.Vw) return null;
        // Pointe vers le centre de la cible, ou vers son haut si elle est très haute (menu entier).
        var targetY = r.H > 120 ? r.Y + 30 : r.Y + r.H / 2;
        if (targetY <= r.Vh / 2)
        {
            var top = Math.Max(12, targetY - 40);
            return new Place(left, top, null, popW, 0, false, true, ArrowTop: targetY - top - 11);
        }
        // Cible dans le bas de l'écran : la bulle monte depuis la cible.
        var bottom = Math.Max(12, r.Vh - targetY - 40);
        return new Place(left, null, bottom, popW, 0, false, true, ArrowBottom: r.Vh - targetY - bottom - 11);
    }

    private static string VAnchor(double? top, double? bottom)
        => top is { } t ? "top:" + Px(t) + ";" : "bottom:" + Px(bottom ?? 0) + ";";

    private static string Px(double v) => v.ToString("0", System.Globalization.CultureInfo.InvariantCulture) + "px";

    private RenderFragment NavDots() => @<div class="ob-dots" role="tablist" aria-label="@L.T("Étapes du guide")">
        @for (var i = 0; i < Steps.Count; i++)
        {
            var idx = i;
            <button type="button" role="tab" aria-selected="@(idx == _index)"
                    aria-label="@L.F("Aller à l'étape {0} sur {1}", idx + 1, Steps.Count)"
                    class="ob-dot @(idx == _index ? "active" : "")" @onclick="() => Go(idx)"></button>
        }
    </div>;

    private RenderFragment NavRow() => @<div class="ob-nav">
        @if (_index > 0)
        {
            <button type="button" class="btn btn-secondary ob-btn" @onclick="Prev">@L.T("← Précédent")</button>
        }
        else
        {
            <span class="ob-nav-spacer"></span>
        }
        @if (_index < Steps.Count - 1)
        {
            <button type="button" class="ob-btn ob-primary" @onclick="Next">@L.T("Suivant →")</button>
        }
        else
        {
            <button type="button" class="ob-btn ob-primary" @onclick="Finish">@L.T("Terminer ✓")</button>
        }
    </div>;

    private async Task Next()
    {
        if (_busy || _index >= Steps.Count - 1) return;
        _busy = true;
        try { _index++; await RefreshSpotAsync(); }
        finally { _busy = false; }
    }
    private async Task Prev()
    {
        if (_busy || _index <= 0) return;
        _busy = true;
        try { _index--; await RefreshSpotAsync(); }
        finally { _busy = false; }
    }
    private async Task Go(int idx)
    {
        if (_busy || idx < 0 || idx >= Steps.Count || idx == _index) return;
        _busy = true;
        try { _index = idx; await RefreshSpotAsync(); }
        finally { _busy = false; }
    }
    private async Task Finish() => await OnClose.InvokeAsync();
    private async Task Skip() => await OnClose.InvokeAsync();

    private void OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowRight": _ = Next(); break;
            case "ArrowLeft": _ = Prev(); break;
            case "Home": _ = Go(0); break;
            case "End": _ = Go(Steps.Count - 1); break;
            case "Escape": _ = Skip(); break;
        }
    }

    private void OnTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length > 0) _touchX = e.Touches[0].ClientX;
    }

    private void OnTouchEnd(TouchEventArgs e)
    {
        if (_touchX == null || e.ChangedTouches.Length == 0) { _touchX = null; return; }
        var dx = e.ChangedTouches[0].ClientX - _touchX.Value;
        _touchX = null;
        if (dx <= -60) _ = Next();
        else if (dx >= 60) _ = Prev();
    }

    private static RenderFragment Illustration(string art) => art switch
    {
        "ready" => @<svg viewBox="0 0 240 160" role="presentation">
            <rect x="8" y="8" width="224" height="144" rx="24" fill="#EEF2FF" />
            <ellipse cx="120" cy="142" rx="66" ry="7" fill="#4F46E5" opacity="0.10" />
            <circle cx="120" cy="78" r="36" fill="#4F46E5" />
            <circle cx="120" cy="78" r="36" fill="none" stroke="#C7D2FE" stroke-width="3" opacity="0.55" />
            <path d="M103 78l12 12 23 -25" fill="none" stroke="#FFFFFF" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="66" cy="48" r="4" fill="#A5B4FC" />
            <circle cx="176" cy="52" r="5" fill="#C7D2FE" />
            <circle cx="188" cy="104" r="4" fill="#4F46E5" opacity="0.55" />
            <circle cx="54" cy="100" r="3.4" fill="#4F46E5" opacity="0.45" />
            <path d="M70 122h12M76 116v12" stroke="#A5B4FC" stroke-width="3" stroke-linecap="round" />
            <path d="M168 122h12M174 116v12" stroke="#C7D2FE" stroke-width="3" stroke-linecap="round" />
        </svg>,
        _ => @<svg viewBox="0 0 240 160" role="presentation">
            <rect x="8" y="8" width="224" height="144" rx="24" fill="#EEF2FF" />
            <ellipse cx="120" cy="142" rx="66" ry="7" fill="#4F46E5" opacity="0.10" />
            <rect x="52" y="36" width="136" height="88" rx="12" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="2" />
            <circle cx="64" cy="48" r="3" fill="#C7D2FE" />
            <circle cx="74" cy="48" r="3" fill="#A5B4FC" />
            <circle cx="84" cy="48" r="3" fill="#4F46E5" />
            <rect x="64" y="62" width="56" height="9" rx="4.5" fill="#E2E8F0" />
            <rect x="64" y="76" width="84" height="9" rx="4.5" fill="#C7D2FE" />
            <rect x="64" y="90" width="44" height="9" rx="4.5" fill="#E2E8F0" />
            <circle cx="164" cy="96" r="17" fill="#4F46E5" />
            <path d="M157 96l5 5 10 -11" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>,
    };
}
